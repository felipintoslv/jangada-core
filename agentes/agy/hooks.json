{
  "jangada": {
    "SessionStart": [
      {
        "type": "command",
        "command": "@JANGADA_CORE_PATH@/bin/jangada-hook-agy inicio",
        "timeout": 5
      }
    ],
    "PreInvocation": [
      {
        "type": "command",
        "command": "@JANGADA_CORE_PATH@/bin/jangada-hook-agy trabalhando",
        "timeout": 5
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "@JANGADA_CORE_PATH@/bin/jangada-hook-agy concluido",
        "timeout": 5
      }
    ],
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "@JANGADA_CORE_PATH@/bin/jangada-hook-leitor --agy",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
