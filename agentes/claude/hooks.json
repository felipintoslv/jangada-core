{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "@JANGADA_CORE_PATH@/bin/jangada-hook-claude trabalhando"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "@JANGADA_CORE_PATH@/bin/jangada-hook-claude trabalhando"
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "@JANGADA_CORE_PATH@/bin/jangada-hook-regras gravacao",
            "timeout": 30
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "@JANGADA_CORE_PATH@/bin/jangada-hook-claude aguardando"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "@JANGADA_CORE_PATH@/bin/jangada-hook-claude concluido"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "@JANGADA_CORE_PATH@/bin/jangada-hook-claude inicio"
          }
        ]
      },
      {
        "matcher": "startup|resume|compact",
        "hooks": [
          {
            "type": "command",
            "command": "@JANGADA_CORE_PATH@/bin/jangada-hook-regras coordenacao",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "@JANGADA_CORE_PATH@/bin/jangada-hook-claude fim"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "@JANGADA_CORE_PATH@/bin/jangada-hook-claude subagente-inicio"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "@JANGADA_CORE_PATH@/bin/jangada-hook-claude subagente-fim"
          }
        ]
      }
    ]
  }
}
