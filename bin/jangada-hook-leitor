#!/usr/bin/env bash
# Hook PreToolUse do subagente leitor: só deixa passar comandos de leitura no
# terminal.
#
# Uso:
#   jangada-hook-leitor         Claude, no frontmatter de agentes/claude/agents/leitor.md;
#                               sai com 0 para liberar e com 2 para recusar
#   jangada-hook-leitor --agy   agy, em ~/.gemini/config/hooks.json; responde
#                               {"decision": ...} na saída padrão
# Recebe o JSON do evento pela entrada padrão.
#
# A conferência fica em agentes/claude/hook-leitor.py. Não obedece a
# JANGADA_HOOK_DESLIGADO: o jangada-delegar a liga no agy que roda o leitor.
set -uo pipefail
# Sem realpath: chamado pelo link de bin/, a raiz é a pasta acima do link.
hook="${JANGADA_CORE_PATH:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}/agentes/claude/hook-leitor.py"
if [[ "${1:-}" == --agy ]]; then
  # Uma falha do Python sem resposta não pode liberar o leitor.
  saida="$(python3 "$hook" --agy)" && [[ -n "$saida" ]] ||
    saida='{"decision": "deny", "reason": "jangada-hook-leitor falhou"}'
  printf '%s\n' "$saida"
  exit 0
fi
python3 "$hook" || exit 2
