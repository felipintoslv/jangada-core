#!/usr/bin/env bash
# Consumo do Claude Code no bloco de 5 horas em andamento, lido dos registros
# de conversa em ~/.claude/projects (sem rede, sem ccusage).
#
# Uso: jangada-consumo [--curto] [--json]
#   --curto   uma linha, para a dica da barra
#   --json    o resultado em JSON
#
# O bloco segue a regra do ccusage: começa na hora cheia da primeira mensagem e
# dura 5 horas; uma pausa de 5 horas também abre bloco novo. O resultado fica
# em cache por 60 segundos, porque a barra chama isto a cada poucos segundos.
set -euo pipefail
# shellcheck source=bin/jangada-config
source "$(dirname "${BASH_SOURCE[0]}")/jangada-config"

modo="texto"
case "${1:-}" in
  --curto) modo="curto" ;;
  --json) modo="json" ;;
  -h|--ajuda) sed -n '2,11s/^# \{0,1\}//p' "$0"; exit 0 ;;
  "") ;;
  *) echo "opção desconhecida: $1" >&2; exit 1 ;;
esac

cache_dir="${XDG_CACHE_HOME:-$HOME/.cache}/jangada"
cache="$cache_dir/consumo.json"
mkdir -p "$cache_dir"

if [[ ! -s "$cache" ]] || [[ -n "$(find "$cache" -mmin +1 2>/dev/null)" ]]; then
  tmp="$(mktemp "$cache.XXXXXX")"
  # Só os arquivos mexidos nas últimas 10 horas: o bloco atual começou há no
  # máximo 5, e as 5 anteriores bastam para achar onde ele começa.
  if find "$HOME/.claude/projects" -name '*.jsonl' -mmin -600 -print0 2>/dev/null \
      | python3 -c '
import sys, json, datetime as dt
agora = dt.datetime.now(dt.timezone.utc)
janela = dt.timedelta(hours=5)
vistos, msgs = set(), []
for caminho in sys.stdin.buffer.read().split(b"\0"):
    if not caminho:
        continue
    try:
        f = open(caminho, encoding="utf-8", errors="replace")
    except OSError:
        continue
    with f:
        for linha in f:
            if "\"usage\"" not in linha:
                continue
            try:
                d = json.loads(linha)
            except ValueError:
                continue
            m = d.get("message") or {}
            u = m.get("usage")
            ts = d.get("timestamp")
            if not u or not ts:
                continue
            # A mesma resposta aparece em várias linhas (uma por bloco de
            # conteúdo) e nas conversas retomadas; conta uma vez só.
            chave = (m.get("id"), d.get("requestId"))
            if chave in vistos:
                continue
            vistos.add(chave)
            try:
                t = dt.datetime.fromisoformat(ts.replace("Z", "+00:00"))
                if agora - t > 2 * janela:
                    continue
            except (ValueError, TypeError):
                continue
            msgs.append((t, u))
msgs.sort(key=lambda x: x[0])
inicio = ultimo = None
bloco = []
for t, u in msgs:
    if inicio is None or t - inicio > janela or t - ultimo > janela:
        inicio = t.replace(minute=0, second=0, microsecond=0)
        bloco = []
    bloco.append(u)
    ultimo = t
ativo = inicio is not None and agora - ultimo < janela and agora < inicio + janela
soma = lambda k: sum(u.get(k) or 0 for u in bloco) if ativo else 0
r = {
    "ativo": ativo,
    "inicio": inicio.astimezone().isoformat() if ativo else None,
    "fim": (inicio + janela).astimezone().isoformat() if ativo else None,
    "mensagens": len(bloco) if ativo else 0,
    "entrada": soma("input_tokens"),
    "saida": soma("output_tokens"),
    "cache_criado": soma("cache_creation_input_tokens"),
    "cache_lido": soma("cache_read_input_tokens"),
}
r["total"] = r["entrada"] + r["saida"] + r["cache_criado"] + r["cache_lido"]
json.dump(r, sys.stdout)
' >"$tmp"; then
    mv "$tmp" "$cache"
  else
    rm -f "$tmp"
    echo "não consegui ler os registros do Claude Code" >&2
    exit 1
  fi
fi

# Milhares e milhões abreviados.
curto() {
  awk -v n="$1" 'BEGIN {
    if (n >= 1e6) printf "%.1fM", n / 1e6
    else if (n >= 1e3) printf "%.0fk", n / 1e3
    else printf "%d", n }'
}

ativo="$(jq -r .ativo "$cache")"
case "$modo" in
  json) cat "$cache"; echo ;;
  curto)
    if [[ "$ativo" == true ]]; then
      jq -r '[.total, .saida, .mensagens, (.fim[11:16])] | @tsv' "$cache" \
        | while IFS=$'\t' read -r total saida n fim; do
            printf 'Claude, bloco de 5h: %s tokens (%s de saída, %s respostas), renova às %s\n' \
              "$(curto "$total")" "$(curto "$saida")" "$n" "$fim"
          done
    else
      echo "Claude: nenhum bloco de 5h em andamento"
    fi
    ;;
  texto)
    if [[ "$ativo" != true ]]; then
      echo "nenhum bloco de 5 horas em andamento"
      exit 0
    fi
    jq -r '
      "bloco:        \(.inicio[11:16]) às \(.fim[11:16])",
      "respostas:    \(.mensagens)",
      "entrada:      \(.entrada)",
      "saída:        \(.saida)",
      "cache criado: \(.cache_criado)",
      "cache lido:   \(.cache_lido)",
      "total:        \(.total)"' "$cache"
    ;;
esac
