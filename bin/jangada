#!/usr/bin/env bash
# Atalho para os comandos jangada-*: "jangada agente" executa "jangada-agente".
set -euo pipefail
dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

if (($# == 0)) || [[ "$1" == "-h" || "$1" == "ajuda" ]]; then
  echo "uso: jangada <comando> [argumentos]"
  echo
  echo "comandos disponíveis:"
  for c in "$dir"/jangada-*; do
    nome="$(basename "$c")"
    resumo="$(sed -n '2s/^# //p' "$c")"
    printf '  %-16s %s\n' "${nome#jangada-}" "$resumo"
  done
  exit 0
fi

[[ "$1" != */* ]] || { echo "comando desconhecido: $1" >&2; exit 1; }
# Fora do Core (por exemplo, comandos do Shell), procura pelo PATH.
alvo="$dir/jangada-$1"
[[ -x "$alvo" ]] || alvo="$(command -v -- "jangada-$1" 2>/dev/null)" \
  || { echo "comando desconhecido: $1" >&2; exit 1; }
shift
exec "$alvo" "$@"
