#!/usr/bin/env bash
# Hook do Codex: atualiza somente a sessão existente, sem decidir permissões.
# Recebe o JSON do evento pela entrada padrão. Saída vazia mantém a decisão do Codex.
# Só o PostToolUse escreve na saída: os avisos do jangada-hook-regras, que o
# Codex entrega ao modelo como additionalContext.
exec 3>&1
{
  # Coordenador aberto pelo jangada-coordenador: só estado e última linha no
  # registro dele, sem as regras de gravação das tarefas.
  if [[ -z "${JANGADA_SESSAO:-}" && -n "${JANGADA_COORDENADOR:-}" && -z "${JANGADA_HOOK_DESLIGADO:-}" ]]; then
    evento="${1:-}"
    case "$evento" in inicio|trabalhando|aguardando|concluido|fim) ;; *) exit 0 ;; esac
    entrada="$(cat)"
    jq -e 'type == "object" and ((.agent_id // "") == "")' <<<"$entrada" >/dev/null 2>&1 || exit 0
    linha="$(jq -r '(.last_assistant_message // .tool_input.description // .prompt // "")
      | strings | split("\n") | map(select(test("\\S"))) | (.[0] // "") | .[0:120]' <<<"$entrada")"
    case "$evento" in
      inicio) estado=iniciado; linha="" ;;
      concluido) estado=concluido; linha="${linha:-turno concluído}" ;;
      fim) estado=concluido; linha="Codex encerrado" ;;
      *) estado="$evento" ;;
    esac
    # O provedor é este hook, não o herdado da sessão.
    JANGADA_COORDENADOR_PROVEDOR=codex "$(dirname "${BASH_SOURCE[0]}")/jangada-coordenador" --registrar "$estado" <<<"$linha"
    exit 0
  fi
  [[ -n "${JANGADA_SESSAO:-}" && -z "${JANGADA_HOOK_DESLIGADO:-}" ]] || exit 0
  [[ "$JANGADA_SESSAO" =~ ^[A-Za-z0-9_.-]+$ ]] || exit 0
  evento="${1:-}"
  case "$evento" in inicio|trabalhando|aguardando|concluido|fim) ;; *) exit 0 ;; esac
  # shellcheck source=bin/jangada-config
  source "$(dirname "${BASH_SOURCE[0]}")/jangada-config"
  entrada="$(cat)"
  jq -e 'type == "object"' <<<"$entrada" >/dev/null 2>&1 || exit 0
  if [[ "$evento" == trabalhando && "$(jq -r '.hook_event_name // ""' <<<"$entrada")" == PostToolUse ]]; then
    timeout 25 "$(dirname "${BASH_SOURCE[0]}")/jangada-hook-regras" gravacao <<<"$entrada" >&3
  fi
  # Subagentes usam o id da sessão principal; não mudam o estado dela.
  [[ "$(jq -r '.agent_id // ""' <<<"$entrada")" == "" ]] || exit 0
  arq="$JANGADA_ESTADO/agentes/$JANGADA_SESSAO.json"
  [[ -f "$arq" ]] || exit 0
  conversa="$(jq -r '.session_id // ""' <<<"$entrada")"
  [[ "$conversa" =~ ^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$ ]] || conversa=""
  mensagem="$(jq -r '(.last_assistant_message // .tool_input.description // .prompt // "")
    | strings | split("\n") | map(select(test("\\S"))) | (.[0] // "") | .[0:120]' <<<"$entrada")"
  estado="$evento"
  case "$evento" in
    inicio) estado=iniciado; mensagem="" ;;
    concluido) mensagem="${mensagem:-turno concluído}" ;;
    fim) estado=concluido; mensagem="Codex encerrado" ;;
  esac
  tmp="$(mktemp "$arq.XXXXXX")" || exit 0
  atualizar() {
    local anterior projeto
    anterior="$(jq -r '.estado // ""' "$arq")"
    projeto="$(jq -r '(.raiz // .dir // "") | split("/") | last // ""' "$arq")"
    jq --arg e "$estado" --arg m "$mensagem" --arg a "$(jangada_data_iso)" --arg c "$conversa" '
      .estado = $e | .atualizado = $a | .mensagem = $m
      | if $c != "" then .conversa = $c else . end
    ' "$arq" >"$tmp" && mv "$tmp" "$arq" || return 1
    if [[ "$evento" == inicio || "$evento" == fim || "$estado" != "$anterior" ]]; then
      jangada_registrar_evento "$JANGADA_SESSAO" "$projeto" codex "$evento"
    fi
  }
  if jangada_com_trava_dir "$(dirname "$arq")" atualizar; then
    jangada_avisar_interface estado-sessao
  fi
  rm -f "$tmp"
  if [[ "$estado" == aguardando || "$evento" == concluido ]]; then
    jangada_notificar "Codex $estado: $JANGADA_SESSAO" "$mensagem"
  fi
} >/dev/null 2>&1
exit 0
