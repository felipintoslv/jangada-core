#!/usr/bin/env bash
# Aprova somente os hooks da chamada Jangada, nos dados da sessão isolada.
# Uso interno: jangada-codex-hooks CODEX ARQUIVO_CONFIANCA [ARGUMENTOS_DE_HOOK...]
set -euo pipefail
python3 - "$@" 3<&0 <<'PY'
import json
import os
import pathlib
import select
import signal
import subprocess
import sys
import tempfile
import time
import tomllib

exe, saved_name, *args = sys.argv[1:]
saved = pathlib.Path(saved_name)
expected = {}
for i, arg in enumerate(args):
    if arg == "-c":
        for event, groups in tomllib.loads(args[i + 1])["hooks"].items():
            for group in groups:
                for handler in group["hooks"]:
                    expected[(event.lower(), handler["command"])] = event

proc = subprocess.Popen([exe, *args, "app-server", "--stdio"],
                        stdin=subprocess.PIPE, stdout=subprocess.PIPE,
                        stderr=subprocess.DEVNULL, start_new_session=True)
buffer = b""
def request(ident, method, params):
    global buffer
    proc.stdin.write(json.dumps({"id": ident, "method": method, "params": params}).encode() + b"\n")
    proc.stdin.flush()
    deadline = time.monotonic() + 10
    while time.monotonic() < deadline:
        if b"\n" in buffer:
            line, buffer = buffer.split(b"\n", 1)
            result = json.loads(line)
            if result.get("id") == ident:
                if "error" in result:
                    raise RuntimeError("o Codex recusou a consulta dos hooks")
                return result["result"]
        elif select.select([proc.stdout], [], [], 0.1)[0]:
            chunk = os.read(proc.stdout.fileno(), 65536)
            if not chunk:
                raise RuntimeError("o Codex encerrou a consulta dos hooks")
            buffer += chunk
    raise RuntimeError("o Codex não respondeu à consulta dos hooks em 10 segundos")

try:
    request(1, "initialize", {"clientInfo": {"name": "jangada-hooks", "version": "1"},
                              "capabilities": {"experimentalApi": True}})
    result = request(2, "hooks/list", {"cwds": [os.getcwd()]})
    all_hooks = [h for entry in result["data"] for h in entry["hooks"]]
    hooks = [h for h in all_hooks
             if h.get("source") == "sessionFlags"
             and (h.get("eventName", "").lower(), h.get("command")) in expected]
    if len(hooks) != len(expected) or {(h["eventName"].lower(), h["command"]) for h in hooks} != set(expected):
        raise RuntimeError("o Codex não reconheceu todos os hooks da Jangada")
except (RuntimeError, KeyError, ValueError) as exc:
    print("jangada-codex: " + str(exc), file=sys.stderr)
    sys.exit(1)
finally:
    os.killpg(proc.pid, signal.SIGKILL)
    proc.wait(timeout=5)

states = {h["key"]: {"trusted_hash": h["currentHash"],
                     **({"enabled": False} if not h.get("enabled", True) else {})} for h in hooks}
try:
    previous = json.loads(saved.read_text())
except (OSError, ValueError):
    previous = {}
if previous != states and any(h.get("trustStatus") not in ("trusted", "managed") for h in hooks):
    terminal = os.fdopen(3)
    if not terminal.isatty() or not sys.stderr.isatty():
        print("jangada-codex: abra a sessão num terminal para aprovar os hooks de status", file=sys.stderr)
        sys.exit(1)
    print("Hooks de status da Jangada:", file=sys.stderr)
    for (_, command), event in expected.items():
        print("  " + event + ": " + json.dumps(command, ensure_ascii=False), file=sys.stderr)
    print("Eles atualizam o estado da sessão e enviam notificações dentro do isolamento.", file=sys.stderr)
    print("Autoriza estes hooks? [s/N] ", end="", file=sys.stderr, flush=True)
    if terminal.readline().strip().lower() != "s":
        sys.exit(1)
if previous != states:
    fd, temporary = tempfile.mkstemp(prefix=".jangada-hooks-", dir=saved.parent)
    try:
        with os.fdopen(fd, "w") as f:
            json.dump(states, f)
            f.write("\n")
        os.replace(temporary, saved)
    finally:
        pathlib.Path(temporary).unlink(missing_ok=True)

# A chave dos hooks contém pontos. Passe o mapa como valor TOML, pois o
# parser de -c não interpreta aspas nos segmentos da chave pontuada.
other_states = {}
for h in all_hooks:
    if h["key"] in states or h.get("isManaged"):
        continue
    state = {}
    if h.get("trustStatus") == "trusted":
        state["trusted_hash"] = h["currentHash"]
    if not h.get("enabled", True):
        state["enabled"] = False
    if state:
        other_states[h["key"]] = state
entries = [json.dumps(key) + "={" + ",".join(field + "=" + json.dumps(value)
           for field, value in state.items()) + "}" for key, state in {**other_states, **states}.items()]
print("hooks.state={" + ",".join(entries) + "}")
PY
