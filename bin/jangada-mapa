#!/usr/bin/env bash
# Gera um mapa estrutural compacto do repositório para contexto de agentes.
# Extrai árvore de arquivos e assinaturas de funções/classes em poucas centenas de tokens.
#
# Uso: jangada-mapa [opções] [DIRETÓRIO]
#
# Opções:
#   -m, --max-linhas N   teto de linhas do mapa estrutural (padrão: 350)
#   --com-arvore         inclui a estrutura resumida de diretórios
#   --apenas-arvore      exibe unicamente a árvore de arquivos
#   --repomix            usa o repomix externo caso esteja instalado no PATH
#   -h, --ajuda, --help  mostra esta mensagem
set -euo pipefail

max_linhas=350
com_arvore=1
apenas_arvore=0
usar_repomix=0

while (($#)); do
  case "$1" in
    -m|--max-linhas)
      max_linhas="${2:-}"
      [[ "$max_linhas" =~ ^[1-9][0-9]*$ ]] || { echo "jangada-mapa: -m requer número inteiro positivo" >&2; exit 1; }
      shift 2 ;;
    --com-arvore) com_arvore=1; shift ;;
    --sem-arvore) com_arvore=0; shift ;;
    --apenas-arvore) apenas_arvore=1; shift ;;
    --repomix) usar_repomix=1; shift ;;
    -h|--ajuda|--help) sed -n '2,12s/^# \{0,1\}//p' "$0"; exit 0 ;;
    --) shift; break ;;
    -*) echo "opção desconhecida: $1" >&2; exit 1 ;;
    *) break ;;
  esac
done

alvo="$(realpath "${1:-$PWD}")"
if [[ ! -d "$alvo" ]]; then
  echo "diretório inexistente: $alvo" >&2
  exit 1
fi

if ((usar_repomix)); then
  if command -v repomix >/dev/null 2>&1; then
    exec repomix "$alvo" --compress --stdout
  else
    echo "aviso: repomix não encontrado no PATH; usando extrator nativo do jangada" >&2
  fi
fi

python3 - "$alvo" "$max_linhas" "$com_arvore" "$apenas_arvore" <<'PY'
import sys
import os
import re
import ast
import subprocess

alvo = sys.argv[1]
max_linhas = int(sys.argv[2])
com_arvore = bool(int(sys.argv[3]))
apenas_arvore = bool(int(sys.argv[4]))

linhas_saida = []

def adicionar(linha):
    if len(linhas_saida) < max_linhas:
        linhas_saida.append(linha)

# Obter arquivos respeitando o Git se possível
arquivos = []
eh_git = False
try:
    res = subprocess.run(
        ["git", "-C", alvo, "rev-parse", "--is-inside-work-tree"],
        capture_output=True,
        text=True,
        check=False
    )
    eh_git = (res.returncode == 0 and res.stdout.strip() == "true")
except Exception:
    eh_git = False

if eh_git:
    try:
        res = subprocess.run(
            ["git", "-C", alvo, "ls-files"],
            capture_output=True,
            text=True,
            check=False
        )
        if res.returncode == 0 and res.stdout.strip():
            arquivos = sorted([f for f in res.stdout.splitlines() if f.strip()])
    except Exception:
        arquivos = []

ignorar_dirs = {".git", ".cache", "node_modules", "venv", ".venv", "__pycache__", "tmp"}

if not arquivos:
    for raiz, pastas, files in os.walk(alvo):
        pastas[:] = [p for p in pastas if p not in ignorar_dirs]
        for f in files:
            rel = os.path.relpath(os.path.join(raiz, f), alvo)
            arquivos.append(rel)
    arquivos.sort()

nome_projeto = os.path.basename(alvo)
adicionar(f"# Mapa Estrutural: {nome_projeto}")
adicionar(f"Diretório base: `{alvo}` ({len(arquivos)} arquivos rastreados)")
adicionar("")

if com_arvore or apenas_arvore:
    adicionar("## Estrutura de Arquivos")
    # Agrupa por pasta principal para não estourar linhas
    pastas_vistas = set()
    contagem_arvore = 0
    limite_arvore = min(120, max_linhas // 2) if not apenas_arvore else max_linhas - 10
    
    for arq in arquivos:
        if contagem_arvore >= limite_arvore:
            adicionar(f"- [... e mais {len(arquivos) - contagem_arvore} arquivos ...]")
            break
        partes = arq.split(os.sep)
        if len(partes) > 1 and partes[0] not in pastas_vistas:
            pastas_vistas.add(partes[0])
        adicionar(f"- `{arq}`")
        contagem_arvore += 1
    adicionar("")

if apenas_arvore:
    for l in linhas_saida:
        print(l)
    sys.exit(0)

adicionar("## Assinaturas e Símbolos Principais")

def extrair_python(caminho, rel):
    simbolos = []
    try:
        with open(caminho, "r", encoding="utf-8", errors="replace") as f:
            conteudo = f.read()
        modulo = ast.parse(conteudo)
        for item in modulo.body:
            if isinstance(item, ast.ClassDef):
                simbolos.append(f"  class {item.name}:")
                for sub in item.body:
                    if isinstance(sub, ast.FunctionDef):
                        args = [a.arg for a in sub.args.args]
                        simbolos.append(f"    def {sub.name}({', '.join(args)}):")
            elif isinstance(item, ast.FunctionDef):
                args = [a.arg for a in item.args.args]
                simbolos.append(f"  def {item.name}({', '.join(args)}):")
    except Exception:
        pass
    return simbolos

def extrair_lua(caminho, rel):
    simbolos = []
    padrao = re.compile(r'^\s*(local\s+function|function)\s+([a-zA-Z0-9_:.]+)\s*\(([^)]*)\)')
    try:
        with open(caminho, "r", encoding="utf-8", errors="replace") as f:
            for l in f:
                m = padrao.match(l)
                if m:
                    tipo, nome, params = m.groups()
                    simbolos.append(f"  {tipo} {nome}({params})")
    except Exception:
        pass
    return simbolos

def extrair_shell(caminho, rel):
    simbolos = []
    padrao = re.compile(r'^\s*([a-zA-Z0-9_-]+)\s*\(\)\s*\{')
    try:
        with open(caminho, "r", encoding="utf-8", errors="replace") as f:
            for l in f:
                m = padrao.match(l)
                if m:
                    nome = m.group(1)
                    if not nome.startswith("_"):
                        simbolos.append(f"  {nome}()")
    except Exception:
        pass
    return simbolos

for arq in arquivos:
    if len(linhas_saida) >= max_linhas:
        adicionar("[... limite de linhas atingido; utilize --max-linhas para expandir ...]")
        break
    caminho_completo = os.path.join(alvo, arq)
    if not os.path.isfile(caminho_completo):
        continue
    
    # Ignora arquivos grandes ou binários
    if os.path.getsize(caminho_completo) > 200000:
        continue
    
    simbolos = []
    if arq.endswith(".py"):
        simbolos = extrair_python(caminho_completo, arq)
    elif arq.endswith(".lua"):
        simbolos = extrair_lua(caminho_completo, arq)
    elif arq.endswith(".sh") or arq.startswith("bin/"):
        simbolos = extrair_shell(caminho_completo, arq)
    
    if simbolos:
        adicionar(f"### `{arq}`")
        for s in simbolos[:15]:
            adicionar(s)
        if len(simbolos) > 15:
            adicionar(f"  [... mais {len(simbolos) - 15} funções ...]")

for l in linhas_saida:
    print(l)
PY
