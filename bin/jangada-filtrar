#!/usr/bin/env bash
# Executa um comando e filtra sua saída para economizar tokens em agentes.
# Remove caracteres de controle ANSI e condensa saídas longas de testes e verificadores de código.
#
# Uso: jangada-filtrar [opções] [--] [comando [argumentos...]]
#      comando | jangada-filtrar [opções]
#
# Opções:
#   -m, --max-linhas N   teto de linhas exibidas em caso de sucesso (padrão: 20)
#   -e, --linhas-erro N  teto de linhas exibidas em caso de falha (padrão: 60)
#   -p, --puro           apenas limpa sequências ANSI, sem resumir
#   -h, --ajuda          mostra esta mensagem
set -euo pipefail

max_linhas=20
linhas_erro=60
modo_puro=0

while (($#)); do
  case "$1" in
    -m|--max-linhas)
      max_linhas="${2:-}"
      [[ "$max_linhas" =~ ^(0|[1-9][0-9]*)$ ]] || { echo "jangada-filtrar: -m requer número inteiro" >&2; exit 1; }
      shift 2 ;;
    -e|--linhas-erro)
      linhas_erro="${2:-}"
      [[ "$linhas_erro" =~ ^(0|[1-9][0-9]*)$ ]] || { echo "jangada-filtrar: -e requer número inteiro" >&2; exit 1; }
      shift 2 ;;
    -p|--puro) modo_puro=1; shift ;;
    -h|--ajuda|--help) sed -n '2,11s/^# \{0,1\}//p' "$0"; exit 0 ;;
    --) shift; break ;;
    -*) echo "opção desconhecida: $1" >&2; exit 1 ;;
    *) break ;;
  esac
done

limpar_ansi() {
  sed -E $'s/\x1b\\[[0-9;]*[a-zA-Z]//g; s/\r//g'
}

# Se não há comando especificado, opera como filtro de fluxo da entrada padrão
if (($# == 0)); then
  if ((modo_puro)); then
    limpar_ansi
  else
    tmp_in="$(mktemp "${TMPDIR:-/tmp}/jangada-filtrar-in.XXXXXX")"
    trap 'rm -f "$tmp_in"' EXIT
    limpar_ansi >"$tmp_in"
    total="$(wc -l <"$tmp_in" || echo 0)"
    if ((total <= max_linhas)); then
      cat "$tmp_in"
    else
      echo "[saída condensada: $total linhas totais; o código de saída não é visto aqui; prefira jangada-filtrar -- COMANDO]:"
      tail -n "$max_linhas" "$tmp_in"
    fi
  fi
  exit 0
fi

# Execução do comando com captura
cmd_nome="$1"
tmp_saida="$(mktemp "${TMPDIR:-/tmp}/jangada-filtrar.XXXXXX")"
trap 'rm -f "$tmp_saida"' EXIT

inicio=$SECONDS
rc=0
"$@" >"$tmp_saida" 2>&1 || rc=$?
duracao=$((SECONDS - inicio))

# Limpa caracteres de terminal da saída gravada
tmp_limpo="$(mktemp "${TMPDIR:-/tmp}/jangada-filtrar-limpo.XXXXXX")"
trap 'rm -f "$tmp_saida" "$tmp_limpo"' EXIT
limpar_ansi <"$tmp_saida" >"$tmp_limpo"
rm -f "$tmp_saida"

total_linhas="$(wc -l <"$tmp_limpo" || echo 0)"

if ((modo_puro)); then
  cat "$tmp_limpo"
  exit "$rc"
fi

if ((rc == 0)); then
  if ((total_linhas <= max_linhas)); then
    cat "$tmp_limpo"
  else
    echo "[ok] $cmd_nome concluído com sucesso em ${duracao}s (código 0, $total_linhas linhas condensadas):"
    tail -n "$max_linhas" "$tmp_limpo"
  fi
  exit 0
fi

# Caso de falha (código de retorno diferente de zero)
echo "[falha] $cmd_nome encerrou com código $rc em ${duracao}s ($total_linhas linhas geradas):" >&2

# Procura por linhas relevantes de diagnóstico e falha
padrao_erros='(FAIL|fatal|error|falha|XX |Traceback|AssertionError|SyntaxError|TypeError|ValueError|panicked|line [0-9]+)'
linhas_encontradas="$(grep -Eni "$padrao_erros" "$tmp_limpo" || true)"

if [[ -n "$linhas_encontradas" ]]; then
  echo "--- trechos principais do erro ---" >&2
  # Exibe os apontamentos filtrados respeitando o teto de linhas de erro
  head -n "$linhas_erro" <<<"$linhas_encontradas" >&2
  total_encontradas="$(wc -l <<<"$linhas_encontradas")"
  if ((total_encontradas > linhas_erro)); then
    echo "[... mais $((total_encontradas - linhas_erro)) ocorrências de erro omitidas ...]" >&2
  fi
else
  # Quando não casar com padrões conhecidos, exibe as últimas linhas
  echo "--- últimas $linhas_erro linhas da saída ---" >&2
  tail -n "$linhas_erro" "$tmp_limpo" >&2
fi

exit "$rc"
