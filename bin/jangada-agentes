#!/usr/bin/env bash
# Lista as sessões de agentes, com estado, e permite abrir ou encerrar.
#
# Uso:
#   jangada-agentes            seletor interativo (Enter abre, Ctrl+X encerra)
#   jangada-agentes --janela   abre a central de tarefas
#   jangada-agentes --painel   abre a central de tarefas
#   jangada-agentes --monitor  tabela no terminal atualizada a cada 2 segundos
#   jangada-agentes --waybar   saída JSON para o módulo da barra
#   jangada-agentes --focar S  foca a janela da sessão S ou abre uma nova
#   jangada-agentes --lista-json  consulta pública versionada, com campos de apresentação
#   jangada-agentes --sessao-worktree-json CAMINHO  sessão por worktree exato, sem retenção
#   jangada-agentes --contexto-json S  tarefa e último parecer público, por sessão
#   jangada-agentes --rodadas-json S  rodadas de revisão da execução atual da sessão S
#   jangada-agentes --coordenadores-json  coordenadores do jangada-coordenador e suas tarefas
#   jangada-agentes --observacao-json  caminhos públicos para avisos de mudança
#   jangada-agentes --lista    lista simples: estado, sessão, diretório
#   jangada-agentes --lista-atualizada  o mesmo que --lista; não limpa órfãos
#   jangada-agentes --limpar-orfaos  remove os estados de sessões que já não existem
#   jangada-agentes --previa S conteúdo do painel de prévia da sessão S
#   jangada-agentes --proximo  foca o próximo agente ativo ou que espera (SUPER+N)
#   jangada-agentes --anterior volta ao agente focado antes do atual (SUPER+SHIFT+N)
#   jangada-agentes --restaurar [S]  reabre as sessões interrompidas (ou só S)
#   jangada-agentes --confianca S  repete só a conferência da confiança do agy na tarefa S
#   jangada-agentes --limpar-concluidos  lista as sessões concluídas e, confirmado, encerra todas
#
# Sessões terminadas em "concluido" ou "aguardando" continuam na lista depois de
# o processo sair: são o resultado do ciclo, não um processo vivo. Saem com
# Ctrl+X no seletor, que encerra e remove o worktree, ou sozinhas depois de
# JANGADA_AGENTES_GUARDAR horas (padrão 24).
#
# Sessão de agente cujo tmux morreu sem estado final (reboot, queda da sessão
# gráfica) fica como "interrompido" por 7 dias: Enter no seletor, ou
# --restaurar, reabre o agente na mesma pasta e, no Claude Code, na mesma
# conversa (claude --resume).
set -euo pipefail
# shellcheck source=bin/jangada-config
source "$(dirname "${BASH_SOURCE[0]}")/jangada-config"

estado_dir="$JANGADA_ESTADO/agentes"
case "${1:-}" in
  --lista|--lista-atualizada|--lista-json|--observacao-json|--sessao-worktree-json|--contexto-json|--rodadas-json|--coordenadores-json|--waybar) ;;
  *) mkdir -p "$estado_dir" ;;
esac

# Horas que um estado final continua visível depois de o processo sair.
guardar_horas="${JANGADA_AGENTES_GUARDAR:-24}"
# O mesmo, para sessão interrompida: dá tempo de voltar de um fim de semana.
guardar_interrompido_horas=168

# Separador interno dos campos. A tabulação não serve para o read: ela conta
# como espaço em branco no IFS, então duas seguidas viram uma e um campo vazio
# desloca os seguintes (com "dir" vazio, a data caía em "dir" e a sessão
# sumia como vencida). A saída de listar continua em TSV, para awk e fzf.
US=$'\x1f'

# TSV de listar convertido para o separador interno, para ler com IFS="$US".
campos() { tr '\t' "$US" <<<"$1"; }

sessoes_vivas() { "${JANGADA_TMUX[@]}" list-sessions -F '#S' 2>/dev/null || true; }

# Estado de ciclo encerrado. Um processo sem sessão no tmux que grava o
# resultado e sai (como fazia o antigo jangada-par) teria o "concluido"
# recolhido antes de alguém ver, sem esta distinção.
estado_final() {
  case "$1" in
    concluido|aguardando) return 0 ;;
    *) return 1 ;;
  esac
}

# Um estado final velho demais para continuar ocupando o painel. Sem data, ou
# com data ilegível, conta como vencido: é resto de versão antiga do arquivo.
vencido() {
  local quando="$1" horas="${2:-$guardar_horas}" marca="" agora
  [[ -n "$quando" ]] || return 0
  if command -v gdate >/dev/null 2>&1; then
    marca="$(gdate -d "$quando" +%s 2>/dev/null || true)"
  elif date -d "$quando" +%s >/dev/null 2>&1; then
    marca="$(date -d "$quando" +%s 2>/dev/null || true)"
  elif command -v python3 >/dev/null 2>&1; then
    marca="$(python3 -c "import sys, datetime; print(int(datetime.datetime.fromisoformat(sys.argv[1]).timestamp()))" "$quando" 2>/dev/null || true)"
  fi
  [[ -n "$marca" ]] || return 0
  agora="$(date +%s)"
  (( agora - marca > horas * 3600 ))
}

# Estado guardado de uma sessão sem processo: final (resultado do ciclo) ou
# interrompido (dá para restaurar), cada um com o seu prazo.
guardado() {
  local estado="$1" atualizado="$2"
  if estado_final "$estado"; then
    ! vencido "$atualizado"
  elif [[ "$estado" == interrompido ]]; then
    ! vencido "$atualizado" "$guardar_interrompido_horas"
  else
    return 1
  fi
}

# Arquivo de estado de sessão. Restos do antigo jangada-par (o JSON bruto do
# agy, revisao-<sessão>-rN.json) e o contexto de cada rodada do jangada-validar
# (validacao-<sessão>-rN.contexto.json) ficam na mesma pasta; tratados como
# sessão, apareceriam na lista e a barra os apagaria como órfãos.
eh_estado() {
  local nome
  nome="$(basename "$1")"
  [[ -e "$1" && "$nome" != revisao-* && ! "$nome" =~ ^validacao-.+-r[0-9]+\.contexto\.json$ ]]
}

# Uma linha por sessão: estado<TAB>sessão<TAB>diretório<TAB>atualizado<TAB>ramo<TAB>tarefa
listar() {
  sessoes_vivas | python3 "$JANGADA_CORE_PY/nucleo/sessoes.py" "$estado_dir" "$guardar_horas" "$guardar_interrompido_horas" "${1:-tsv}"
}

# Remove arquivos de estado de sessões que já não existem. Um ciclo que terminou
# em "concluido" ou "aguardando" não é órfão: é resultado, e fica até alguém
# encerrar a sessão no seletor ou até vencer o prazo.
limpar_orfaos() {
  local arq s vivas pid estado atualizado
  vivas="$(sessoes_vivas)"
  for arq in "$estado_dir"/*.json; do
    eh_estado "$arq" || continue
    s="$(basename "$arq" .json)"
    if grep -qxF "$s" <<<"$vivas"; then
      continue
    fi
    pid="$(jq -r '.pid // empty' "$arq" 2>/dev/null || true)"
    if [[ -n "$pid" ]] && kill -0 "$pid" 2>/dev/null; then
      continue
    fi
    estado="$(jq -r '.estado // ""' "$arq" 2>/dev/null || true)"
    atualizado="$(jq -r '.atualizado // ""' "$arq" 2>/dev/null || true)"
    if guardado "$estado" "$atualizado"; then
      continue
    fi
    # Sessão de agente (sem pid; o do par tem) que estava em andamento quando o
    # tmux morreu: vira interrompida em vez de sumir, para o --restaurar.
    if [[ -z "$pid" ]] && [[ "$estado" != interrompido ]] && restauravel "$arq"; then
      marcar "$arq" interrompido "tmux encerrado com o agente em $estado"
      continue
    fi
    rm -f "$arq"
  done
}

# Sessão que dá para reabrir: agente de terminal (o par não tem sessão no
# tmux) com a pasta ainda no disco.
restauravel() {
  local arq="$1" agente dir
  agente="$(jq -r '.agente // ""' "$arq" 2>/dev/null || true)"
  dir="$(jq -r '.dir // ""' "$arq" 2>/dev/null || true)"
  [[ -n "$agente" && "$agente" != par && -n "$dir" && -d "$dir" ]]
}

# A trava é a mesma do jangada-hook-claude: leitura, alteração e troca do
# arquivo acontecem sem outro processo no meio, senão um sobrescreve o campo
# que o outro acabou de gravar.
marcar() {
  local arq="$1" tmp
  local agora
  agora="$(jangada_data_iso)"
  tmp="$(mktemp "$arq.XXXXXX" 2>/dev/null)" || return 0
  jangada_alterar_estado "$arq" "$tmp" --arg e "$2" --arg m "$3" --arg a "$agora" \
    '.estado = $e | .mensagem = $m | .atualizado = $a' || rm -f "$tmp"
}

# Pasta em que uma sessão restaurada pode abrir. O caminho vem do estado, que o
# agente isolado consegue gravar, e a pasta do agente fica gravável no
# isolamento: sem esta conferência, ele se mudaria para a instalação do
# jangada ou para a configuração do usuário. Vale um worktree do jangada, uma
# pasta dentro de JANGADA_PROJETOS ou a raiz de outro repositório git fora das
# pastas de configuração e de estado. Imprime o caminho resolvido.
pasta_restauravel() {
  local d="$1" real raiz p
  [[ -n "$d" && "$d" == /* && "$d" != *[[:cntrl:]]* ]] || return 1
  real="$(realpath -e -- "$d" 2>/dev/null)" || return 1
  [[ -d "$real" && "$real" != *[[:cntrl:]]* ]] || return 1
  for p in "$JANGADA_WORKTREES" "$JANGADA_PROJETOS"; do
    [[ -n "$p" ]] || continue
    p="$(realpath -m -- "$p")" || continue
    [[ -n "$p" && "$p" != / ]] || continue
    [[ "$real" == "$p"/* ]] && { printf '%s\n' "$real"; return 0; }
  done
  [[ "$real" != / && "$real" != "$HOME" ]] || return 1
  for p in "$JANGADA_CORE_PATH" "$JANGADA_CONFIG" "$JANGADA_ESTADO" "$HOME/.config" "$HOME/.local" \
           "$HOME/.cache" "$HOME/.ssh" "$HOME/.gnupg" "$HOME/.claude" "$HOME/.gemini" "$HOME/.codex"; do
    p="$(realpath -m -- "$p")"
    [[ "$real" == "$p" || "$real" == "$p"/* ]] && return 1
  done
  raiz="$(jangada_git_seguro -C "$real" rev-parse --show-toplevel 2>/dev/null)" || return 1
  [[ "$(realpath -m -- "$raiz")" == "$real" ]] || return 1
  printf '%s\n' "$real"
}

# Protocolo do Claude refeito das fontes do repositório para a sessão
# restaurada, como o jangada-agente monta: o arquivo guardado fica na pasta de
# estado, gravável pelo agente, e o shell da sessão o lê fora do isolamento.
# O mv troca um link simbólico plantado ali em vez de segui-lo. Imprime o
# caminho, ou nada quando o protocolo está desligado.
refazer_protocolo() {
  local s="$1" dir="$2" delegar="$3" revisor="$4" base tmp
  [[ "${5:-}" == codex ]] && delegar=codex
  base="$JANGADA_CORE_PATH/agentes/perfis/protocolo.md"
  [[ "${JANGADA_AGENTE_PROTOCOLO:-1}" != 0 && -r "$base" ]] || return 0
  if ! command -v "$revisor" >/dev/null 2>&1; then
    echo "revisão indisponível: $revisor não instalado; protocolo e testes continuam obrigatórios" >&2
  fi
  local -a partes=("$base" "$JANGADA_CORE_PATH/agentes/perfis/protocolo-delegar-$delegar.md"
                   "$JANGADA_CORE_PATH/agentes/perfis/protocolo-delegar.md")
  if [[ -n "$(find "$dir" -maxdepth 2 -not -path '*/.git/*' \
        \( -iname '*.R' -o -name '*.Rmd' -o -name '*.qmd' -o -name '*.Rproj' -o -name DESCRIPTION \) \
        -print -quit 2>/dev/null)" ]]; then
    partes+=("$JANGADA_CORE_PATH/agentes/perfis/protocolo-r.md")
  fi
  tmp="$(mktemp "$estado_dir/.protocolo-$s.XXXXXX")" || return 1
  cat "${partes[@]}" >"$tmp" 2>/dev/null || { rm -f "$tmp"; return 1; }
  if ! command -v "$revisor" >/dev/null 2>&1; then
    printf '\nRevisão indisponível: %s não instalado. Execute os testes obrigatórios e o jangada-validar. Informe a revisão pendente; não declare aprovação.\n' \
      "$revisor" >>"$tmp"
  fi
  mv -fT "$tmp" "$estado_dir/protocolo-$s.md" || { rm -f "$tmp"; return 1; }
  printf '%s\n' "$estado_dir/protocolo-$s.md"
}

# Confere a confiança do agy na tarefa S e sincroniza a do worktree. A raiz,
# o worktree e os provedores vêm da cópia protegida da sessão, que o
# isolamento oculta; os caminhos ainda passam pela conferência do Git, e o
# estado gravável pelo agente não é lido. Tarefa que não delega nem revisa
# pelo agy fica como está. Não recria a tarefa nem roda a preparação.
confianca() {
  local s="$1" perguntar="$2" registro=0
  if [[ ! "$s" =~ ^[A-Za-z0-9_.-]+$ ]]; then
    echo "nome de sessão inválido: $s" >&2
    return 1
  fi
  if [[ -n "${JANGADA_ISOLADO:-}" ]]; then
    echo "a confiança do agy só é conferida fora da sessão isolada" >&2
    return 1
  fi
  jangada_agy_registro_tarefa "$s" || registro=$?
  if ((registro == 1)); then
    echo "$s: sem registro protegido válido; confiança do agy não conferida" >&2
    return 1
  elif ((registro == 2)); then
    echo "$s: o worktree do registro protegido não existe; confiança do agy não conferida" >&2
    return 1
  fi
  if ! jangada_agy_tarefa_usa "$s"; then
    echo "$s: a tarefa não delega nem revisa pelo agy; nada a conferir" >&2
    return 0
  fi
  jangada_agy_conferir_tarefa "$JANGADA_AGY_REG_RAIZ" "$JANGADA_AGY_REG_WORKTREE" "$perguntar" "$s"
}

# Reabre a sessão S no tmux: na mesma pasta, com o mesmo agente e na mesma
# conversa. Sem o id (instalação sem o hook novo) usa --continue, que retoma a
# conversa mais recente daquela pasta.
#
# O estado fica ao alcance do agente isolado, e o comando digitado aqui roda
# num shell fora do isolamento. Por isso nada do que é executado sai do JSON
# como texto: o agente só pode ser claude, agy ou codex, o id da conversa é um uuid,
# a pasta passa pela pasta_restauravel, e os argumentos, o perfil e o
# isolamento vêm da configuração do usuário. O .comando e o .isolar do estado
# são ignorados; o isolamento permanece obrigatório mesmo com a opção antiga
# JANGADA_AGENTE_ISOLAR=0. Estado que não passa na conferência é recusado.
restaurar() {
  local s="$1" arq agente base dir conversa perfil worktree rev cmd exe args delegar
  if [[ ! "$s" =~ ^[A-Za-z0-9_.-]+$ ]]; then
    echo "nome de sessão inválido: $s" >&2
    return 1
  fi
  arq="$estado_dir/$s.json"
  if "${JANGADA_TMUX[@]}" has-session -t "=$s" 2>/dev/null; then
    return 0
  fi
  [[ -f "$arq" ]] || { echo "sem estado para $s" >&2; return 1; }
  restauravel "$arq" || { echo "$s não pode ser restaurada (ciclo em par, ou pasta ausente)" >&2; return 1; }
  recusa() { echo "$s: $1; nada foi executado" >&2; }
  agente="$(jq -r '.agente // "" | tostring' "$arq" 2>/dev/null)" || { recusa "estado ilegível"; return 1; }
  dir="$(jq -r '.dir // "" | tostring' "$arq")"
  conversa="$(jq -r '.conversa // "" | tostring' "$arq")"
  perfil="$(jq -r '.perfil // "" | tostring' "$arq")"
  worktree="$(jq -r '.worktree // "" | tostring' "$arq")"
  rev="$(jq -r '.revisor // "" | tostring' "$arq")"

  # O agente vem do perfil ou da configuração; do estado sai só o nome, que
  # tem de ser um dos conhecidos.
  base="$(basename -- "${agente%% *}" 2>/dev/null || true)"
  [[ "$base" =~ ^(claude|agy|codex)$ ]] || { recusa "agente inválido no estado"; return 1; }
  PERFIL_AMBIENTE=()
  if [[ -n "$perfil" ]]; then
    jangada_perfil "$perfil" || { recusa "perfil $perfil não existe mais na configuração"; return 1; }
    [[ "$(basename -- "${PERFIL_COMANDO%% *}")" == "$base" ]] \
      || { recusa "o agente do estado ($base) difere do perfil $perfil"; return 1; }
    exe="$PERFIL_COMANDO"; args="$PERFIL_ARGS"
  else
    # O JANGADA_AGENTE da configuração vale quando é o mesmo agente; aberto
    # com --agente, fica o nome simples, procurado no PATH.
    exe="$base"
    [[ "$agente" == "$JANGADA_AGENTE" ]] && exe="$JANGADA_AGENTE"
    args="$JANGADA_AGENTE_ARGS"
  fi
  local modelos_tarefa='{}' copia="$JANGADA_ESTADO/revisoes/$s.json"
  if [[ -f "$copia" && ! -L "$copia" ]] && jq -e 'has("modelos_tarefa")' "$copia" >/dev/null; then
    rev="$(jq -r '.revisor' "$copia")"
    modelos_tarefa="$(jq -c '.modelos_tarefa' "$copia" | python3 "$JANGADA_CORE_PATH/delegacao/modelos.py" conferir "$base" "$rev")" \
      || { recusa "seleção protegida de modelos inválida"; return 1; }
    if [[ -n "$args" ]]; then recusa "argumentos do perfil conflitam com seleção protegida"; return 1; fi
    args="$(jangada_modelo_argumentos "$modelos_tarefa" "$base")"
  elif jq -e 'has("modelos_tarefa")' "$arq" >/dev/null; then
    recusa "seleção por tarefa sem registro protegido; não usar estado gravável"
    return 1
  fi
  if [[ -n "$conversa" && ! "$conversa" =~ ^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$ ]]; then
    recusa "id de conversa inválido no estado"
    return 1
  fi
  dir="$(pasta_restauravel "$dir")" \
    || { recusa "pasta fora de JANGADA_WORKTREES e de JANGADA_PROJETOS, ou que não é repositório git"; return 1; }
  if [[ -n "$rev" && ! "$rev" =~ ^(claude|agy|codex)$ ]]; then
    recusa "revisor inválido no estado"
    return 1
  fi

  # Destino dos subagentes: do perfil, depois o global, como no jangada-agente.
  local v
  delegar="${JANGADA_DELEGAR:-}"
  for v in "${PERFIL_AMBIENTE[@]}"; do
    [[ "$v" =~ ^JANGADA_DELEGAR=(.*)$ ]] && delegar="${BASH_REMATCH[1]}"
  done
  delegar="$(jangada_delegacao "$base" "$delegar")"

  # Sem perguntar: a retomada pode vir da Central, sem terminal de quem
  # responda. Quem diz se a tarefa usa o agy é o registro protegido dela;
  # sem registro válido a sessão volta, com o aviso e sem a conferência.
  if [[ -z "${JANGADA_ISOLADO:-}" ]]; then
    if ! jangada_agy_registro_tarefa "$s" || jangada_agy_tarefa_usa "$s"; then
      confianca "$s" 0 || true
    fi
  fi

  # A conta do agy é a do registro protegido, a mesma da abertura, e não a que
  # o ambiente ou o saldo de hoje escolheriam. Sem o campo, segue como antes.
  local isolar_bin conta_reg=""
  isolar_bin="$(printf '%q' "$JANGADA_CORE_PATH/bin/jangada-isolar")"
  if jangada_agy_registro_tarefa "$s"; then
    conta_reg="$(jq -r '.conta_agy // ""' "$JANGADA_ESTADO/revisoes/$s.json")"
  fi
  if [[ -n "$conta_reg" ]]; then
    jangada_conta_agy "$conta_reg" >/dev/null 2>&1 \
      || { recusa "a conta do agy do registro ($conta_reg) não está mais no catálogo"; return 1; }
    isolar_bin+=" --conta $(printf '%q' "$conta_reg")"
  fi
  isolar_bin+=" --delegar $(printf '%q' "${delegar:-agy}")"

  cmd="$exe"
  [[ -n "$args" ]] && cmd+=" $args"
  cmd="$isolar_bin -- $cmd"
  if [[ "$base" == claude ]]; then
    local protocolo=""
    protocolo="$(refazer_protocolo "$s" "$dir" "$delegar" "${rev:-agy}")" || protocolo=""
    [[ -n "$protocolo" ]] && cmd+=" --append-system-prompt \"\$(cat $(printf '%q' "$protocolo"))\""
    # O --continue retoma a conversa mais recente da pasta. Num worktree ela é
    # desta sessão; direto no repositório pode ser de outro agente ou de uma
    # conversa aberta à mão, e aí é melhor começar uma nova.
    if [[ -n "$conversa" ]]; then
      cmd+=" --resume $(printf '%q' "$conversa")"
    elif [[ -n "$worktree" ]]; then
      cmd+=" --continue"
    else
      echo "$s: sem o id da conversa e sem worktree próprio; abrindo conversa nova" >&2
    fi
  elif [[ "$base" == codex ]]; then
    local protocolo_codex=""
    protocolo_codex="$(refazer_protocolo "$s" "$dir" "$delegar" "${rev:-claude}" codex)" || protocolo_codex=""
    cmd="$(printf '%q' "$JANGADA_CORE_PATH/bin/jangada-codex")"
    [[ -n "$protocolo_codex" ]] && cmd+=" --protocolo $(printf '%q' "$protocolo_codex")"
    if [[ -n "$conversa" ]]; then
      cmd+=" --conversa $(printf '%q' "$conversa")"
    elif [[ -n "$worktree" ]]; then
      cmd+=" --retomar"
    else
      echo "$s: sem o id da conversa e sem worktree próprio; abrindo conversa nova" >&2
    fi
    cmd+=" -- $exe${args:+ $args}"
    cmd="$isolar_bin -- $cmd"
  else
    # O id vem do hook do agy (conversationId). Sem ele, o --continue retoma a
    # conversa mais recente do agy, que pode ser de outra pasta: só no worktree.
    if [[ -n "$conversa" ]]; then
      cmd+=" --conversation $(printf '%q' "$conversa")"
    elif [[ -n "$worktree" ]]; then
      cmd+=" --continue"
    else
      echo "$s: sem o id da conversa e sem worktree próprio; abrindo conversa nova" >&2
    fi
  fi
  # O ambiente do perfil é relido do arquivo, e não guardado no estado: pode
  # trazer chave de API. O JANGADA_AGENTE_ISOLAR do perfil fica de fora: o
  # nome do perfil vem do estado, e o agente que o trocasse por um perfil sem
  # isolamento sairia do bwrap.
  local -a amb=(-e "JANGADA_SESSAO=$s")
  for v in "${PERFIL_AMBIENTE[@]}"; do
    [[ "$v" =~ ^JANGADA_(VALIDAR_REVISOR|DELEGAR|AGENTE_ISOLAR)= ]] && continue
    amb+=(-e "$v")
  done
  amb+=(-e "JANGADA_DELEGAR=$delegar")
  [[ -n "$rev" ]] && amb+=(-e "JANGADA_VALIDAR_REVISOR=$rev")
  if [[ "$modelos_tarefa" != '{}' ]]; then
    amb+=(-e "JANGADA_VALIDAR_MODELO=$(jq -r '.revisor.modelo' <<<"$modelos_tarefa")"
          -e "JANGADA_VALIDAR_ESFORCO=$(jq -r '.revisor.esforco' <<<"$modelos_tarefa")")
  fi
  "${JANGADA_TMUX[@]}" new-session -d -s "$s" -c "$dir" "${amb[@]}"
  marcar "$arq" iniciado "restaurada"
  python3 "$JANGADA_CORE_PATH/orquestracao/confianca.py" registrar-inicio "$JANGADA_ESTADO" "$s" \
    || { echo "retomada bloqueada: falha ao preservar contexto; trabalho mantido" >&2; return 1; }
  "${JANGADA_TMUX[@]}" send-keys -t "=$s:" "$cmd" Enter
  echo "restaurada: $s"
}

# Histórico de foco, para o --anterior: uma sessão por linha, a mais recente
# no fim, sem repetição seguida.
historico="$estado_dir/foco.historico"
registrar_foco() {
  local ultimo=""
  [[ -f "$historico" ]] && ultimo="$(tail -n1 "$historico")"
  [[ "$ultimo" == "$1" ]] && return 0
  { [[ -f "$historico" ]] && tail -n 19 "$historico"; printf '%s\n' "$1"; } >"$historico.tmp" \
    && mv "$historico.tmp" "$historico"
}

anterior() {
  local atual s
  [[ -f "$historico" ]] || { echo "nenhum agente focado ainda"; return 0; }
  atual="$(jangada_janela_ativa)"
  # Da mais recente para a mais antiga: a primeira que ainda existe e não é a
  # janela em foco. Assim, repetir o atalho alterna entre os dois últimos.
  while read -r s; do
    [[ -n "$s" && "$s" != "$atual" ]] || continue
    "${JANGADA_TMUX[@]}" has-session -t "=$s" 2>/dev/null || continue
    focar "$s"
    return 0
  done < <(command -v tac >/dev/null 2>&1 && tac "$historico" || tail -r "$historico" 2>/dev/null || awk '{l[NR]=$0} END {for (i=NR;i>0;i--) print l[i]}' "$historico")
  jangada_notificar "Agentes" "nenhum agente anterior" || echo "nenhum agente anterior"
}

focar() {
  local s="$1" rc=0
  if [[ -f "$estado_dir/$s.json" ]] && ! "${JANGADA_TMUX[@]}" has-session -t "=$s" 2>/dev/null \
     && restauravel "$estado_dir/$s.json"; then
    restaurar "$s" >/dev/null || true
  fi
  if "${JANGADA_TMUX[@]}" has-session -t "=$s" 2>/dev/null; then
    registrar_foco "$s"
    # Com horário, para o painel; o foco.historico só guarda a ordem.
    jangada_registrar_evento "$s" \
      "$(jq -r '(.raiz // .dir // "") | split("/") | last // ""' "$estado_dir/$s.json" 2>/dev/null || true)" \
      "$(jq -r '.agente // ""' "$estado_dir/$s.json" 2>/dev/null || true)" foco
  fi
  jangada_focar_janela "$s" || rc=$?
  ((rc == 1)) || return "$rc"
  if "${JANGADA_TMUX[@]}" has-session -t "=$s" 2>/dev/null; then
    jangada_abrir_terminal --solto org.jangada.agente "${JANGADA_TMUX[@]}" attach -t "=$s"
  fi
}

# Próximo agente que pede atenção. Ordem: quem espera resposta, do mais antigo
# para o mais novo, e depois quem terminou, do mais recente para o mais velho.
# Sem estado guardado entre chamadas: se a janela em foco já é uma das
# candidatas, vai para a seguinte, então apertar de novo percorre a fila.
proximo() {
  local linhas atual i n alvo=""
  local -a fila=()
  limpar_orfaos
  linhas="$(listar)"
  # "atualizado" vem de date -Is, que ordena como texto.
  mapfile -t fila < <(
    awk -F'\t' '$1=="aguardando" {print $4 "\t" $2}' <<<"$linhas" | sort | cut -f2
    awk -F'\t' '$1=="concluido" {print $4 "\t" $2}' <<<"$linhas" | sort -r | cut -f2
  )
  # Alternativa: se não houver agente aguardando ou concluído, percorre
  # quem está trabalhando, ordenado pelo nome da sessão para não saltar caoticamente.
  if [[ "${#fila[@]}" -eq 0 ]] || [[ -z "${fila[0]}" ]]; then
    mapfile -t fila < <(
      awk -F'\t' '$1=="trabalhando" {print $2}' <<<"$linhas" | sort
    )
  fi
  n="${#fila[@]}"
  if ((n == 0)) || [[ -z "${fila[0]}" ]]; then
    jangada_notificar "Agentes" "nenhum agente ativo" || echo "nenhum agente ativo"
    return 0
  fi

  atual="$(jangada_janela_ativa)"
  alvo="${fila[0]}"
  for ((i = 0; i < n; i++)); do
    if [[ "${fila[i]}" == "$atual" ]]; then
      alvo="${fila[(i + 1) % n]}"
      break
    fi
  done

  # Ciclo em par, ou agente cujo processo saiu: não há terminal para focar.
  # O seletor mostra o resultado na prévia e oferece o Ctrl+X.
  if "${JANGADA_TMUX[@]}" has-session -t "=$alvo" 2>/dev/null; then
    focar "$alvo"
  else
    "$0" --janela
  fi
}

# Conteúdo do painel de prévia do seletor. Existe como ação própria porque o
# fzf roda a prévia com o $SHELL do usuário: no zsh, uma palavra começando com
# "=" (como o "-t =sessao:" do tmux) dispara a expansão de igual e o comando
# morre antes de rodar, com "zsh:1: <nome da sessao>".
previa() {
  local s="$1" arq estado msg
  arq="$estado_dir/$s.json"

  # Sessão viva: o que está na tela do agente.
  if "${JANGADA_TMUX[@]}" has-session -t "=$s" 2>/dev/null; then
    "${JANGADA_TMUX[@]}" capture-pane -p -t "=$s:" 2>/dev/null | tail -40
    return 0
  fi

  if [[ ! -f "$arq" ]]; then
    echo "sem informação sobre $s"
    return 0
  fi

  estado="$(jq -r '.estado // "?"' "$arq" 2>/dev/null || echo "?")"
  msg="$(jq -r '.mensagem // ""' "$arq" 2>/dev/null || true)"
  echo "estado:   $estado"
  [[ -n "$msg" ]] && echo "mensagem: $msg"
  # Só a primeira linha da tarefa: o prompt de um ciclo em par tem dezenas de
  # linhas e encheria o painel inteiro.
  jq -r '
    (if .ramo     then "ramo:     " + .ramo     else empty end),
    (if .worktree then "worktree: " + .worktree else empty end),
    (if .tarefa   then "tarefa:   " + ((.tarefa | split("\n") | .[0])[0:120]) else empty end)
  ' "$arq" 2>/dev/null || true
  local dica_x="encerra a sessão"
  [[ -n "$(jq -r '.worktree // ""' "$arq" 2>/dev/null || true)" ]] && dica_x="remove o worktree e mantém o ramo"
  if restauravel "$arq"; then
    echo "(sem processo; Enter restaura, Alt+I integra, Ctrl+X $dica_x)"
  else
    echo "(sessão encerrada; Alt+I integra, Ctrl+X $dica_x)"
  fi

  # Último parecer feito fora do isolamento (revisoes/, oculta para o agente),
  # com a marca de aprovação conferida contra o commit atual do ramo.
  local revisoes="$JANGADA_ESTADO/revisoes" validacao fora ramo_s raiz_s cabeca base_s v="" t="" b="" c="" l="" i=""
  fora="$(mais_recente "$revisoes/validacao-$s-r")"
  if [[ -n "$fora" ]]; then
    echo ""
    echo "--- $(basename "$fora") (fora do isolamento) ---"
    # Ramo e raiz da cópia que o jangada-agente gravou em revisoes/, e não do
    # estado, que o agente grava.
    ramo_s="$(jq -r '.ramo // "" | tostring' "$revisoes/$s.json" 2>/dev/null || true)"
    raiz_s="$(jq -r '.raiz // "" | tostring' "$revisoes/$s.json" 2>/dev/null || true)"
    base_s="$(jq -r '.base // "" | tostring' "$revisoes/$s.json" 2>/dev/null || true)"
    cabeca=""
    [[ "$ramo_s" =~ ^agente/[a-z0-9_][a-z0-9_-]*$ && "$raiz_s" == /* && -d "$raiz_s" ]] \
      && cabeca="$(jangada_git_seguro -C "$raiz_s" rev-parse --verify --quiet "$ramo_s^{commit}" 2>/dev/null || true)"
    [[ -f "$revisoes/validacao-$s.aprovado" ]] \
      && IFS=$'\t' read -r c l i v t b < <(jq -r 'objects | [.candidate_sha, .limpo, .independent, .local_verified, .candidate_tree, .base_sha] | map(tostring) | @tsv' \
        "$revisoes/validacao-$s.aprovado" 2>/dev/null)
    if [[ -n "$c" && "$c" == "$cabeca" ]] && { [[ "$v" != true ]] \
       || [[ "$t" != "$(jangada_git_seguro -C "$raiz_s" rev-parse --verify --quiet "$cabeca^{tree}" 2>/dev/null || true)" ]] \
       || [[ -z "$base_s" || "$b" != "$(jangada_git_seguro -C "$raiz_s" rev-parse --verify --quiet "$base_s^{commit}" 2>/dev/null || true)" ]]; }; then
      echo "(aprovação incompleta ou inválida para a árvore e a base atuais)"
    elif [[ -n "$c" && "$c" == "$cabeca" && "$l" == true && "$i" != true ]]; then
      echo "(autorrevisão do commit atual do ramo, ${c:0:12}: não vale como revisão independente)"
    elif [[ -n "$c" && "$c" == "$cabeca" && "$l" == true ]]; then
      echo "(aprovação vale para o commit atual do ramo, ${c:0:12}; o --integrar a aceita se a base não andou)"
    elif [[ -n "$c" ]]; then
      echo "(a última aprovação, ${c:0:12}, não é do commit atual do ramo)"
    fi
    head -60 "$fora"
  fi

  # Último parecer pedido pelo agente com jangada-validar dentro do isolamento.
  validacao="$(mais_recente "$estado_dir/validacao-$s-r")"
  if [[ -n "$validacao" ]]; then
    echo ""
    echo "--- $(basename "$validacao") ---"
    # O jangada-validar roda no processo do agente, e o parecer fica numa pasta
    # que ele pode gravar: é o que a sessão registrou, não prova de revisão.
    echo "(gravado pela própria sessão; o --integrar só aceita o parecer gravado fora do isolamento)"
    head -60 "$validacao"
  fi
}

previa_integracao() {
  local s="$1" meta="$JANGADA_ESTADO/revisoes/$1.json"
  [[ "$s" =~ ^[A-Za-z0-9_.-]+$ && "$s" != . && "$s" != .. ]] || return 1
  local raiz ramo base candidato base_sha resumo="" marca="{}" parecer="" local_estado="não informado" marca_atual=false
  raiz="$(jq -er '.raiz' "$meta")" && ramo="$(jq -er '.ramo' "$meta")" \
    && base="$(jq -er '.base' "$meta")" || return 1
  [[ "$raiz" == /* && "$ramo" =~ ^agente/[a-z0-9_][a-z0-9_-]*$ ]] || return 1
  jangada_git_seguro check-ref-format --branch "$base" >/dev/null || return 1
  candidato="$(jangada_git_seguro -C "$raiz" rev-parse --verify "$ramo^{commit}")" \
    && base_sha="$(jangada_git_seguro -C "$raiz" rev-parse --verify "$base^{commit}")" || return 1
  resumo="$(jangada_git_seguro -c core.quotePath=false -C "$raiz" diff --no-renames --numstat "$base_sha" "$candidato" \
    | while IFS=$'\t' read -r adicoes remocoes caminho; do
        if [[ "$adicoes" == - ]]; then
          printf '[binário] %s\n' "$caminho"
        else
          printf '+%s -%s %s\n' "$adicoes" "$remocoes" "$caminho"
        fi
      done)" || return 1
  [[ ! -f "$JANGADA_ESTADO/revisoes/validacao-$s.aprovado" ]] \
    || marca="$(jq -c 'objects' "$JANGADA_ESTADO/revisoes/validacao-$s.aprovado")" || return 1
  parecer="$(mais_recente "$JANGADA_ESTADO/revisoes/validacao-$s-r")"
  [[ -z "$parecer" ]] || parecer="$(head -c 12000 "$parecer")"
  if jq -e --arg b "$base_sha" --arg c "$candidato" \
      '.base_sha == $b and .candidate_sha == $c and .limpo == true' <<<"$marca" >/dev/null; then
    marca_atual=true
    local_estado="$(jq -r 'if .local_verified == true then "passou na foto da entrega"
      elif .local_verified == false then "não executada" else "não informado na marca" end' <<<"$marca")"
  elif [[ "$marca" != '{}' ]]; then
    local_estado="marca de outra entrega; validação atual desconhecida"
  fi
  jq -n --arg sessao "$s" --arg base_sha "$base_sha" --arg candidate_sha "$candidato" \
    --arg arquivos "$resumo" --arg parecer "$parecer" --arg local_estado "$local_estado" --argjson marca "$marca" --argjson marca_atual "$marca_atual" \
    '{sessao: $sessao, base_sha: $base_sha, candidate_sha: $candidate_sha,
      arquivos: $arquivos, validacao_local: $local_estado, marca: $marca, marca_atual: $marca_atual, parecer: $parecer}'
}

# Arquivo PREFIXO<n>.md de maior n. Glob em vez de ls: sem correspondência o
# padrão volta literal, e o teste de existência descarta esse caso. A ordenação
# por versão mantém r10 depois de r2, que a ordem de texto do glob inverteria.
mais_recente() {
  local -a achados=()
  local a
  # Só PREFIXO + número + .md: o parecer de proj--fix-rotas não é de proj--fix.
  for a in "$1"[0-9]*.md; do
    [[ -e "$a" && "${a#"$1"}" =~ ^[0-9]+\.md$ ]] && achados+=("$a")
  done
  ((${#achados[@]})) || return 0
  printf '%s\n' "${achados[@]}" | sort -V | tail -1
}

icone() {
  case "$1" in
    aguardando) printf '󰂞' ;;
    trabalhando) printf '󰑮' ;;
    concluido) printf '󰄬' ;;
    interrompido) printf '󰜺' ;;
    *) printf '󰚩' ;;
  esac
}

case "${1:-}" in
  --sessao-worktree-json|--contexto-json)
    exec python3 "$JANGADA_CORE_PY/nucleo/contexto.py" "$1" "$JANGADA_ESTADO" "${2:?informe o argumento da consulta}"
    ;;
  --rodadas-json)
    (($# == 2)) || { echo "uso: jangada-agentes --rodadas-json SESSAO" >&2; exit 2; }
    exec python3 "$JANGADA_CORE_PY/nucleo/rodadas.py" "$JANGADA_ESTADO" "$2"
    ;;
  --coordenadores-json)
    (($# == 1)) || { echo "uso: jangada-agentes --coordenadores-json" >&2; exit 2; }
    sessoes_vivas | exec python3 "$JANGADA_CORE_PY/nucleo/coordenadores.py" "$JANGADA_ESTADO"
    ;;
  --lista-json)
    listar json
    ;;
  --observacao-json)
    exec python3 "$JANGADA_CORE_PY/nucleo/observacao.py" "$JANGADA_ESTADO"
    ;;
  --lista|--lista-atualizada)
    listar
    ;;
  --confianca)
    confianca "${2:?informe a sessão}" 1
    ;;
  --limpar-orfaos)
    limpar_orfaos
    ;;
  --waybar)
    linhas="$(listar)"
    # Consumo do Claude no bloco de 5 horas, com cache próprio de 60 s.
    consumo=""
    if [[ -d "$HOME/.claude/projects" ]]; then
      consumo="$("$JANGADA_CORE_PATH/bin/jangada-consumo" --curto 2>/dev/null || true)"
    fi
    if [[ -z "$linhas" ]]; then
      dica=$'nenhum agente ativo\n\nSUPER+A: nova tarefa\nSUPER+SHIFT+A: central de tarefas\nSUPER+CTRL+A: central de tarefas'
      [[ -n "$consumo" ]] && dica+=$'\n\n'"$consumo"
      jq -cn --arg d "$dica" '{text:"󰚩 0", tooltip:$d, class:"vazio"}'
      exit 0
    fi
    total="$(wc -l <<<"$linhas")"
    aguardando="$(awk -F'\t' '$1=="aguardando"' <<<"$linhas" | wc -l)"
    trabalhando="$(awk -F'\t' '$1=="trabalhando"' <<<"$linhas" | wc -l)"
    concluido="$(awk -F'\t' '$1=="concluido"' <<<"$linhas" | wc -l)"
    interrompido="$(awk -F'\t' '$1=="interrompido"' <<<"$linhas" | wc -l)"
    # Precedência do que pede atenção: quem espera resposta vem antes de quem
    # está rodando, e o que já terminou bem fica por último.
    classe="ativo"
    ((concluido > 0)) && classe="concluido"
    ((trabalhando > 0)) && classe="trabalhando"
    ((aguardando > 0)) && classe="aguardando"
    texto="󰚩 $total"
    ((trabalhando > 0)) && texto+="  󰑮 $trabalhando"
    ((aguardando > 0)) && texto+="  󰂞 $aguardando"
    ((concluido > 0)) && texto+="  󰄬 $concluido"
    ((interrompido > 0)) && texto+="  󰜺 $interrompido"
    dica="󰚩 Sessões de agentes ($total):"
    cont=0
    while IFS="$US" read -r est s _dir _atz ramo tarefa; do
      [[ -n "$s" ]] || continue
      cont=$((cont + 1))
      if ((cont > 10)); then
        continue
      fi
      s_pango="${s//&/&amp;}"
      s_pango="${s_pango//</&lt;}"
      s_pango="${s_pango//>/&gt;}"
      case "$est" in
        aguardando) simb="󰂞" ;;
        trabalhando) simb="󰑮" ;;
        concluido) simb="󰄬" ;;
        interrompido) simb="󰜺" ;;
        *) simb="●" ;;
      esac
      dica+=$'\n\n'"$simb $s_pango [$est]"
      [[ -n "$ramo" ]] && dica+=$'\n   ramo: '"$ramo"
      [[ -n "$tarefa" ]] && dica+=$'\n   tarefa: '"$tarefa"
    done < <(campos "$linhas")
    if ((total > 10)); then
      dica+=$'\n\n... e mais '"$((total - 10))"' sessões'
    fi
    [[ -n "$consumo" ]] && dica+=$'\n\n'"$consumo"
    dica+=$'\n\nClique: central de tarefas · Clique direito: nova tarefa'
    jq -cn --arg t "$texto" --arg d "$dica" --arg c "$classe" '{text:$t, tooltip:$d, class:$c}'
    ;;
  --focar)
    focar "${2:?informe a sessão}"
    ;;
  --integracao-json)
    previa_integracao "${2:?informe a sessão}"
    ;;
  --previa)
    previa "${2:?informe a sessão}"
    ;;
  --proximo)
    proximo
    ;;
  --anterior)
    anterior
    ;;
  --restaurar)
    limpar_orfaos
    if [[ -n "${2:-}" ]]; then
      restaurar "$2"
    else
      n=0
      while IFS=$'\t' read -r est s _resto; do
        [[ "$est" == interrompido ]] || continue
        restaurar "$s" && n=$((n + 1))
      done < <(listar)
      echo "sessões restauradas: $n"
    fi
    ;;
  --janela|--janela-anterior|--painel|--painel-anterior)
    jangada_abrir_central
    ;;
  --monitor)
    while true; do
      clear
      printf 'AGENTES  (%s)\n\n' "$(date +%H:%M:%S)"
      limpar_orfaos
      linhas="$(listar)"
      if [[ -z "$linhas" ]]; then
        echo "nenhum agente ativo. SUPER+A abre Nova tarefa."
      else
        while IFS="$US" read -r estado s dir atualizado _resto; do
          printf '%s  %-12s %-32s %s\n' "$(icone "$estado")" "$estado" "$s" "${atualizado:11:8}"
        done < <(campos "$linhas")
        # O estado é o primeiro campo da linha.
        if grep -qE '^(concluido|aguardando)' <<<"$linhas"; then
          printf '\nciclo encerrado fica na lista. Ctrl+X no seletor encerra a\n'
          printf 'sessão e remove o worktree; sozinho, sai em %sh.\n' "$guardar_horas"
        fi
      fi
      sleep 2
    done
    ;;
  --limpar-concluidos)
    # O "concluido" vem do arquivo de estado, que o agente isolado consegue
    # gravar, inclusive o de outra sessão. Encerrar em lote só com o que ele
    # diz derrubaria uma sessão viva sem perguntar; por isso a lista vai para
    # a tela e só segue com confirmação, e sem terminal nada é encerrado.
    limpar_orfaos
    linhas="$(listar)"
    vivas="$(sessoes_vivas)"
    concluidas=(); lista=""
    while IFS=$'\t' read -r est s dir atualizado _resto; do
      [[ "$est" == "concluido" ]] && concluidas+=("$s") || continue
      situacao="sem sessão no tmux"
      grep -qxF "$s" <<<"$vivas" && situacao="sessão aberta no tmux"
      # Tudo aqui saiu do estado ou do nome do arquivo: sem caracteres de
      # controle na tela.
      lista+="$(printf '  %s  %s  (%s, atualizado em %s)' "$s" "$dir" "$situacao" "$atualizado" \
        | tr -d '\000-\037\177')"$'\n'
    done <<<"$linhas"
    if [[ "${#concluidas[@]}" -eq 0 ]]; then
      echo "nenhuma sessão concluída para limpar."
      exit 0
    fi
    echo "sessões marcadas como concluídas (${#concluidas[@]}); o estado é gravado pelo próprio agente, confira:"
    printf '%s' "$lista"
    r=""
    read -r -p "encerrar todas e remover os worktrees? [s/N] " r || true
    [[ "${r,,}" == s* ]] || { echo "nada foi feito"; exit 0; }
    falhas=0
    for s in "${concluidas[@]}"; do
      echo "==> limpando $(tr -d '\000-\037\177' <<<"$s")"
      "$JANGADA_CORE_PATH/bin/jangada-agente-fim" "$s" || falhas=$((falhas + 1))
    done
    if ((falhas > 0)); then
      echo "limpeza concluída com $falhas aviso(s)" >&2
      exit 1
    fi
    echo "todas as sessões concluídas foram limpas."
    ;;
  "")
    limpar_orfaos
    escolha="$(listar | awk -F'\t' '{printf "%s\t%s\t%s\n", $1, $2, $3}' | fzf \
      --delimiter '\t' --with-nth 1,2 --prompt 'agente > ' --reverse \
      --header 'Enter: abrir (ou restaurar)   Alt+I: integrar   Ctrl+X: fechar   Alt+L: limpar concluídos' \
      --expect ctrl-x,alt-i,alt-l \
      --preview "'$0' --previa {2}")" || exit 0
    tecla="$(head -1 <<<"$escolha")"
    s="$(sed -n 2p <<<"$escolha" | cut -f2)"
    fim=()
    case "$tecla" in
      ctrl-x) [[ -n "$s" ]] && fim=("$JANGADA_CORE_PATH/bin/jangada-agente-fim" "$s") ;;
      alt-i) [[ -n "$s" ]] && fim=("$JANGADA_CORE_PATH/bin/jangada-agente-fim" --integrar "$s") ;;
      alt-l) fim=("$0" --limpar-concluidos) ;;
    esac
    if ((${#fim[@]})); then
      exec "${fim[@]}"
    fi
    [[ -n "$s" ]] || exit 0
    focar "$s"
    ;;
  -h|--ajuda)
    sed -n '2,27s/^# \{0,1\}//p' "$0"
    ;;
  *)
    echo "opção desconhecida: $1" >&2; exit 1
    ;;
esac
