#!/usr/bin/env bash
# Roda um comando no bubblewrap, com o sistema somente leitura e a pasta atual
# gravável. O jangada-agente abre o agente por aqui.
#
# Uso: jangada-isolar [--mostrar] [--conta NOME] [--provedor NOME]
#                      [--delegar DESTINO] [--] COMANDO [ARGUMENTOS]
#   --mostrar      imprime a chamada ao bwrap, um argumento por linha, e sai
#   --provedor     provedor cujo login o comando recebe (claude, agy, codex ou
#                  nenhum); sem ele, vem do nome do comando
#   --delegar      concede também o provedor para onde a sessão delega
#                  (agy, claude, nativo ou local) e o Codex, se os modelos do
#                  Codex econômico estão configurados
#
# Graváveis: a pasta atual (o clone da sessão, com .git próprio; num
# worktree antigo, do .git comum só o que um commit precisa), as
# pastas do Claude e do agy, o estado dos agentes, as métricas do
# jangada-validar, o histórico de estados, o registro de delegações e o que
# estiver em JANGADA_ISOLAR_ESCRITA (caminhos separados por ":"). O ~/.cache,
# os retratos do shell e o ambiente das sessões do Claude aparecem com o
# conteúdo de fora, mas o que o agente grava neles some no fim. O /tmp e o
# XDG_RUNTIME_DIR são próprios; com eles somem o socket do tmux, do Hyprland,
# do Wayland e do gpg-agent. O D-Bus da sessão passa pelo xdg-dbus-proxy, que
# só deixa falar com as notificações e, com o agy concedido, com os itens
# do keyring de JANGADA_ISOLAR_KEYRING_ITEM (pares atributo=valor separados
# por espaço). Sem essa lista o keyring fica fechado;
# JANGADA_ISOLAR_KEYRING=servico abre o serviço inteiro, com aviso. O
# agente não vê os processos de fora (namespace de PID próprio) nem o Docker.
#
# Provedores concedidos: no perfil agente, o login (arquivos, variáveis e a
# conta do agy) só aparece para o provedor do comando, para os da
# delegação com --delegar e para os de JANGADA_ISOLAR_PROVEDORES (nomes
# separados por ":"). Os outros somem. Já isolado, o comando de um provedor
# que a sessão não recebeu é recusado.
#
# A pasta pessoal começa vazia e só aparece o que os agentes e o jangada
# usam, mais o que estiver em JANGADA_ISOLAR_CASA_LER (caminhos separados
# por ":"); JANGADA_ISOLAR_CASA=inteira volta a mostrar tudo, com aviso. O
# ambiente é mínimo: só passam as variáveis do sistema e do jangada, menos
# as que parecem credencial, mais as de JANGADA_ISOLAR_AMBIENTE_MANTER (nomes
# separados por ":"); JANGADA_ISOLAR_AMBIENTE=herdado volta a herdar tudo,
# com aviso, menos as credenciais conhecidas. Valor desconhecido nessas
# variáveis é recusado. O agente usa a rede.
#
# Ficam somente leitura, mesmo dentro dos graváveis, os arquivos que o git,
# o Claude ou o agy leem como configuração ou executam fora do isolamento:
# config, hooks, commondir e gitdir do git; settings, CLAUDE.md, commands,
# agents, skills, hooks e plugins do Claude; os binários do agy; os clones
# do AUR. Ficam ocultas as chaves, os perfis de navegador e o histórico da
# área de transferência (JANGADA_ISOLAR_OCULTAR substitui a lista), e sempre
# o token do antigo painel. JANGADA_ISOLAR_OCULTAR_EXTRA acrescenta caminhos
# à lista em uso, sem substituir a padrão.
#
# JANGADA_ISOLAR_PERFIL=verificacao é para código do repositório que não é
# agente (lintr, .jangada/validar.sh): sem rede, sem D-Bus e sem as
# credenciais dos provedores, nem em arquivo nem em variável.
# "verificacao-rede" mantém a rede. Perfil desconhecido é recusado.
#
# Na correção P0 o isolamento é obrigatório; já isolado (variável e a marca
# que só o bwrap monta), o perfil agente roda direto; os de verificação
# sempre criam outro isolamento. Sem o bwrap, recusa.
#
# Numa sessão de agente (JANGADA_SESSAO com cópia em revisoes/), fica aqui
# fora um atendente da revisão, num soquete que aparece dentro em
# /tmp/.jangada-atendente/soquete (JANGADA_VALIDAR_SOQUETE). O
# jangada-validar de dentro manda por ele só o sha da cabeça e a resposta ao
# parecer anterior; a revisão roda
# fora, com os metadados e o limite de rodadas de fora, e só fora se grava.
# O atendente acaba com a sessão.
set -euo pipefail
# shellcheck source=bin/jangada-config
source "$(dirname "${BASH_SOURCE[0]}")/jangada-config"

mostrar=0
conta_opt=""
provedor_opt=""
delegar_opt=""
while (($#)); do
  case "$1" in
    --mostrar) mostrar=1; shift ;;
    --conta) [[ $# -ge 2 && -n "$2" ]] || exit 2; conta_opt="$2"; shift 2 ;;
    --provedor) [[ $# -ge 2 && -n "$2" ]] || exit 2; provedor_opt="$2"; shift 2 ;;
    --delegar) [[ $# -ge 2 && -n "$2" ]] || exit 2; delegar_opt="$2"; shift 2 ;;
    -h|--ajuda|--help) sed -n '2,/^set -euo/{/^set -euo/d;s/^# \{0,1\}//p}' "$0"; exit 0 ;;
    --) shift; break ;;
    *) break ;;
  esac
done
(($#)) || { echo "uso: jangada-isolar [--mostrar] [--conta NOME] [--provedor NOME] [--delegar DESTINO] [--] COMANDO" >&2; exit 1; }

# Marca do isolamento: um ponto de montagem no /tmp próprio. Fora, qualquer
# processo cria um arquivo no /tmp, mas só quem monta cria um ponto de
# montagem; por isso JANGADA_ISOLADO herdado do ambiente não basta.
marca="${JANGADA_MARCA_ISOLADO:-/tmp/.jangada-isolado}"
ja_isolado() {
  [[ -n "${JANGADA_ISOLADO:-}" ]] || return 1
  awk -v m="$marca" '$5 == m { achou = 1 } END { exit !achou }' /proc/self/mountinfo 2>/dev/null
}

perfil="${JANGADA_ISOLAR_PERFIL:-agente}"
case "$perfil" in
  agente | verificacao | verificacao-rede | implementacao) ;;
  *) echo "jangada-isolar: perfil desconhecido em JANGADA_ISOLAR_PERFIL: $perfil" >&2; exit 1 ;;
esac

# Modos da casa, do ambiente e do keyring. Valor desconhecido é recusado: um
# erro de digitação não pode virar o modo aberto.
casa_modo="${JANGADA_ISOLAR_CASA:-minima}"
ambiente_modo="${JANGADA_ISOLAR_AMBIENTE:-minimo}"
keyring_modo="${JANGADA_ISOLAR_KEYRING:-itens}"
case "$casa_modo" in minima | inteira) ;; *) echo "jangada-isolar: JANGADA_ISOLAR_CASA aceita minima ou inteira, não $casa_modo" >&2; exit 1 ;; esac
case "$ambiente_modo" in minimo | herdado) ;; *) echo "jangada-isolar: JANGADA_ISOLAR_AMBIENTE aceita minimo ou herdado, não $ambiente_modo" >&2; exit 1 ;; esac
case "$keyring_modo" in itens | servico) ;; *) echo "jangada-isolar: JANGADA_ISOLAR_KEYRING aceita itens ou servico, não $keyring_modo" >&2; exit 1 ;; esac

# Provedores cujo login o comando recebe. O principal vem de --provedor ou do
# nome do comando; um comando que não é de provedor não recebe nenhum. Com
# --delegar (a sessão de agente), entra também o destino da delegação. JANGADA_ISOLAR_PROVEDORES acrescenta outros, separados por ":".
provedor_valido() {
  case "$1" in claude | codex | agy) return 0 ;; esac
  echo "jangada-isolar: provedor desconhecido: $1 (aceita claude, codex ou agy)" >&2
  exit 1
}
if [[ -n "$provedor_opt" ]]; then
  [[ "$provedor_opt" == nenhum ]] || provedor_valido "$provedor_opt"
  principal="$provedor_opt"
else
  case "$(basename -- "$1")" in
    claude) principal=claude ;;
    agy) principal=agy ;;
    codex | jangada-codex) principal=codex ;;
    *) principal=nenhum ;;
  esac
fi
concedidos=" "
if [[ "$perfil" == agente ]]; then
  [[ "$principal" == nenhum ]] || concedidos+="$principal "
  if [[ -n "$delegar_opt" && "$principal" != nenhum ]]; then
    destino="$(jangada_delegacao "$principal" "$delegar_opt")"
    case "$destino" in agy | claude) [[ "$concedidos" == *" $destino "* ]] || concedidos+="$destino " ;; esac
    if [[ -n "$JANGADA_CODEX_ECONOMICO_MODELO$JANGADA_CODEX_PRINCIPAL_MODELO" && "$concedidos" != *" codex "* ]]; then
      concedidos+="codex "
    fi
  fi
  IFS=': ' read -ra extras_provedores <<<"${JANGADA_ISOLAR_PROVEDORES:-}"
  for p in "${extras_provedores[@]}"; do
    [[ -n "$p" ]] || continue
    provedor_valido "$p"
    [[ "$concedidos" == *" $p "* ]] || concedidos+="$p "
  done
fi
concedido() { [[ "$concedidos" == *" $1 "* ]]; }
concedidos_lista="${concedidos# }"
concedidos_lista="${concedidos_lista% }"

contas_agy="$(jangada_contas_agy)" || exit 1
if [[ -n "$conta_opt" ]]; then export JANGADA_AGY_CONTA="$conta_opt"; fi
jangada_conta_agy || exit 1
cli_agy="$HOME/.gemini/antigravity-cli"
# Pasta do Claude: CLAUDE_CONFIG_DIR, se definida, senão ~/.claude. O agy
# aceita variáveis que levam os dados para outra pasta, fora da montagem por
# sessão abaixo; com elas o agy não abre, em vez de gravar onde não há
# separação.
claude_casa="${CLAUDE_CONFIG_DIR:-$HOME/.claude}"
if [[ "$claude_casa" != /* ]]; then
  concedido claude && { echo "jangada-isolar: CLAUDE_CONFIG_DIR precisa ser um caminho absoluto" >&2; exit 1; }
  claude_casa="$HOME/.claude"
fi
claude_casa="$(realpath -m -- "$claude_casa")"
if concedido agy; then
  for v in ANTIGRAVITY_GEMINI_DIR ANTIGRAVITY_APP_DATA_DIR ANTIGRAVITY_CONFIG_REL_DIR \
           ANTIGRAVITY_EXECUTABLE_DATA_DIR GEMINI_DIR; do
    [[ -z "${!v+x}" ]] || {
      echo "jangada-isolar: $v definida; os dados do agy por sessão só valem na pasta padrão" >&2
      exit 1
    }
  done
fi
conta_configurada=0
[[ ! -e "$JANGADA_ESTADO/contas/agy.json" ]] || conta_configurada=1
if ja_isolado && [[ -n "${JANGADA_AGY_CONTA_MONTADA:-}" && "$CONTA_AGY_NOME" != "$JANGADA_AGY_CONTA_MONTADA" ]]; then
  echo "jangada-isolar: conta $CONTA_AGY_NOME indisponível nesta sessão; conta montada: $JANGADA_AGY_CONTA_MONTADA" >&2
  exit 1
fi
if [[ "$perfil" == agente ]] && ja_isolado \
   && { ((!conta_configurada)) || [[ "${JANGADA_AGY_CONTA_MONTADA:-}" == "$CONTA_AGY_NOME" ]]; }; then
  # O login de um provedor só existe aqui dentro se o isolamento de fora o
  # concedeu. A variável só serve para recusar com mensagem clara; ela não
  # concede nada. Sem ela, a sessão foi aberta antes de 30/10/2026 e montou
  # os logins como era então: o comando roda e o aviso pede a reabertura.
  if [[ -z "${JANGADA_ISOLAR_CONCEDIDOS+x}" ]]; then
    echo "jangada-isolar: sessão aberta antes da concessão por provedor; reabra-a para valer o isolamento atual" >&2
  elif [[ "$principal" != nenhum && " $JANGADA_ISOLAR_CONCEDIDOS " != *" $principal "* ]]; then
    echo "jangada-isolar: esta sessão não recebeu o login do provedor $principal; conceda-o fora (JANGADA_ISOLAR_PROVEDORES ou a delegação configurada)" >&2
    exit 1
  fi
  exec "$@"
fi
if [[ "$perfil" == agente && "$JANGADA_AGENTE_ISOLAR" == 0 ]]; then
  echo "jangada-isolar: isolamento obrigatório na correção P0; configuração sem isolamento ignorada" >&2
fi
if ((!mostrar)) && ! command -v bwrap >/dev/null 2>&1; then
  echo "jangada-isolar: bwrap não instalado (pacote bubblewrap); o agente não abre sem isolamento." >&2
  echo "Instale a dependência antes de abrir agentes; não há abertura sem isolamento nesta versão." >&2
  exit 1
fi

pasta="$(pwd -P)"
# /tmp próprio: um rm do agente ali não apaga os temporários do sistema.
# PID próprio: o agente não mata nem inspeciona os processos da sessão, e
# tudo o que ele deixou rodando morre com ele. Nenhum hook grava o pid de
# dentro no estado; se um dia gravar, o número não vale fora.
args=(--ro-bind / / --dev /dev --proc /proc --tmpfs /tmp --ro-bind /dev/null "$marca"
      --unshare-pid --die-with-parent)
[[ "$perfil" == verificacao ]] && args+=(--unshare-net)
if [[ "$perfil" == implementacao ]]; then
  montagem="$(python3 "$JANGADA_CORE_PATH/delegacao/implementacao.py" montagem "${JANGADA_IMPLEMENTACAO_MANIFESTO:-}")" || exit 1
  mapfile -t args <<<"$montagem"
fi

# Executáveis temporários do controlador continuam visíveis, somente leitura.
# As proteções obrigatórias abaixo prevalecem sobre estas montagens.
IFS=: read -ra dirs_temporarios <<<"$PATH"
for p in "${dirs_temporarios[@]}"; do
  [[ "$p" == /tmp/?* && -d "$p" ]] && args+=(--ro-bind "$p" "$p")
done

gravavel() { [[ -e "$1" ]] && args+=(--bind "$1" "$1"); return 0; }
somente_leitura() { [[ -e "$1" ]] && args+=(--ro-bind "$1" "$1"); return 0; }

# Casa mínima (padrão): a pasta pessoal vira uma pasta vazia em memória, e
# por cima volta, somente leitura, só o que os agentes e o jangada leem. As
# montagens seguintes (graváveis, somente leitura, ocultos) valem por cima
# dela. Os arquivos de início do shell ficam de fora: é neles que se exporta
# token. Do login, só o dos provedores concedidos.
# JANGADA_ISOLAR_CASA=inteira volta ao modo antigo, com aviso a cada abertura.
if [[ "$perfil" != implementacao && "$casa_modo" == inteira ]]; then
  echo "jangada-isolar: JANGADA_ISOLAR_CASA=inteira: o agente lê toda a pasta pessoal fora da lista de ocultos" >&2
fi
if [[ "$perfil" != implementacao && "$casa_modo" == minima ]]; then
  args+=(--tmpfs "$HOME")
  visiveis=("$JANGADA_CORE_PATH" "$JANGADA_CONFIG" "$JANGADA_ESTADO")
  IFS=: read -ra dirs_path <<<"$PATH"
  for p in "${dirs_path[@]}"; do
    [[ "$p" == "$HOME"/?* ]] && visiveis+=("$p")
  done
  for p in .local/bin .local/lib .local/share/claude .local/share/mise .config/mise \
           .config/git .gitconfig R; do
    visiveis+=("$HOME/$p")
  done
  concedido claude && visiveis+=("$HOME/.claude.json")
  concedido agy && visiveis+=("$HOME/.gemini")
  concedido codex && visiveis+=("${CODEX_HOME:-$HOME/.codex}")
  IFS=: read -ra extras <<<"${JANGADA_ISOLAR_CASA_LER:-}"
  for p in "${extras[@]}"; do
    [[ -n "$p" ]] && visiveis+=("$(realpath -m "${p/#\~/$HOME}")")
  done
  for p in "${visiveis[@]}"; do
    somente_leitura "$p"
  done
fi

# Mostra o conteúdo de fora, e o que o agente grava fica numa camada em
# memória que some no fim. Sem suporte no bwrap ou no kernel, vira uma pasta
# vazia em memória, ou somente leitura com "ro" no segundo argumento: a falta
# da sobreposição nunca deixa o agente gravar no disco.
sobreposicao_ok=""
temporario() {
  [[ -d "$1" ]] || return 0
  if [[ -z "$sobreposicao_ok" ]]; then
    sobreposicao_ok=0
    bwrap --ro-bind / / --overlay-src "$1" --tmp-overlay "$1" true 2>/dev/null && sobreposicao_ok=1
  fi
  if ((sobreposicao_ok)); then
    args+=(--overlay-src "$1" --tmp-overlay "${3:-$1}")
  elif [[ "${2:-}" == ro ]]; then
    args+=(--ro-bind "$1" "${3:-$1}")
  else
    args+=(--tmpfs "${3:-$1}")
  fi
}

# Sockets de /run que dão root ou mudam a máquina: Docker (o grupo docker
# equivale a root), containerd, podman, tailscale, o sshd local e o D-Bus do
# sistema (desligar a rede, desligar a máquina).
for p in /run/docker.sock /run/containerd /run/podman /run/tailscale /run/ssh-unix-local /run/dbus; do
  if [[ -d "$p" ]]; then
    args+=(--tmpfs "$p")
  elif [[ -e "$p" ]]; then
    args+=(--ro-bind /dev/null "$p")
  fi
done

# XDG_RUNTIME_DIR próprio: some o socket do Hyprland (hyprctl dispatch roda
# comando fora), do Wayland, do gpg-agent, do systemd do usuário, do
# PipeWire e de outros programas. O D-Bus da sessão volta pelo proxy, que só
# deixa falar com org.freedesktop.secrets (o agy lê o login do keyring) e
# org.freedesktop.Notifications (os hooks avisam pelo notify-send). Sem
# proxy, o agente fica sem D-Bus.
#
# O implementador (perfil implementacao) é chamado de dentro da sessão do
# autor, onde não há como subir outro proxy: o xdg-dbus-proxy numérico das
# chamadas falsas (serial 0xFFFF0000) é derrubado pelo proxy do autor, e este
# nega Service.SearchItems. Por isso o jangada-isolar de fora sobe, junto com
# o proxy do autor, um segundo com o filtro do implementador e o liga dentro
# da sessão em $XDG_RUNTIME_DIR/bus-implementacao. O filtro dele é subconjunto
# do filtro do autor, então o autor não alcança nada novo.
dbus_sinc=""
dbus_impl_sinc=""
sem_login=69
recusar_sem_login() {
  echo "jangada-isolar: sem login do agy no keyring: $1" >&2
  exit "$sem_login"
}
# Só um ponto de montagem vem de fora: um soquete criado pelo autor na própria
# pasta em memória (ou apontado por outro XDG_RUNTIME_DIR) que repasse ao bus
# dele daria ao implementador o filtro do autor, com CreateItem.
soquete_montado() {
  local alvo
  alvo="$(realpath -e -- "$1" 2>/dev/null)" || return 1
  # O mountinfo escreve barra, espaço, tab e quebra de linha como \134, \040, \011 e \012.
  alvo="${alvo//\\/\\134}"; alvo="${alvo// /\\040}"; alvo="${alvo//$'\t'/\\011}"; alvo="${alvo//$'\n'/\\012}"
  M="$alvo" awk '$5 == ENVIRON["M"] { achou = 1 } END { exit !achou }' /proc/self/mountinfo 2>/dev/null
}
chamada_aninhada=0
[[ "$perfil" != implementacao ]] || ! ja_isolado || chamada_aninhada=1
soquete_impl="${XDG_RUNTIME_DIR:-}/bus-implementacao"
if ((chamada_aninhada && !mostrar)) \
   && { [[ -z "${XDG_RUNTIME_DIR:-}" || -L "$soquete_impl" || ! -S "$soquete_impl" ]] \
        || ! soquete_montado "$soquete_impl"; }; then
  recusar_sem_login 'a sessão do autor não trouxe o soquete do implementador (item do keyring ausente ou sessão aberta sem ele)'
fi
if [[ -n "${XDG_RUNTIME_DIR:-}" && -d "$XDG_RUNTIME_DIR" ]]; then
  args+=(--perms 0700 --tmpfs "$XDG_RUNTIME_DIR")
  if ((chamada_aninhada)); then
    # Só o soquete trazido de fora pela sessão do autor vale.
    if ((!mostrar)); then
      args+=(--ro-bind "$soquete_impl" "$XDG_RUNTIME_DIR/bus")
      dbus_aninhado=1
    fi
  fi
fi
if ((!chamada_aninhada)) && [[ -n "${XDG_RUNTIME_DIR:-}" && -d "$XDG_RUNTIME_DIR" ]]; then
  pasta_proxy="$XDG_RUNTIME_DIR/jangada-isolar"
  if ((!mostrar)) && [[ ( "$perfil" == agente || "$perfil" == implementacao ) && -n "${DBUS_SESSION_BUS_ADDRESS:-}" ]] \
     && command -v xdg-dbus-proxy >/dev/null 2>&1 \
     && { [[ -d "$pasta_proxy" ]] || mkdir -m 0700 "$pasta_proxy" 2>/dev/null; }; then
    segredos=org.freedesktop.secrets raiz=/org/freedesktop/secrets
    itens_keyring=()
    colecoes=("$raiz/aliases/default" "$raiz/collection/login")
    # Preenche itens_keyring e colecoes com os itens do keyring que têm os
    # atributos de JANGADA_ISOLAR_KEYRING_ITEM. A busca roda uma vez, aqui
    # fora; item criado depois só entra na próxima abertura.
    achar_itens_keyring() {
      local atributos="" par item
      local -a pares
      read -ra pares <<<"$JANGADA_ISOLAR_KEYRING_ITEM"
      for par in "${pares[@]}"; do
        if [[ "$par" =~ ^([A-Za-z0-9_.:@+-]+)=([A-Za-z0-9_.:@/+-]+)$ ]]; then
          atributos+="${atributos:+, }'${BASH_REMATCH[1]}': '${BASH_REMATCH[2]}'"
        else
          echo "jangada-isolar: JANGADA_ISOLAR_KEYRING_ITEM espera pares atributo=valor separados por espaço; sem eles o agente não lê o keyring." >&2
          return 0
        fi
      done
      [[ -n "$atributos" ]] || return 0
      while IFS= read -r item; do
        itens_keyring+=("$item")
        [[ " ${colecoes[*]} " == *" ${item%/*} "* ]] || colecoes+=("${item%/*}")
      done < <(timeout 5 gdbus call --session --dest "$segredos" --object-path "$raiz" \
        --method org.freedesktop.Secret.Service.SearchItems "{$atributos}" 2>/dev/null \
        | grep -oE "$raiz/collection/[A-Za-z0-9_]+/[A-Za-z0-9_]+" || true)
    }
    # Preenche politica com o filtro do keyring de um perfil. O autor também
    # cria e regrava o item (o go-keyring do agy procura o item pelos atributos
    # e regrava o token por CreateItem); o implementador só lê o segredo.
    politica_keyring() {
      local item colecao
      politica=(--see="$segredos"
        --call="$segredos=org.freedesktop.DBus.Properties.Get@$raiz"
        --call="$segredos=org.freedesktop.Secret.Service.OpenSession@$raiz"
        --call="$segredos=org.freedesktop.Secret.Service.Unlock@$raiz"
        --call="$segredos=org.freedesktop.Secret.Session.Close@$raiz/session/*"
        --call="$segredos=org.freedesktop.Secret.Prompt.*@$raiz/prompt/*"
        --broadcast="$segredos=org.freedesktop.Secret.Prompt.Completed@$raiz/prompt/*")
      for item in "${itens_keyring[@]}"; do
        if [[ "$1" == implementacao ]]; then
          politica+=(--call="$segredos=org.freedesktop.Secret.Item.GetSecret@$item"
                     --call="$segredos=org.freedesktop.DBus.Properties.Get@$item"
                     --call="$segredos=org.freedesktop.DBus.Properties.GetAll@$item")
        else
          politica+=(--call="$segredos=*@$item")
        fi
      done
      for colecao in "${colecoes[@]}"; do
        politica+=(--call="$segredos=org.freedesktop.Secret.Collection.SearchItems@$colecao")
        [[ "$1" == implementacao ]] || politica+=(--call="$segredos=org.freedesktop.Secret.Collection.CreateItem@$colecao")
      done
    }
    if [[ "$perfil" == implementacao && -z "${JANGADA_ISOLAR_KEYRING_ITEM:-}" ]]; then
      recusar_sem_login 'implementação exige atributos de keyring já configurados; não liberar o serviço inteiro'
    fi
    # Só o agy usa o keyring, e só quando ele é concedido. Sem
    # JANGADA_ISOLAR_KEYRING_ITEM o keyring fica fechado; liberar o serviço
    # inteiro (com o keyring aberto, o agente alcança o que estiver nele)
    # exige JANGADA_ISOLAR_KEYRING=servico, com aviso a cada abertura.
    falar=(--talk=org.freedesktop.Notifications)
    falar_impl=()
    if command -v agy >/dev/null 2>&1 && { [[ "$perfil" == implementacao ]] || concedido agy; }; then
      if [[ -z "${JANGADA_ISOLAR_KEYRING_ITEM:-}" ]]; then
        if [[ "$keyring_modo" == servico ]]; then
          echo "jangada-isolar: JANGADA_ISOLAR_KEYRING=servico: o agente alcança todo o keyring aberto" >&2
          falar+=(--talk=org.freedesktop.secrets)
        else
          echo "jangada-isolar: keyring fechado ao agente: defina JANGADA_ISOLAR_KEYRING_ITEM (o agy que guarda o login em arquivo, por conta do catálogo, não precisa dele)" >&2
        fi
      else
        achar_itens_keyring
        politica_keyring "$perfil"
        falar+=("${politica[@]}")
        if ((${#itens_keyring[@]})); then
          politica_keyring implementacao
          falar_impl=(--talk=org.freedesktop.Notifications "${politica[@]}")
        elif [[ "$perfil" == implementacao ]]; then
          recusar_sem_login 'nenhum item do keyring com os atributos de JANGADA_ISOLAR_KEYRING_ITEM'
        fi
      fi
    fi
    sock="$pasta_proxy/bus-$$"
    rm -f "$sock"
    # O proxy escreve um byte quando está pronto e sai quando o outro lado do
    # cano fecha. O bwrap guarda esse lado (--sync-fd) enquanto o agente vive.
    exec {dbus_sinc}< <(exec xdg-dbus-proxy "$DBUS_SESSION_BUS_ADDRESS" "$sock" \
      --filter "${falar[@]}" --fd=1 2>/dev/null)
    if read -r -N1 -t 5 -u "$dbus_sinc" _ && [[ -S "$sock" ]]; then
      args+=(--ro-bind "$sock" "$XDG_RUNTIME_DIR/bus" --sync-fd "$dbus_sinc"
             --setenv DBUS_SESSION_BUS_ADDRESS "unix:path=$XDG_RUNTIME_DIR/bus")
    else
      exec {dbus_sinc}<&-
      dbus_sinc=""
    fi
    if [[ "$perfil" == agente ]] && ((${#falar_impl[@]})); then
      # Este lado do cano fica com este processo, que só acaba depois do
      # bwrap: o segundo proxy sai junto com ele.
      sock_impl="$pasta_proxy/bus-implementacao-$$"
      rm -f "$sock_impl"
      exec {dbus_impl_sinc}< <(exec xdg-dbus-proxy "$DBUS_SESSION_BUS_ADDRESS" "$sock_impl" \
        --filter "${falar_impl[@]}" --fd=1 2>/dev/null)
      if read -r -N1 -t 5 -u "$dbus_impl_sinc" _ && [[ -S "$sock_impl" ]]; then
        args+=(--ro-bind "$sock_impl" "$XDG_RUNTIME_DIR/bus-implementacao")
      else
        exec {dbus_impl_sinc}<&-
        dbus_impl_sinc=""
      fi
    fi
  fi
fi
[[ -n "$dbus_sinc" || -n "${dbus_aninhado:-}" ]] || args+=(--unsetenv DBUS_SESSION_BUS_ADDRESS)

if [[ "$perfil" == implementacao ]]; then
  args+=(--clearenv --setenv HOME "$HOME" --setenv PATH "$PATH" --setenv LANG "${LANG:-C.UTF-8}"
         --setenv TMPDIR /tmp/jangada-implementacao-temporarios
         --setenv JANGADA_ISOLADO 1 --setenv JANGADA_HOOK_DESLIGADO 1 --setenv JANGADA_AGY_PAPEL implementador)
  [[ -z "$dbus_sinc" && -z "${dbus_aninhado:-}" ]] || args+=(--setenv DBUS_SESSION_BUS_ADDRESS "unix:path=$XDG_RUNTIME_DIR/bus")
  args+=(--chdir "$pasta" -- python3 -c 'import os,subprocess,sys
comando = sys.argv[1:]
catalogo = subprocess.run([comando[0], "agents"], capture_output=True, text=True, timeout=30)
if catalogo.returncode or "implementador" not in catalogo.stdout.splitlines():
    sys.exit("implementador ausente do catálogo privado; não usar agente padrão")
os.execvp(comando[0], comando)' "$@")
  if ((mostrar)); then printf '%s\n' bwrap "${args[@]}"; exit 0; fi
  exec python3 -c 'import os,stat,sys
permitido = int(sys.argv[1]) if sys.argv[1] else -1
for fd in (0,1,2):
    modo = os.fstat(fd).st_mode
    if stat.S_ISREG(modo) or stat.S_ISSOCK(modo):
        sys.exit("descritor padrão gravável ou soquete recusado")
for nome in os.listdir("/proc/self/fd"):
    fd = int(nome)
    if fd > 2 and fd != permitido:
        try: os.close(fd)
        except OSError: pass
os.execvp("bwrap", ["bwrap", *sys.argv[2:]])' "$dbus_sinc" "${args[@]}"
fi

gravavel "$pasta"
# Do Claude, a pasta ~/.claude (ou CLAUDE_CONFIG_DIR) fica gravável por causa
# do login: o .credentials.json é regravado por rename, que um bind só do
# arquivo não aceita. As conversas, a memória e o histórico dela vêm depois,
# de uma pasta própria da sessão (dados_claude). O ~/.claude.json (servidores
# MCP e confiança por projeto) fica somente leitura; perdê-lo só perde
# contadores. A pasta do CLI do agy é montada mais abaixo (dados_agy).
# Numa instalação nova a pasta ainda não existe, e sem o bind o agente não
# conseguiria criá-la.
mkdir -p "$claude_casa" "$HOME/.cache" 2>/dev/null || true
if ((!conta_configurada)) && concedido agy; then
  command -v agy >/dev/null 2>&1 && { mkdir -p "$CONTA_AGY_PASTA" 2>/dev/null || true; }
fi
gravavel "$claude_casa"
# O ~/.cache alimenta código que roda fora: clones do AUR que o yay compila
# com sudo, cache de compilação do Go, rodas do pip, bytecode do nvim, a
# atualização do Claude. O agente lê, e o que grava some no fim.
temporario "$HOME/.cache"
# Do estado do jangada, só o dos agentes, as métricas e o histórico de
# estados: o resto (a barra, as marcas das migrações) alimenta código que roda
# fora.
pasta_marcas="$JANGADA_ESTADO/marcas"
atualizar_marcas_host() {
  mkdir -p "$pasta_marcas" 2>/dev/null || true
  if command -v nvidia-smi >/dev/null 2>&1; then
    local vl tmp_vl
    vl="$(nvidia-smi --query-gpu=memory.free --format=csv,noheader,nounits 2>/dev/null | head -n1 | tr -d ' ' || true)"
    if [[ -n "$vl" && "$vl" =~ ^[0-9]+$ ]]; then
      tmp_vl="$(mktemp "$pasta_marcas/.vram-livre.XXXXXX" 2>/dev/null || true)"
      if [[ -n "$tmp_vl" ]]; then
        printf '%s %s\n' "$vl" "$(date +%s)" >"$tmp_vl"
        mv -f "$tmp_vl" "$pasta_marcas/vram-livre" 2>/dev/null || rm -f "$tmp_vl"
      fi
    fi
  fi
  if pgrep -f 'reaper SteamLaunch' >/dev/null 2>&1; then
    local tmp_ja
    tmp_ja="$(mktemp "$pasta_marcas/.jogo-ativo.XXXXXX" 2>/dev/null || true)"
    if [[ -n "$tmp_ja" ]]; then
      printf '%s\n' "$(date +%s)" >"$tmp_ja"
      mv -f "$tmp_ja" "$pasta_marcas/jogo-ativo" 2>/dev/null || rm -f "$tmp_ja"
    fi
  else
    rm -f "$pasta_marcas/jogo-ativo" 2>/dev/null || true
  fi
}

mkdir -p "$JANGADA_ESTADO/agentes" 2>/dev/null || true
# Recusa aliases, canais locais e descritores que contornariam a montagem.
aninhado=0
ja_isolado && aninhado=1
((aninhado)) || env -u JANGADA_ISOLADO \
  python3 "$JANGADA_CORE_PATH/orquestracao/confianca.py" preparar-isolamento "$JANGADA_ESTADO"
for p in validar.jsonl eventos-agentes.jsonl delegacoes.jsonl local.lock; do
  [[ -e "$JANGADA_ESTADO/$p" ]] || : 2>/dev/null >>"$JANGADA_ESTADO/$p" || true
done
gravavel "$JANGADA_ESTADO/agentes"
gravavel "$JANGADA_ESTADO/validar.jsonl"
gravavel "$JANGADA_ESTADO/eventos-agentes.jsonl"
gravavel "$JANGADA_ESTADO/delegacoes.jsonl"
# Trava das delegações locais. O agente pode segurar a trava e causar negação de serviço local.
gravavel "$JANGADA_ESTADO/local.lock"
((!mostrar)) && atualizar_marcas_host
mkdir -p "$pasta_marcas" 2>/dev/null || true
somente_leitura "$pasta_marcas"
IFS=: read -ra extras <<<"${JANGADA_ISOLAR_ESCRITA:-}"
for p in "${extras[@]}"; do
  [[ -n "$p" ]] && gravavel "$(realpath -m "${p/#\~/$HOME}")"
done

# Daqui em diante, somente leitura por cima dos graváveis.

# Dados por sessão dos provedores: conversas, memória e histórico do Claude e
# do agy ficam em $JANGADA_ESTADO/provedores/<provedor>/<sessão>, pasta oculta
# a todo isolamento; só a da própria sessão aparece, no lugar onde o cliente a
# procura. Reabrir a mesma JANGADA_SESSAO retoma os mesmos dados. Sem sessão
# válida, a pasta é efêmera: some quando este script sai, e depois de SIGKILL
# só na próxima abertura, quando o processo dono já não existe. Nada do
# histórico pessoal de fora é copiado. O jangada-delegar, que chama o agy sem
# sessão e lê o log e a conversa depois que ele sai, passa uma chave própria em
# JANGADA_ISOLAR_DADOS (delegacao-*), e ele mesmo apaga a pasta.
dados_raiz="$JANGADA_ESTADO/provedores"
dados_chave="${JANGADA_SESSAO:-}"
dados_efemeros=()
if ! [[ "$dados_chave" =~ ^[A-Za-z0-9_.-]+$ && "$dados_chave" != . && "$dados_chave" != .. ]] \
   || [[ "$dados_chave" == efemera-* || "$dados_chave" == delegacao-* ]]; then
  dados_chave="efemera-$$"
fi
if [[ -n "${JANGADA_ISOLAR_DADOS+x}" ]]; then
  [[ -z "${JANGADA_SESSAO:-}" && "$JANGADA_ISOLAR_DADOS" =~ ^delegacao-[A-Za-z0-9_.-]+$ ]] || {
    echo "jangada-isolar: JANGADA_ISOLAR_DADOS aceita só delegacao-* e sem JANGADA_SESSAO" >&2; exit 1
  }
  dados_chave="$JANGADA_ISOLAR_DADOS"
fi
dados_pasta() {
  local raiz alvo
  [[ ! -L "$dados_raiz" && ! -L "$dados_raiz/$1" && ! -L "$dados_raiz/$1/$dados_chave" ]] || return 1
  (umask 077; mkdir -p "$dados_raiz/$1/$dados_chave") || return 1
  raiz="$(realpath -e "$dados_raiz")" && alvo="$(realpath -e "$dados_raiz/$1/$dados_chave")" || return 1
  [[ "$alvo" == "$raiz/$1/$dados_chave" ]] || return 1
  printf '%s\n' "$alvo"
}
# Uma pasta de delegação (delegacao-PID-*) sobra quando o jangada-delegar
# morre por SIGKILL. Só some com o PID morto e sem nenhum processo vivo que
# a tenha recebido em JANGADA_ISOLAR_DADOS: um jangada-isolar órfão (o timeout
# dele ainda o encerra no prazo) mantém a pasta até sair.
dados_em_uso() {
  local f
  for f in /proc/[0-9]*/environ; do
    tr '\0' '\n' <"$f" 2>/dev/null | grep -qxF "JANGADA_ISOLAR_DADOS=$1" && return 0
  done
  return 1
}
dados_limpar_mortos() {
  local d pid
  for d in "$dados_raiz"/*/efemera-* "$dados_raiz"/*/delegacao-*; do
    [[ -d "$d" && ! -L "$d" ]] || continue
    if [[ "${d##*/}" == efemera-* ]]; then
      pid="${d##*/efemera-}"
      [[ "$pid" =~ ^[0-9]+$ ]] || continue
      kill -0 "$pid" 2>/dev/null || rm -rf -- "$d"
    else
      [[ "${d##*/}" =~ ^delegacao-([0-9]+)- ]] || continue
      pid="${BASH_REMATCH[1]}"
      kill -0 "$pid" 2>/dev/null || dados_em_uso "${d##*/}" || rm -rf -- "$d"
    fi
  done
}
# Transição de 30/10/2026: diz se a pasta de dados ($1) ainda não existe e a
# sessão já estava registrada numa pasta de sessão em JANGADA_WORKTREES, que
# pertence a uma única sessão. Só então a conversa anterior dela é trazida.
dados_transicao() {
  [[ "$dados_chave" != efemera-* && ! -e "$dados_raiz/$1/$dados_chave" && ! -L "$dados_raiz/$1/$dados_chave" \
     && -f "$JANGADA_ESTADO/agentes/$dados_chave.json" && ! -L "$JANGADA_ESTADO/agentes/$dados_chave.json" \
     && "$pasta" == "$(realpath -m -- "$JANGADA_WORKTREES")"/* ]]
}
dados_abrir() {
  local alvo
  alvo="$(dados_pasta "$1")" || { echo "jangada-isolar: pasta de dados do provedor $1 inválida (link ou fora do estado)" >&2; exit 1; }
  [[ "$dados_chave" != efemera-* ]] || dados_efemeros+=("$alvo")
  dados_alvo="$alvo"
}
((aninhado)) || [[ "$perfil" != agente ]] || ! { concedido claude || concedido agy; } || dados_limpar_mortos

# O Codex precisa gravar bancos, conversas e confiança dos hooks. Dentro do
# bwrap a pasta global aponta para dados próprios da sessão, sem mudar o
# CODEX_HOME nem deixar o agente gravar configurações usadas fora dele.
codex_casa="${CODEX_HOME:-$HOME/.codex}"
codex_sessao="${JANGADA_SESSAO:-}"
# Outra sessão recebe a montagem só com o Codex concedido (executor
# econômico configurado ou JANGADA_ISOLAR_PROVEDORES): assim o chama sem
# precisar criar um isolamento aninhado.
if [[ "$(basename -- "$1")" == jangada-codex ]] \
   || { concedido codex && [[ -n "$codex_sessao" && "$codex_casa" == /* && -d "$codex_casa" ]]; }; then
  [[ "$codex_sessao" =~ ^[A-Za-z0-9_.-]+$ && "$codex_sessao" != . && "$codex_sessao" != .. \
     && -d "$codex_casa" && "$codex_casa" == /* ]] || {
    echo "jangada-isolar: Codex exige uma sessão válida e a pasta de login existente (rode codex login fora do isolamento)" >&2
    exit 1
  }
  codex_estado="$JANGADA_ESTADO/codex"
  [[ ! -L "$codex_estado" && ! -L "$codex_estado/$codex_sessao" ]] || {
    echo "jangada-isolar: link inválido nos dados do Codex" >&2; exit 1
  }
  codex_raiz="$(realpath -m "$codex_estado")"
  codex_alvo="$(realpath -m "$codex_estado/$codex_sessao")"
  [[ "$(dirname "$codex_alvo")" == "$codex_raiz" && "${codex_alvo##*/}" == "$codex_sessao" ]] || {
    echo "jangada-isolar: dados do Codex fora da pasta da sessão" >&2; exit 1
  }
  # A pasta que reúne as sessões fica oculta (lista dos ocultos); só a desta
  # sessão aparece, no lugar do CODEX_HOME.
  (umask 077; mkdir -p "$codex_alvo")
  args+=(--bind "$codex_alvo" "$codex_casa")
  # Somente entradas conhecidas vêm da pasta global. Dados de execução
  # antigos da sessão ficam dentro do isolamento em toda restauração.
  for f in config.toml auth.json AGENTS.md AGENTS.override.md requirements.toml; do
    if [[ -f "$codex_casa/$f" ]]; then
      args+=(--ro-bind "$codex_casa/$f" "$codex_casa/$f")
    else
      args+=(--ro-bind /dev/null "$codex_casa/$f")
    fi
  done
  for f in "$codex_casa"/*.config.toml; do
    [[ -f "$f" ]] && args+=(--ro-bind "$f" "$f")
  done
  for f in skills agents rules hooks plugins; do
    if [[ -d "$codex_casa/$f" ]]; then
      args+=(--ro-bind "$codex_casa/$f" "$codex_casa/$f")
    else
      args+=(--tmpfs "$codex_casa/$f" --remount-ro "$codex_casa/$f")
    fi
  done
  # Um banco redirecionado na configuração não pode misturar sessões.
  args+=(--setenv CODEX_SQLITE_HOME "$codex_casa")
fi

# Claude: o que define comandos que ele roda ou instruções que ele segue, e
# que valeria na próxima sessão aberta fora do isolamento. O que falta é
# criado vazio antes (um bind sobre caminho ausente deixaria no disco um
# arquivo vazio, e um settings.json vazio não é JSON válido).
c="$claude_casa"
for f in settings.json settings.local.json; do
  [[ -e "$c/$f" || -L "$c/$f" ]] || printf '{}\n' 2>/dev/null >"$c/$f" || true
done
[[ -e "$c/CLAUDE.md" || -L "$c/CLAUDE.md" ]] || : 2>/dev/null >>"$c/CLAUDE.md" || true
for d in commands agents skills hooks plugins output-styles; do
  [[ -e "$c/$d" || -L "$c/$d" ]] || mkdir -p "$c/$d" 2>/dev/null || true
done
for p in settings.json settings.local.json CLAUDE.md commands agents skills hooks plugins \
         output-styles backups; do
  somente_leitura "$c/$p"
done
# Scripts soltos na pasta (a linha de status costuma apontar para eles).
for p in "$c"/*; do
  [[ -f "$p" ]] || continue
  case "$p" in
    *.sh|*.bash|*.zsh|*.py|*.js|*.mjs|*.cjs|*.ts|*.rb|*.pl|*.lua) somente_leitura "$p" ;;
    *) [[ -x "$p" ]] && somente_leitura "$p" ;;
  esac
done
# Os retratos do shell e o ambiente das sessões são carregados antes de cada
# comando Bash de toda sessão do Claude, inclusive das abertas fora; o painel
# da IDE diz a qual servidor a sessão de fora se conecta. O agente enxerga
# os de fora, e o que ele grava ali some no fim.
for d in shell-snapshots session-env ide; do
  mkdir -p "$c/$d" 2>/dev/null || true
  temporario "$c/$d"
done
# O CLAUDE_CONFIG_DIR leva junto o .claude.json, que fica somente leitura
# como o ~/.claude.json.
[[ "$c" == "$HOME/.claude" ]] || somente_leitura "$c/.claude.json"
# Conversas, memória (dentro de projects), histórico de prompts e demais
# dados do Claude: cada pasta de primeiro nível que não é configuração, login
# ou temporária vem da pasta da sessão, e o history.jsonl também (ele só
# recebe acréscimos, que um bind de arquivo aceita). As pastas conhecidas são
# criadas antes, para a primeira sessão não gravar nelas a céu aberto. Os
# outros arquivos soltos (contadores, marcas do daemon) seguem compartilhados.
# Um nome novo criado durante a sessão fica na pasta real até a próxima
# abertura, quando passa a ser separado.
dados_claude() {
  local n p
  for n in projects file-history sessions todos plans paste-cache jobs logs agent-memory; do
    [[ -e "$c/$n" || -L "$c/$n" ]] || mkdir -p "$c/$n" 2>/dev/null || true
  done
  for n in projects history.jsonl file-history sessions todos plans agent-memory; do
    [[ ! -L "$c/$n" ]] || {
      echo "jangada-isolar: $c/$n é link; as conversas do Claude não seriam separadas por sessão" >&2
      exit 1
    }
  done
  local novo=0
  dados_transicao claude && novo=1
  dados_abrir claude
  # Transição: uma sessão registrada antes de 30/10/2026 tem a conversa na
  # pasta real, em projects/<pasta da sessão com cada caractere fora de
  # [A-Za-z0-9] trocado por "-">. Na primeira abertura com dados por sessão,
  # só essa pasta é copiada, para o --resume achar a conversa. Nada mais do
  # histórico de fora é copiado.
  if ((novo)); then
    n="${pasta//[^A-Za-z0-9]/-}"
    if ((${#n} <= 200)) && [[ -d "$c/projects/$n" && ! -L "$c/projects/$n" ]]; then
      mkdir -p "$dados_alvo/projects"
      cp -RP -- "$c/projects/$n" "$dados_alvo/projects/$n" || {
        echo "jangada-isolar: falha ao trazer a conversa anterior da sessão $dados_chave" >&2; exit 1;
      }
    fi
  fi
  [[ -e "$c/history.jsonl" || -L "$c/history.jsonl" ]] || (umask 077; : >>"$c/history.jsonl") 2>/dev/null || true
  for p in "$c"/* "$c"/.[!.]* "$c"/..?*; do
    [[ -e "$p" || -L "$p" ]] || continue
    n="${p##*/}"
    case "$n" in
      settings.json | settings.local.json | CLAUDE.md | commands | agents | skills | hooks | plugins \
      | output-styles | backups | .credentials.json | .device-keys.json | .claude.json \
      | .claude.json.backup | shell-snapshots | session-env | ide) continue ;;
    esac
    if [[ -L "$p" ]]; then
      echo "jangada-isolar: $p é link e fica compartilhado entre sessões" >&2
      continue
    fi
    [[ ! -L "$dados_alvo/$n" ]] || { echo "jangada-isolar: link em $dados_alvo/$n" >&2; exit 1; }
    if [[ -d "$p" ]]; then
      mkdir -p "$dados_alvo/$n"
      args+=(--bind "$dados_alvo/$n" "$p")
    elif [[ "$n" == history.jsonl && -f "$p" ]]; then
      [[ -e "$dados_alvo/$n" ]] || (umask 077; : >"$dados_alvo/$n")
      args+=(--bind "$dados_alvo/$n" "$p")
    fi
  done
}
[[ "$perfil" != agente ]] || ((aninhado)) || ! concedido claude || dados_claude
# Clones do AUR, caso JANGADA_ISOLAR_ESCRITA tenha liberado o ~/.cache.
somente_leitura "$HOME/.cache/yay"
somente_leitura "$HOME/.cache/paru"

# Git. Tudo o que ele lê como configuração ou redirecionamento roda fora do
# isolamento no próximo git status: config (core.fsmonitor), hooks,
# commondir (aponta para outro config), gitdir, config.worktree e os
# submódulos em modules/.
if gitdir="$(jangada_git_seguro -C "$pasta" rev-parse --path-format=absolute --absolute-git-dir 2>/dev/null)" \
   && comum="$(jangada_git_seguro -C "$pasta" rev-parse --path-format=absolute --git-common-dir 2>/dev/null)"; then
  raiz="$(jangada_git_seguro -C "$pasta" rev-parse --show-toplevel 2>/dev/null || true)"
  mkdir -p "$comum/hooks" "$comum/logs" "$comum/refs" "$comum/worktrees" "$comum/modules" 2>/dev/null || true
  wt_config=0
  [[ "$(git config --file "$comum/config" --type=bool --get extensions.worktreeConfig 2>/dev/null)" == true ]] && wt_config=1
  if [[ "$gitdir" != "$comum" ]]; then
    # Worktree: o .git comum inteiro fica somente leitura, e só se libera o
    # que add, commit e reset gravam. Assim nenhum arquivo novo (commondir,
    # config.worktree, rebase-merge) aparece no repositório principal. Apagar
    # ramo ou tag e o git gc falham: eles regravam o packed-refs, que fica na
    # raiz.
    somente_leitura "$comum"
    # Com reftable, todas as refs moram numa pasta só: liberar a do ramo do
    # agente liberaria a main, as tags e os ramos das outras sessões.
    if [[ "$(git config --file "$comum/config" --get extensions.refStorage 2>/dev/null)" == reftable \
          || -d "$comum/reftable" ]]; then
      echo "jangada-isolar: $comum guarda as refs em reftable, e o isolamento não separa o ramo do agente das outras refs; recusado." >&2
      echo "Converta com: git -C ${raiz@Q} refs migrate --ref-format=files" >&2
      exit 1
    fi
    for d in objects rr-cache; do
      gravavel "$comum/$d"
    done
    # Das refs, só a pasta do ramo do worktree e a das cópias do "reverter":
    # o git cria o .lock ao lado da ref, então a pasta inteira é o mínimo.
    # main, tags, remotos e o stash do usuário ficam fora do alcance. Um ramo
    # sem prefixo (refs/heads/x) libera refs/heads inteira.
    ramo_ref="$(jangada_git_seguro -C "$pasta" symbolic-ref -q HEAD 2>/dev/null || true)"
    pastas_ref=(refs/heads/backup)
    [[ "$ramo_ref" == refs/heads/* ]] && pastas_ref+=("${ramo_ref%/*}")
    for d in "${pastas_ref[@]}"; do
      mkdir -p "$comum/$d" "$comum/logs/$d" 2>/dev/null || true
      gravavel "$comum/$d"
      gravavel "$comum/logs/$d"
    done
    gravavel "$gitdir"
    ((wt_config)) && { [[ -e "$gitdir/config.worktree" ]] || : 2>/dev/null >>"$gitdir/config.worktree" || true; }
    for f in commondir gitdir config.worktree; do
      somente_leitura "$gitdir/$f"
    done
  else
    # Clone da sessão ou repositório principal (--direto): o HEAD e o index
    # ficam na raiz do .git, que precisa seguir gravável. Um commondir
    # ausente seria criado pelo agente; em seu lugar fica um commondir que
    # aponta para o próprio .git, que o git trata como se não existisse, e
    # ele fica somente leitura.
    gravavel "$comum"
    [[ -e "$comum/commondir" || -L "$comum/commondir" ]] \
      || printf '.\n' 2>/dev/null >"$comum/commondir" || true
    ((wt_config)) && { [[ -e "$comum/config.worktree" ]] || : 2>/dev/null >>"$comum/config.worktree" || true; }
    for f in config hooks commondir config.worktree worktrees modules objects/info/alternates; do
      somente_leitura "$comum/$f"
    done
    # O clone lê os objetos da raiz pelo alternates, que o jangada-agente
    # grava. Cada pasta de objetos citada ali aparece somente leitura, por
    # cima da casa mínima; o agente não grava objeto da base nem de outra
    # sessão. Linha que não é pasta de objetos existente fica de fora, e os
    # ocultos abaixo prevalecem.
    if [[ -f "$comum/objects/info/alternates" ]]; then
      while IFS= read -r alvo || [[ -n "$alvo" ]]; do
        [[ "$alvo" == /*/objects && "$alvo" != *[[:cntrl:]]* ]] || continue
        alvo="$(realpath -e -- "$alvo" 2>/dev/null)" && [[ -d "$alvo" ]] || continue
        args+=(--ro-bind "$alvo" "$alvo")
      done <"$comum/objects/info/alternates"
    fi
  fi
  [[ -f "$raiz/.git" ]] && somente_leitura "$raiz/.git"
fi

if [[ -n "${JANGADA_ISOLAR_OCULTAR+x}" ]]; then
  IFS=: read -ra ocultos <<<"$JANGADA_ISOLAR_OCULTAR"
else
  ocultos=(.ssh .gnupg .password-store .aws .azure .kube .docker .netrc .git-credentials
           .config/gh .config/rclone .config/chromium .config/google-chrome .mozilla
           .config/BraveSoftware .config/vivaldi .config/microsoft-edge .thunderbird
           .config/gcloud .config/op .config/sops .config/Bitwarden .vault-token
           .pgpass .my.cnf .pypirc .local/share/kwalletd
           .local/share/keyrings "${XDG_CACHE_HOME:-$HOME/.cache}/cliphist")
  # O banco do cliphist guarda tudo o que foi copiado, inclusive senhas, e o
  # que o agente gravasse nele o usuário colaria depois pelo SUPER+V. A pasta
  # é criada antes para ficar oculta mesmo numa instalação nova.
  command -v cliphist >/dev/null 2>&1 \
    && { [[ -d "${XDG_CACHE_HOME:-$HOME/.cache}/cliphist" ]] \
         || mkdir -m 0700 "${XDG_CACHE_HOME:-$HOME/.cache}/cliphist" 2>/dev/null || true; }
fi
IFS=: read -ra ocultos_extra <<<"${JANGADA_ISOLAR_OCULTAR_EXTRA:-}"
ocultos+=("${ocultos_extra[@]}")
# Some o login de cada provedor não concedido. Fora do perfil de agente
# ninguém fala com provedor, e somem os três.
concedido claude || ocultos+=("$HOME/.claude" "$claude_casa" "$HOME/.claude.json" "$HOME/.config/claude")
concedido codex || ocultos+=("$codex_casa")
concedido agy || ocultos+=("$HOME/.gemini")
# O token do antigo painel fica oculto sempre, com ou sem a lista acima: sem
# ele, um painel antigo ainda em execução abriria sessão ao agente. A pasta é
# criada antes, para um token gravado depois não aparecer no isolamento.
(umask 077; mkdir -p "$JANGADA_ESTADO/painel-chave" 2>/dev/null) || true
ocultos+=("$JANGADA_ESTADO/painel-chave")
# As revisões feitas fora do isolamento (pareceres, marca de aprovação,
# métricas e a cópia dos metadados de cada sessão) também: o agente não as lê
# nem forja, e o jangada-validar rodado dentro grava na pasta vazia, que some.
(umask 077; mkdir -p "$JANGADA_ESTADO/revisoes" 2>/dev/null) || true
ocultos+=("$JANGADA_ESTADO/revisoes")
# As árvores entregues pelo agente (foto da revisão e cópia em que a suíte da
# integração roda) ficam em pastas próprias, fora de revisoes/: trazem os
# links versionados da entrega, que a conferência de revisoes/ recusa.
# Os dados por sessão dos provedores (Claude, agy e Codex) também: cada
# sessão recebe só a própria pasta, montada no lugar que o cliente usa.
for p in fotos integracoes provedores codex; do
  (umask 077; mkdir -p "$JANGADA_ESTADO/$p" 2>/dev/null) || true
  ocultos+=("$JANGADA_ESTADO/$p")
done
# Do ~/.gemini, com o agy concedido, só a configuração (config, settings,
# conta de instalação) fica visível. Somem as conversas e o histórico do
# gemini-cli e do IDE (antigravity, tmp, history, projects.json) e o login do
# gemini-cli, que o agy não usa.
if concedido agy; then
  for p in antigravity tmp history projects.json oauth_creds.json google_accounts.json; do
    ocultos+=("$HOME/.gemini/$p")
  done
fi
for p in "${ocultos[@]}"; do
  [[ -n "$p" ]] || continue
  [[ "$p" == /* ]] || p="$HOME/$p"
  if [[ -d "$p" ]]; then
    args+=(--tmpfs "$p")
  elif [[ -e "$p" ]]; then
    args+=(--ro-bind /dev/null "$p")
  fi
done

# A fila, políticas, recibos e objetos são autoridade do controlador. Esta
# montagem vem depois dos extras, do cwd e dos ocultos: um extra não a reabre.
somente_leitura "$JANGADA_CORE_PATH"
somente_leitura "$JANGADA_CONFIG"
somente_leitura "$JANGADA_ESTADO/agentes/projetos"
# Só a foto congelada é reexposta ao revisor, nunca recibos ou metadados.
if [[ -n "${JANGADA_ISOLAR_FOTO:-}" ]]; then
  foto_conferida="$(realpath -e "$JANGADA_ISOLAR_FOTO")"
  fotos_conferidas="$(realpath -e "$JANGADA_ESTADO/fotos")"
  [[ "${foto_conferida%/*}" == "$fotos_conferidas" && -d "$foto_conferida" \
     && "$foto_conferida" == "$JANGADA_ISOLAR_FOTO" ]] || {
    echo 'AUTORIZACAO_RECUSADA: foto de revisão fora da pasta protegida' >&2; exit 1;
  }
  somente_leitura "$foto_conferida"
fi
args+=(--ro-bind /dev/null /tmp/.jangada-sem-autoridade)

# Atendente da revisão: numa sessão de agente com cópia protegida em
# revisoes/, um processo aqui fora atende pelo soquete os pedidos do
# jangada-validar de dentro. O pedido é um sha de 40 caracteres
# hexadecimais, numa linha, e a resposta ao parecer anterior, até 8 KiB de
# UTF-8 sem caracteres de controle além da quebra de linha. Os dois vão como
# argumentos, sem shell, a "jangada-validar --atendido", que confere se o sha
# é a cabeça do ramo da sessão e grava em revisoes/. Um pedido por
# vez; o outro recebe OCUPADO. A pasta do soquete entra somente leitura: o
# agente conecta, mas não troca nem apaga o soquete. O atendente sai quando
# este script acaba, e mata a revisão em curso.
atendente_pid=""; atendente_pasta=""
atendente_sessao="${JANGADA_SESSAO:-}"
if ((!mostrar)) && [[ "$perfil" == agente && -z "${JANGADA_ISOLAR_FOTO:-}" ]] \
   && [[ "$atendente_sessao" =~ ^[A-Za-z0-9_.-]+$ && "$atendente_sessao" != . && "$atendente_sessao" != .. ]] \
   && [[ -f "$JANGADA_ESTADO/revisoes/$atendente_sessao.json" && ! -L "$JANGADA_ESTADO/revisoes/$atendente_sessao.json" ]]; then
  if [[ -n "${XDG_RUNTIME_DIR:-}" && -d "$XDG_RUNTIME_DIR" ]] \
     && { [[ -d "$XDG_RUNTIME_DIR/jangada-isolar" ]] || mkdir -m 0700 "$XDG_RUNTIME_DIR/jangada-isolar" 2>/dev/null; }; then
    atendente_pasta="$(mktemp -d "$XDG_RUNTIME_DIR/jangada-isolar/atendente-XXXXXX" 2>/dev/null)" || atendente_pasta=""
  fi
fi
if [[ -n "$atendente_pasta" ]]; then
  exec {atendente_fd}< <(exec env -u JANGADA_ISOLADO python3 -c 'import json, os, re, signal, socket, subprocess, sys, threading, unicodedata
pasta, sessao, validar, pai = sys.argv[1], sys.argv[2], sys.argv[3], int(sys.argv[4])
for nome in os.listdir("/proc/self/fd"):
    if int(nome) > 2:
        try: os.close(int(nome))
        except OSError: pass
caminho = os.path.join(pasta, "soquete")
servidor = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
servidor.bind(caminho)
servidor.listen(8)
servidor.settimeout(1)
revisao = threading.Lock()
conexoes = threading.BoundedSemaphore(8)
filho = []
TETO = 512 * 1024
LIMITE = 41 + 8192

def encerrar(*_):
    for p in filho:
        try: os.killpg(p.pid, signal.SIGTERM)
        except OSError: pass
    for f in (lambda: os.unlink(caminho), lambda: os.rmdir(pasta)):
        try: f()
        except OSError: pass
    os._exit(0)

def enviar(con, texto):
    try: con.sendall(texto.encode())
    except OSError: pass

def atender(con):
    try:
        con.settimeout(5)
        dados = b""
        try:
            while len(dados) <= LIMITE:
                parte = con.recv(LIMITE + 1 - len(dados))
                if not parte: break
                dados += parte
        except OSError:
            return enviar(con, "RECUSADO pedido incompleto em 5 s\n")
        if len(dados) > LIMITE:
            enviar(con, "RECUSADO a resposta passa de 8 KiB\n")
            # Fechar com bytes por ler manda RST, e a recusa se perde no cliente.
            try:
                for _ in range(64):
                    if not con.recv(1024): break
            except OSError:
                pass
            return
        sha, _, resposta = dados.partition(b"\n")
        if not re.fullmatch(rb"[0-9a-f]{40}", sha):
            return enviar(con, "RECUSADO o pedido não é um sha de 40 caracteres hexadecimais\n")
        try:
            resposta = resposta.decode("utf-8")
        except UnicodeDecodeError:
            return enviar(con, "RECUSADO a resposta não é UTF-8 válido\n")
        if any(c != "\n" and unicodedata.category(c) == "Cc" for c in resposta):
            return enviar(con, "RECUSADO a resposta tem caracteres de controle além da quebra de linha\n")
        argumentos = [validar, "--atendido", sha.decode()]
        if resposta.strip():
            argumentos += ["--resposta", resposta]
        if not revisao.acquire(blocking=False):
            return enviar(con, "OCUPADO\n")
        try:
            enviar(con, "ACEITO\n")
            ambiente = dict(os.environ, JANGADA_SESSAO=sessao)
            p = subprocess.Popen(argumentos, stdin=subprocess.DEVNULL,
                                 stdout=subprocess.PIPE, stderr=subprocess.PIPE, env=ambiente, cwd="/",
                                 start_new_session=True)
            filho.append(p)
            saida, erros = p.communicate()
            filho.remove(p)
        finally:
            revisao.release()
        codigo = p.returncode if 0 <= p.returncode <= 255 else 1
        enviar(con, json.dumps({"codigo": codigo, "saida": saida[:TETO].decode("utf-8", "replace"),
                                "erros": erros[-TETO:].decode("utf-8", "replace")}, ensure_ascii=False) + "\n")
    finally:
        con.close()
        conexoes.release()

signal.signal(signal.SIGTERM, encerrar)
signal.signal(signal.SIGHUP, encerrar)
signal.signal(signal.SIGINT, signal.SIG_IGN)
print("pronto", flush=True)
sys.stdout.close()
while os.getppid() == pai:
    try:
        con, _ = servidor.accept()
    except (socket.timeout, InterruptedError):
        continue
    if not conexoes.acquire(blocking=False):
        con.close()
        continue
    threading.Thread(target=atender, args=(con,), daemon=True).start()
encerrar()' "$atendente_pasta" "$atendente_sessao" "$JANGADA_CORE_PATH/bin/jangada-validar" "$$" </dev/null 2>/dev/null)
  atendente_pid=$!
  if read -r -t 5 -u "$atendente_fd" pronto && [[ "$pronto" == pronto && -S "$atendente_pasta/soquete" ]]; then
    args+=(--ro-bind "$atendente_pasta" /tmp/.jangada-atendente
           --setenv JANGADA_VALIDAR_SOQUETE /tmp/.jangada-atendente/soquete)
  else
    echo "jangada-isolar: o atendente da revisão não abriu; o jangada-validar de dentro vai pedir ao coordenador" >&2
    kill "$atendente_pid" 2>/dev/null || true
    rm -rf "$atendente_pasta"
    atendente_pid=""; atendente_pasta=""
  fi
  exec {atendente_fd}<&-
fi

# Ambiente mínimo (padrão): sai toda variável exportada que não está na
# lista. Vai por nome (--unsetenv) e não por --clearenv com --setenv, que poria
# os valores na linha de comando do bwrap e na saída do --mostrar. Em
# qualquer modo, sai o nome que parece credencial (TOKEN, SECRET, PASSWORD,
# SENHA, AUTH, API_KEY...), mesmo nas famílias da lista (LC_*, XDG_*, JANGADA_*,
# MISE_*, NODE_*), e as variáveis de um provedor passam só quando ele é
# concedido. JANGADA_ISOLAR_AMBIENTE_MANTER (nomes separados por ":") traz
# de volta um nome, mas não o de provedor não concedido nem os da lista fixa
# abaixo. JANGADA_ISOLAR_AMBIENTE=herdado mantém o resto, com aviso.
[[ "$ambiente_modo" != herdado ]] \
  || echo "jangada-isolar: JANGADA_ISOLAR_AMBIENTE=herdado: o agente herda o ambiente exportado, menos as variáveis de credencial" >&2
nome_de_credencial() {
  [[ "${1^^}" =~ (TOKEN|SECRET|PASSWORD|PASSWD|PASSPHRASE|CREDENTIAL|(^|_)AUTH(ORIZATION)?(_|$)|API_?KEY|PRIVATE_KEY|ACCESS_KEY|SENHA|(^|_)PAT$) ]]
}
credenciais=()
while IFS= read -r v; do
  dono=""
  case "$v" in
    CLAUDE_* | ANTHROPIC_*) dono=claude ;;
    CODEX_* | OPENAI_*) dono=codex ;;
    GEMINI_* | GOOGLE_* | AGY_* | ANTIGRAVITY_*) dono=agy ;;
  esac
  if [[ -n "$dono" ]]; then
    concedido "$dono" || credenciais+=(--unsetenv "$v")
    continue
  fi
  [[ ":${JANGADA_ISOLAR_AMBIENTE_MANTER:-}:" != *":$v:"* ]] || continue
  if nome_de_credencial "$v"; then
    credenciais+=(--unsetenv "$v")
    continue
  fi
  [[ "$ambiente_modo" == minimo ]] || continue
  case "$v" in
    HOME | USER | LOGNAME | SHELL | PATH | PWD | TERM | COLORTERM | LANG | LANGUAGE | TZ | TMPDIR) continue ;;
    EDITOR | VISUAL | PAGER | NO_COLOR | DBUS_SESSION_BUS_ADDRESS | SSL_CERT_FILE | SSL_CERT_DIR) continue ;;
    HTTP_PROXY | HTTPS_PROXY | NO_PROXY | ALL_PROXY | http_proxy | https_proxy | no_proxy | all_proxy) continue ;;
    R_LIBS | R_LIBS_USER | R_LIBS_SITE | R_PROFILE_USER | R_ENVIRON_USER | R_LINTR_LINTER_FILE) continue ;;
    GIT_AUTHOR_NAME | GIT_AUTHOR_EMAIL | GIT_COMMITTER_NAME | GIT_COMMITTER_EMAIL | GIT_CONFIG_GLOBAL | GIT_CONFIG_NOSYSTEM) continue ;;
    LC_* | XDG_* | JANGADA_* | MISE_* | __MISE_* | NODE_*) continue ;;
  esac
  credenciais+=(--unsetenv "$v")
done < <(compgen -e)
for v in GH_TOKEN GITHUB_TOKEN GH_ENTERPRISE_TOKEN GITLAB_TOKEN AWS_ACCESS_KEY_ID \
         AWS_SECRET_ACCESS_KEY AWS_SESSION_TOKEN AZURE_CLIENT_SECRET RCLONE_CONFIG_PASS \
         VAULT_TOKEN PGPASSWORD MYSQL_PWD OP_SERVICE_ACCOUNT_TOKEN BW_SESSION \
         SOPS_AGE_KEY NPM_TOKEN TWINE_PASSWORD; do
  credenciais+=(--unsetenv "$v")
done
# Um coordenador que é sessão do Claude Code passa CLAUDECODE e CLAUDE_CODE_*
# a quem ele abre: com elas o Claude do agente não grava a conversa, e o par
# socket e token dá acesso à sessão do coordenador. Ficam o login, a escolha
# de provedor e os DISABLE_* que o usuário exporta no perfil do shell.
while IFS= read -r v; do
  case "$v" in
    CLAUDE_CODE_OAUTH_TOKEN | CLAUDE_CODE_USE_* | CLAUDE_CODE_DISABLE_*) ;;
    CLAUDECODE | CLAUDE_CODE_*) credenciais+=(--unsetenv "$v") ;;
  esac
done < <(compgen -e)
# agy: a pasta do CLI inteira vem da pasta da sessão (conversas, cérebro,
# conhecimento, bancos de resumo e histórico), e por cima voltam, da pasta da
# conta, só o login e a configuração. O antigravity-oauth-token é regravado no
# lugar, e um bind do arquivo mantém a renovação valendo fora. O settings.json
# é regravado por rename: a sessão recebe uma cópia nova a cada abertura, e o
# que o agente muda nela não chega à conta. Agentes, embutidos e atualizador
# aparecem como estão, e o que o agente grava neles some no fim. O bin é o
# mesmo de antes: o agy regrava o agentapi antes de cada comando, e sem a
# camada em memória o agente deixaria ali um executável que roda fora.
dados_agy() {
  local origem="$1" destino="$2" f novo=0 id
  dados_transicao "agy-$CONTA_AGY_NOME" && novo=1
  dados_abrir "agy-$CONTA_AGY_NOME"
  # Transição: a conversa anterior da sessão (o id gravado pelo hook) vem da
  # pasta da conta na primeira abertura, para o --conversation achá-la.
  id=""
  ((!novo)) || id="$(jq -r '.conversa // "" | strings' "$JANGADA_ESTADO/agentes/$dados_chave.json" 2>/dev/null)" || id=""
  if [[ "$id" =~ ^[A-Za-z0-9-]{1,80}$ ]]; then
    for f in "conversations/$id.db" "conversations/$id.db-wal" "conversations/$id.db-shm" \
             "brain/$id" "annotations/$id.pbtxt" "implicit/$id.pb"; do
      [[ -e "$origem/$f" && ! -L "$origem/$f" && ! -L "${origem}/${f%/*}" ]] || continue
      mkdir -p "$dados_alvo/${f%/*}"
      cp -RP -- "$origem/$f" "$dados_alvo/$f" || {
        echo "jangada-isolar: falha ao trazer a conversa anterior do agy da sessão $dados_chave" >&2; exit 1;
      }
    done
  fi
  for f in antigravity-oauth-token installation_id settings.json agents builtin updater bin; do
    [[ ! -L "$origem/$f" ]] || { echo "jangada-isolar: $f da conta $CONTA_AGY_NOME é link ($origem/$f)" >&2; exit 1; }
    [[ ! -L "$dados_alvo/$f" ]] || { echo "jangada-isolar: link em $dados_alvo/$f" >&2; exit 1; }
  done
  args+=(--bind "$dados_alvo" "$destino")
  [[ ! -f "$origem/antigravity-oauth-token" ]] \
    || args+=(--bind "$origem/antigravity-oauth-token" "$destino/antigravity-oauth-token")
  [[ ! -f "$origem/installation_id" ]] \
    || args+=(--ro-bind "$origem/installation_id" "$destino/installation_id")
  if [[ -f "$origem/settings.json" ]]; then
    rm -f -- "$dados_alvo/settings.json"
    (umask 077; cp -- "$origem/settings.json" "$dados_alvo/settings.json")
  fi
  for f in agents builtin updater; do
    [[ ! -d "$origem/$f" ]] || { mkdir -p "$dados_alvo/$f"; temporario "$origem/$f" ro "$destino/$f"; }
  done
  mkdir -p "$origem/bin" "$dados_alvo/bin" 2>/dev/null || true
  temporario "$origem/bin" ro "$destino/bin"
}
if ((conta_configurada)); then
  if [[ "$perfil" == agente ]] && concedido agy && [[ ! -d "$CONTA_AGY_PASTA" ]]; then
    echo "jangada-isolar: pasta da conta $CONTA_AGY_NOME indisponível" >&2; exit 1
  fi
  # Estas montagens vêm depois de qualquer liberação extra de escrita ou leitura.
  while IFS=$'\t' read -r _nome conta_pasta _argon; do
    [[ ! -d "$conta_pasta" ]] || args+=(--tmpfs "$conta_pasta")
  done <<<"$contas_agy"
  args+=(--tmpfs "$cli_agy")
  args+=(--ro-bind "$JANGADA_ESTADO/contas/agy.json" "$JANGADA_ESTADO/contas/agy.json")
  if [[ "$perfil" == agente ]] && concedido agy; then
    args+=(--setenv JANGADA_AGY_CONTA "$CONTA_AGY_NOME"
           --setenv JANGADA_AGY_CONTA_MONTADA "$CONTA_AGY_NOME"
           --setenv JANGADA_AGY_PASTA "$cli_agy"
           --setenv JANGADA_AGY_SETTINGS "$cli_agy/settings.json")
    dados_agy "$CONTA_AGY_PASTA" "$cli_agy"
  fi
elif [[ "$perfil" == agente ]] && concedido agy && [[ -d "$CONTA_AGY_PASTA" ]]; then
  dados_agy "$CONTA_AGY_PASTA" "$CONTA_AGY_PASTA"
fi
args+=(--unsetenv TMUX --unsetenv TMUX_PANE --unsetenv SSH_AUTH_SOCK
       --unsetenv HYPRLAND_INSTANCE_SIGNATURE --unsetenv HYPRLAND_CMD
       --unsetenv WAYLAND_DISPLAY --unsetenv DISPLAY --unsetenv GPG_AGENT_INFO
       "${credenciais[@]}"
       --setenv JANGADA_ISOLAR_CONCEDIDOS "$concedidos_lista"
       --setenv JANGADA_ISOLADO 1 --chdir "$pasta" -- env "--default-signal=INT,QUIT" "$@")

if ((mostrar)); then
  printf '%s\n' bwrap "${args[@]}"
  ((!${#dados_efemeros[@]})) || rm -rf -- "${dados_efemeros[@]}"
  exit 0
fi


# As armadilhas vêm antes dos processos auxiliares: um sinal na partida
# mataria o script e deixaria o monitor e o inotifywait órfãos.
monitor_pid=""
monitor_estado_pid=""
limpar_monitor() {
  if [[ -n "$atendente_pid" ]]; then
    kill "$atendente_pid" 2>/dev/null || true
    atendente_pid=""
  fi
  [[ -z "$atendente_pasta" ]] || rm -rf "$atendente_pasta"
  # Dados efêmeros dos provedores: só depois que o bwrap saiu.
  if ((${#dados_efemeros[@]})) && { [[ -z "$bwrap_pid" ]] || ! kill -0 "$bwrap_pid" 2>/dev/null; }; then
    rm -rf -- "${dados_efemeros[@]}"
    dados_efemeros=()
  fi
  if [[ -n "$monitor_estado_pid" ]]; then
    kill "$monitor_estado_pid" 2>/dev/null || true
    wait "$monitor_estado_pid" 2>/dev/null || true
  fi
  if [[ -n "$monitor_pid" ]]; then
    kill "$monitor_pid" 2>/dev/null || true
    pkill -P "$monitor_pid" 2>/dev/null || true
    wait "$monitor_pid" 2>/dev/null || true
  fi
}

bwrap_pid=""
repasse_sinal() {
  local s="$1"
  if [[ -n "$bwrap_pid" ]]; then
    kill "-$s" "$bwrap_pid" 2>/dev/null || true
  fi
}

trap 'limpar_monitor' EXIT
trap 'repasse_sinal TERM; wait "$bwrap_pid" 2>/dev/null || true; limpar_monitor; exit 143' TERM
trap 'repasse_sinal HUP; wait "$bwrap_pid" 2>/dev/null || true; limpar_monitor; exit 129' HUP
trap '' INT

set +m
intervalo_monitor="${JANGADA_MONITOR_INTERVALO:-30}"
(
  sub_pid="$BASHPID"
  sleep_pid=""
  matar_filhos() {
    [[ -n "$sleep_pid" ]] && kill "$sleep_pid" 2>/dev/null || true
    pkill -P "$sub_pid" 2>/dev/null || true
  }
  trap 'matar_filhos; wait 2>/dev/null || true; exit 0' TERM INT EXIT
  while kill -0 $$ 2>/dev/null; do
    sleep "$intervalo_monitor" &
    sleep_pid=$!
    wait "$sleep_pid" 2>/dev/null || true
    kill -0 $$ 2>/dev/null || exit 0
    atualizar_marcas_host
  done
) 2>/dev/null &
monitor_pid=$!

# O hook isolado não enxerga a Waybar no namespace de PID do host.
# Observe somente o nome conferido da sessão; nenhum conteúdo dela é executado.
if [[ "$codex_sessao" =~ ^[A-Za-z0-9_.-]+$ && "$codex_sessao" != . && "$codex_sessao" != .. ]] \
   && command -v inotifywait >/dev/null 2>&1; then
  (
    exec {eventos_fd}< <(exec inotifywait -m -q -e moved_to,close_write,create,delete \
      --format '%f' "$JANGADA_ESTADO/agentes")
    vigia_pid=$!
    trap 'kill "$vigia_pid" 2>/dev/null || true; wait "$vigia_pid" 2>/dev/null || true' EXIT
    trap 'exit 0' TERM INT
    # Morto por KILL, o script não limpa nada: o vigia confere o pai a cada
    # espera vencida e sai sozinho.
    while kill -0 $$ 2>/dev/null; do
      IFS= read -r -t "$intervalo_monitor" arquivo <&"$eventos_fd" || { (($? > 128)) && continue; break; }
      [[ "$arquivo" == "$codex_sessao.json" ]] || continue
      jangada_avisar_interface estado-sessao
    done
  ) 2>/dev/null &
  monitor_estado_pid=$!
fi

# Bubblewrap preserva descritores extras herdados: uma montagem ro não
# revoga um banco já aberto. Feche todos, exceto o cano do proxy criado aqui.
python3 -c 'import os,sys
permitido = int(sys.argv[1]) if sys.argv[1] else -1
for nome in os.listdir("/proc/self/fd"):
    fd = int(nome)
    if fd > 2 and fd != permitido:
        try: os.close(fd)
        except OSError: pass
os.execvp("bwrap", ["bwrap", *sys.argv[2:]])' "$dbus_sinc" "${args[@]}" <&0 &
bwrap_pid=$!

while :; do
  codigo=0
  wait "$bwrap_pid" 2>/dev/null || codigo=$?
  kill -0 "$bwrap_pid" 2>/dev/null || break
done
if ((codigo && !aninhado)); then
  env -u JANGADA_ISOLADO \
    python3 "$JANGADA_CORE_PATH/orquestracao/confianca.py" registrar-falha "$JANGADA_ESTADO" "$codigo" \
    || echo "falha ao registrar execução isolada malsucedida" >&2
fi
exit "$codigo"
