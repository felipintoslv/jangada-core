#!/usr/bin/env bash
# Atualiza o código do jangada-core na cópia instalada e aplica as migrações.
#
# Ordem: busca do repositório (aplicada só com a sua confirmação), conferência
# das assinaturas, avanço por fast-forward e migrações. Depois, se existir o
# jangada-sistema-update (do jangada-shell), roda a atualização do sistema; a
# opção --so-core pula essa etapa.
#
# A cópia instalada acompanha o ramo JANGADA_CANAL (main ou estavel).
set -euo pipefail
# shellcheck source=bin/jangada-config
source "$(dirname "${BASH_SOURCE[0]}")/jangada-config"

so_core=0
case "${1:-}" in
  "") ;;
  --so-core) so_core=1; shift ;;
  --ajuda|--help|-h)
    printf '%s\n' 'Uso: jangada-update [--so-core]' \
      'Atualiza o código do Core e aplica as migrações. Sem --so-core, roda depois o jangada-sistema-update, se existir.'
    exit 0 ;;
  *) echo "opção desconhecida: $1" >&2; exit 1 ;;
esac
(($# == 0)) || { echo "argumentos excedentes" >&2; exit 1; }
[[ "${JANGADA_SIMULAR:-0}" != 1 ]] || {
  echo "jangada-update não oferece simulação; use JANGADA_SIMULAR=1 jangada-migrar para conferir migrações" >&2
  exit 1
}

if [[ -n "${JANGADA_ISOLADO:-}" ]] || mountpoint -q /tmp/.jangada-isolado \
    || mountpoint -q /tmp/.jangada-sem-autoridade; then
  echo "atualização exige terminal externo ao agente isolado" >&2
  exit 1
fi
# Sessões de agente e processos que usam a instalação impedem só o avanço do
# código, que trocaria arquivos sob eles; o sistema ainda pode ser atualizado.
bloqueio=""
if ! sessoes="$("${JANGADA_TMUX[@]}" list-sessions -F '#{session_name}' 2>&1)"; then
  case "$sessoes" in
    'no server running on '*|'error connecting to '*' (No such file or directory)'|'no sessions') sessoes="" ;;
    *) bloqueio="não foi possível conferir as sessões de agentes" ;;
  esac
fi
if [[ -z "$bloqueio" && -n "$sessoes" ]]; then
  bloqueio="há sessões de agentes abertas: $(printf '%s' "$sessoes" | tr -d '\000-\010\013-\037\177' | tr '\n' ' ')"
fi
if [[ -z "$bloqueio" ]]; then
  processos="$(ps -eo pid=,args= | awk -v pasta="$JANGADA_CORE_PATH/" '
    index($0, pasta "nucleo/") || index($0, pasta "orquestracao/") ||
    index($0, pasta "delegacao/") || index($0, pasta "provedores/") ||
    index($0, pasta "validacao/") || index($0, pasta "agentes/") ||
    (index($0, pasta "bin/jangada-") && !index($0, pasta "bin/jangada-update")) {print $1}' | tr '\n' ' ')"
  [[ -z "${processos// /}" ]] || bloqueio="há processos usando a instalação (PID: $processos)"
fi

# O git roda fora do isolamento sobre a cópia instalada: sem fsmonitor nem
# ganchos, que viriam da configuração do repositório.
g() { jangada_git_seguro -C "$JANGADA_CORE_PATH" "$@"; }

# Com ~/.config/jangada/allowed_signers, todo commit de $1 até $2 precisa de
# assinatura válida por esse arquivo; o jangada-assinar assina, fora do
# isolamento, os commits que os agentes fizeram. O arquivo fica fora da cópia
# de trabalho e somente leitura no isolamento, então um agente não põe nele
# uma chave própria. O programa de verificação é fixo, porque o
# gpg.ssh.program da configuração do repositório rodaria aqui.
assinantes="$JANGADA_CONFIG/allowed_signers"
assinaturas_ok() {
  local de="$1" ate="$2" faltam
  [[ -f "$assinantes" ]] || return 0
  faltam="$(g -c gpg.ssh.allowedSignersFile="$assinantes" -c gpg.ssh.program=ssh-keygen \
    log --format='%G? %h %s' "$de..$ate" | grep -v '^G ' | tr -d '\000-\010\013-\037\177')" || true
  [[ -z "$faltam" ]] && return 0
  echo "!! commits sem assinatura válida por $assinantes (rode jangada-assinar na cópia de trabalho):"
  printf '%s\n' "$faltam" | sed 's/^/   /'
  return 1
}

# Mostra os commits de $1 até $2 e pede confirmação. A origem da cópia
# instalada é a cópia de trabalho, cujas refs um agente isolado pode gravar:
# nada que chega por ela roda (jangada-versao, migrações com sudo ainda
# autenticado, ganchos) sem que você veja e aceite. Os assuntos e nomes passam
# por um filtro de caracteres de controle, para que uma sequência de escape
# não apague nem disfarce a lista. Sem terminal, a resposta é não.
confirmar_novidades() {
  local de="$1" ate="$2" sensiveis r=""
  assinaturas_ok "$de" "$ate" || return 1
  echo "commits novos na origem:"
  g log --oneline "$de..$ate" | tr -d '\000-\010\013-\037\177' | sed 's/^/   /'
  g diff --no-ext-diff --no-textconv --stat "$de..$ate" | tr -d '\000-\010\013-\037\177' | sed 's/^/   /'
  sensiveis="$(g diff --no-ext-diff --no-textconv --name-only "$de..$ate" -- migrations install bin | tr -d '\000-\010\013-\037\177')"
  if [[ -n "$sensiveis" ]]; then
    echo "!! mudam código que roda fora do isolamento (migrations/, install/, bin/):"
    printf '%s\n' "$sensiveis" | sed 's/^/   /'
  fi
  read -r -p "aplicar estas mudanças do jangada? [s/N] " r || r=""
  [[ "${r,,}" == s* ]]
}

# Opções do avanço da cópia instalada. As assinaturas são conferidas commit a
# commit em assinaturas_ok; o --verify-signatures do merge só olharia o último.
opcoes_merge=(--ff-only --quiet)

codigo_ok=1
echo "==> repositório jangada (canal $JANGADA_CANAL)"
if [[ -n "$bloqueio" ]]; then
  codigo_ok=0
  echo "!! $bloqueio; o código do Core não foi atualizado (encerre-as e rode jangada-update --so-core)" >&2
elif estado="$(g status --porcelain --ignore-submodules=all 2>&1)" && [[ -z "$estado" ]]; then
  # Só busca: nada chega à cópia instalada antes da confirmação abaixo.
  if ! g fetch --quiet origin; then
    echo "!! não consegui buscar o repositório de origem"
  fi
  ramo_atual="$(g rev-parse --abbrev-ref HEAD 2>/dev/null || true)"
  if [[ "$ramo_atual" != "$JANGADA_CANAL" ]]; then
    if g show-ref --verify --quiet "refs/heads/$JANGADA_CANAL"; then
      g switch --quiet "$JANGADA_CANAL"
    elif g show-ref --verify --quiet "refs/remotes/origin/$JANGADA_CANAL"; then
      # O ramo novo nasce no ponto da origem: passa pela mesma confirmação.
      if confirmar_novidades HEAD "refs/remotes/origin/$JANGADA_CANAL"; then
        g switch --quiet --track "origin/$JANGADA_CANAL"
      else
        echo "!! troca para o canal $JANGADA_CANAL não aplicada; a cópia segue em $ramo_atual"
      fi
    else
      echo "!! o canal $JANGADA_CANAL não existe na origem; a cópia segue em $ramo_atual"
    fi
  fi
  antes="$(g rev-parse HEAD)"
  novo="$(g rev-parse --verify --quiet '@{upstream}^{commit}' 2>/dev/null || true)"
  if [[ -z "$novo" ]]; then
    codigo_ok=0
    echo "!! o ramo $(g rev-parse --abbrev-ref HEAD 2>/dev/null || echo "$ramo_atual") não acompanha um ramo da origem; nada a aplicar"
  elif [[ "$novo" == "$antes" ]] || g merge-base --is-ancestor "$novo" "$antes"; then
    echo "jangada já atualizado"
  elif ! g merge-base --is-ancestor "$antes" "$novo"; then
    codigo_ok=0
    echo "!! a origem não avança em linha reta a partir da cópia instalada; nada aplicado"
  elif confirmar_novidades "$antes" "$novo"; then
    if ! g merge "${opcoes_merge[@]}" "$novo"; then
      codigo_ok=0
      echo "!! não foi possível atualizar o repositório"
    fi
  else
    codigo_ok=0
    echo "!! mudanças do jangada não aplicadas"
  fi
  # O que chegou, nos grupos do CHANGELOG.md.
  if [[ "$(g rev-parse HEAD)" != "$antes" ]]; then
    echo "jangada agora em $("$JANGADA_CORE_PATH/bin/jangada-versao" -C "$JANGADA_CORE_PATH")"
    "$JANGADA_CORE_PATH/bin/jangada-versao" -C "$JANGADA_CORE_PATH" --novidades "$antes" HEAD \
      | tr -d '\000-\010\013-\037\177' | sed 's/^/   /' || true
  fi
else
  codigo_ok=0
  if [[ -n "${estado:-}" ]]; then
    echo "!! o repositório em $JANGADA_CORE_PATH não está limpo ou reportou erro; a cópia instalada não foi atualizada:"
    printf '%s\n' "$estado" | sed 's/^/   /'
  else
    echo "!! há alterações locais em $JANGADA_CORE_PATH; a cópia instalada não foi atualizada"
  fi
fi


if ((codigo_ok)); then
  echo "==> migrações"
  "$JANGADA_CORE_PATH/bin/jangada-migrar" || { codigo_ok=0; echo "!! migrações não aplicadas; corrija e rode jangada-migrar de novo"; }
fi

rc=0
((codigo_ok)) || rc=1
if ((so_core)); then
  exit "$rc"
fi
# A atualização do sistema (pacotes, snapshots, recarga) é do jangada-shell.
if command -v jangada-sistema-update >/dev/null 2>&1; then
  echo "==> sistema (jangada-sistema-update)"
  rc_sistema=0
  jangada-sistema-update || rc_sistema=$?
  ((rc_sistema == 0)) || exit "$rc_sistema"
fi
exit "$rc"
