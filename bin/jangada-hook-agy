#!/usr/bin/env bash
# Hook do Antigravity (agy): registra o estado da sessão do jangada, como o
# jangada-hook-claude faz para o Claude Code. Nunca falha e sempre responde
# "{}" na saída padrão, que é o que o agy espera.
#
# Uso (configurado em ~/.gemini/config/hooks.json):
#   jangada-hook-agy trabalhando|concluido
# Recebe o JSON do evento pela entrada padrão.
#
# Só age dentro de uma sessão do jangada (JANGADA_SESSAO). O agy não tem
# evento de pedido de permissão, então o estado "aguardando" não aparece: um
# agy parado numa pergunta continua como "trabalhando".

# A resposta vai antes de tudo: o bloco abaixo sai cedo com exit, e um hook do
# agy sem JSON na saída pode ser tratado como recusa.
echo '{}'
{
  evento="${1:-}"
  entrada="$(cat 2>/dev/null || true)"
  [[ -n "${JANGADA_SESSAO:-}" && -z "${JANGADA_HOOK_DESLIGADO:-}" ]] || exit 0
  dir_bin="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
  # shellcheck source=bin/jangada-config
  source "$dir_bin/jangada-config"

  arq="$JANGADA_ESTADO/agentes/$JANGADA_SESSAO.json"
  # Sem o arquivo, a sessão não foi aberta pelo jangada-agente (ou já foi
  # encerrada); não cria um estado solto.
  [[ -f "$arq" ]] || exit 0

  conversa="$(jq -r '.conversationId // ""' <<<"$entrada" 2>/dev/null || true)"
  case "$evento" in
    trabalhando)
      mensagem=""
      ;;
    concluido)
      # O Stop dispara no fim de cada turno. fullyIdle falso quer dizer que o
      # agy ainda tem trabalho em segundo plano; aí nada muda. Não use
      # ".fullyIdle // true": no jq, false // true dá true.
      [[ "$(jq -r 'if .fullyIdle == false then "false" else "true" end' <<<"$entrada" 2>/dev/null)" == false ]] && exit 0
      erro="$(jq -r '.error // ""' <<<"$entrada" 2>/dev/null || true)"
      mensagem="${erro:+erro: ${erro:0:100}}"
      mensagem="${mensagem:-turno concluído}"
      ;;
    *) exit 0 ;;
  esac

  tmp="$(mktemp "$arq.XXXXXX")"
  atualizar() {
    local anterior projeto
    anterior="$(jq -r '.estado // ""' "$arq" 2>/dev/null || true)"
    projeto="$(jq -r '(.raiz // .dir // "") | split("/") | last // ""' "$arq" 2>/dev/null || true)"
    # shellcheck disable=SC2016  # $e, $m, $a e $c são variáveis do jq
    jq --arg e "$evento" --arg m "$mensagem" --arg a "$(jangada_data_iso)" --arg c "$conversa" '
      (if $c != "" then .conversa = $c else . end)
      | .estado = $e | .atualizado = $a
      | (if $m != "" then .mensagem = $m else . end)
    ' "$arq" >"$tmp" 2>/dev/null && mv "$tmp" "$arq" || return 1
    # Histórico para o painel, só na mudança de estado.
    if [[ "$evento" != "$anterior" ]]; then
      jangada_registrar_evento "$JANGADA_SESSAO" \
        "${projeto:-$(basename "$arq" .json)}" agy "$evento"
    fi
  }
  if jangada_com_trava_dir "$(dirname "$arq")" atualizar; then
    jangada_avisar_interface estado-sessao
  fi
  rm -f "$tmp"

  # Dentro do jangada-isolar o tmux fica fora de alcance, e a notificação vai
  # sem o botão.
  if [[ "$evento" == concluido ]]; then
    if [[ -n "${JANGADA_ISOLADO:-}" ]]; then
      jangada_notificar -a jangada-agente -u normal "Agente concluiu: $JANGADA_SESSAO" "$mensagem"
    else
      # O bash de dentro recebe a função pelo ambiente.
      export -f jangada_notificar
      # shellcheck disable=SC2016  # expandido pelo bash de dentro
      setsid -f bash -c '
        r="$(jangada_notificar -a jangada-agente -u normal -A abrir=Abrir "$1" "$2")"
        [[ "$r" == "abrir" ]] && "$3/jangada-agentes" --focar "$4"
      ' _ "Agente concluiu: $JANGADA_SESSAO" "$mensagem" "$dir_bin" "$JANGADA_SESSAO" >/dev/null 2>&1
    fi
  fi
} >/dev/null 2>&1
exit 0
