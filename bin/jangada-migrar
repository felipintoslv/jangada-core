#!/usr/bin/env bash
# Aplica, em ordem, as migrações de migrations/ ainda não aplicadas.
# Cada migração é um script bash; se falhar, as seguintes não rodam.
set -euo pipefail
# shellcheck source=bin/jangada-config
source "$(dirname "${BASH_SOURCE[0]}")/jangada-config"

JANGADA_SIMULAR="${JANGADA_SIMULAR:-0}"
feitas="$JANGADA_ESTADO/migracoes"
mkdir -p "$feitas"
if command -v flock >/dev/null 2>&1; then
  exec 9<"$feitas"
  flock -w 60 9 || { echo "outra migração em andamento" >&2; exit 1; }
fi
n=0
for m in "$JANGADA_CORE_PATH"/migrations/*.sh; do
  [[ -e "$m" ]] || continue
  nome="$(basename "$m")"
  [[ -e "$feitas/$nome" ]] && continue
  echo "==> migração $nome"
  if bash "$m"; then
    # Em simulação a marca não é gravada. Gravar faria a execução seguinte, a
    # de verdade, pular uma migração que nunca chegou a ser aplicada.
    [[ "$JANGADA_SIMULAR" == "1" ]] || touch "$feitas/$nome"
    n=$((n + 1))
  else
    echo "migração $nome falhou; corrija e rode jangada-migrar de novo" >&2
    exit 1
  fi
done
if [[ "$JANGADA_SIMULAR" == "1" ]]; then
  echo "migrações que seriam aplicadas: $n"
else
  echo "migrações aplicadas: $n"
fi
