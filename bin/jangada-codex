#!/usr/bin/env bash
# Adaptador do Codex: protocolo, hooks da sessão e execução sem servidor compartilhado.
# Uso: jangada-codex [--revisar | --protocolo ARQ] [--conversa UUID | --retomar] -- COMANDO [ARGS...]
set -euo pipefail
# shellcheck source=bin/jangada-config
source "$(dirname "${BASH_SOURCE[0]}")/jangada-config"

protocolo=""; conversa=""; retomar=0; revisar=0
while (($#)); do
  case "$1" in
    --protocolo) protocolo="$2"; shift 2 ;;
    --conversa) conversa="$2"; shift 2 ;;
    --retomar) retomar=1; shift ;;
    --revisar) revisar=1; shift ;;
    --) shift; break ;;
    *) echo "jangada-codex: opção desconhecida: $1" >&2; exit 1 ;;
  esac
done
(($#)) || { echo "jangada-codex: informe o comando codex" >&2; exit 1; }
exe="$1"; shift
[[ "$(basename -- "$exe")" == codex ]] || { echo "jangada-codex: comando inválido" >&2; exit 1; }
if ! { [[ -n "${JANGADA_ISOLADO:-}" ]] && awk -v m="${JANGADA_MARCA_ISOLADO:-/tmp/.jangada-isolado}" \
  '$5 == m { a = 1 } END { exit !a }' /proc/self/mountinfo; }; then
  echo "jangada-codex: o Codex precisa do jangada-isolar, inclusive com --sem-isolar" >&2
  exit 1
fi
if [[ -n "$conversa" && ! "$conversa" =~ ^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$ ]]; then
  echo "jangada-codex: id de conversa inválido" >&2
  exit 1
fi
# Versões sem --no-daemon poderiam conectar a um processo fora do isolamento.
ajuda="$("$exe" --help 2>/dev/null)" || exit 1
grep -q -- '--no-daemon' <<<"$ajuda" || {
  echo "jangada-codex: esta versão precisa oferecer --no-daemon; atualize o Codex" >&2
  exit 1
}

if ((revisar)); then
  # Chamado pelo jangada-validar no isolamento, com o pedido completo.
  exec env -u JANGADA_SESSAO JANGADA_HOOK_DESLIGADO=1 "$exe" \
    --no-daemon --ask-for-approval never exec --ignore-user-config --ignore-rules \
    --ephemeral --skip-git-repo-check --sandbox read-only \
    --disable shell_tool --disable unified_exec --disable multi_agent \
    --disable code_mode --disable code_mode_host --disable plugins --disable apps \
    --disable hooks --disable browser_use --disable computer_use --disable in_app_browser \
    --disable image_generation --disable view_image --disable skill_mcp_dependency_install \
    -c 'hooks={}' -c 'mcp_servers={}' -c 'plugins={}' -c 'web_search="disabled"' \
    -c "log_dir=$(jq -Rn --arg p "${CODEX_HOME:-$HOME/.codex}/log" '$p')" "$@" -
fi

# O config.toml fica somente leitura. A escolha de confiança pertence à
# sessão e entra na configuração da chamada, sem liberar o arquivo global.
casa_codex="${CODEX_HOME:-$HOME/.codex}"
pasta_codex="$(jangada_git_seguro rev-parse --show-toplevel 2>/dev/null || pwd -P)"
pasta_codex="$(realpath "$pasta_codex")"
confianca="$casa_codex/jangada-confianca.json"
confia=0
if python3 - "$casa_codex/config.toml" "$pasta_codex" <<'PY'
import sys, tomllib
try:
    with open(sys.argv[1], "rb") as f:
        cfg = tomllib.load(f)
    trusted = cfg.get("projects", {}).get(sys.argv[2], {}).get("trust_level") == "trusted"
except (OSError, ValueError):
    trusted = False
sys.exit(0 if trusted else 1)
PY
then
  confia=1
elif jq -e --arg p "$pasta_codex" '.pasta == $p and .confiavel == true' "$confianca" >/dev/null 2>&1; then
  confia=1
fi
if ((!confia)); then
  [[ -t 0 && -t 1 ]] || {
    echo "jangada-codex: abra a sessão num terminal para confirmar a confiança da pasta" >&2
    exit 1
  }
  printf 'Pasta do Codex: %q\n' "$pasta_codex"
  echo 'A configuração da pasta pode executar código automaticamente dentro do isolamento.'
  read -r -p 'Confia nesta pasta e deseja continuar? [s/N] ' resposta || exit 1
  [[ "${resposta,,}" == s ]] || exit 1
  (umask 077
    tmp_confianca="$(mktemp "$casa_codex/.jangada-confianca.XXXXXX")"
    trap 'rm -f "$tmp_confianca"' EXIT
    jq -n --arg p "$pasta_codex" '{pasta: $p, confiavel: true}' >"$tmp_confianca"
    mv -f "$tmp_confianca" "$confianca"
  )
fi
chave_pasta="$(jq -Rn --arg p "$pasta_codex" '$p')"

# Raiz gravável extra: só a pasta das sessões. A proteção interna do Codex
# cria pontos de montagem (.git, .codex, .agents) dentro de cada raiz, e a
# raiz do estado é somente leitura no isolamento: com ela todo comando falha.
# Os arquivos graváveis do estado não entram: o Codex só aceita pasta.
args=("$@" --no-daemon --sandbox workspace-write --ask-for-approval on-request
      -c "projects={$chave_pasta={trust_level=\"trusted\"}}"
      --add-dir "$JANGADA_ESTADO/agentes" -c 'approvals_reviewer="user"'
      -c "log_dir=$(jq -Rn --arg p "${CODEX_HOME:-$HOME/.codex}/log" '$p')")
if [[ -n "$protocolo" ]]; then
  [[ -r "$protocolo" ]] || { echo "jangada-codex: protocolo ausente" >&2; exit 1; }
  args+=(-c "developer_instructions=$(jq -Rs . <"$protocolo")")
fi
# TOML usa '=' nas tabelas em linha. A string JSON também é uma string TOML
# válida; a citação de shell fica dentro dela, sem avaliar o caminho.
# Caminho da fachada, sem resolver link: o hook carrega o jangada-config que
# fica ao lado dele em bin/.
hook="$JANGADA_CORE_PATH/bin/jangada-hook-codex"
hook="'${hook//\'/\'\\\'\'}'"
args_hooks=()
for par in SessionStart:inicio UserPromptSubmit:trabalhando PreToolUse:trabalhando \
           PostToolUse:trabalhando PermissionRequest:aguardando Stop:concluido \
           SessionEnd:fim Interrupt:concluido; do
  evento="${par%%:*}"; estado="${par#*:}"
  comando="$(jq -Rn --arg c "$hook $estado" '$c')"
  args_hooks+=(-c "hooks.$evento=[{hooks=[{type=\"command\",command=$comando}]}]")
done
estado_hooks="$(bash "$(dirname "${BASH_SOURCE[0]}")/jangada-codex-hooks" "$exe" \
  "$casa_codex/jangada-hooks-confianca.json" "${args_hooks[@]}")"
args+=("${args_hooks[@]}" -c "$estado_hooks")
if [[ -n "$conversa" ]]; then
  args+=(resume "$conversa")
elif ((retomar)); then
  args+=(resume --last)
fi
exec "$exe" "${args[@]}"
