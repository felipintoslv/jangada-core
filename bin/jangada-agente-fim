#!/usr/bin/env bash
# Encerra uma sessão de agente e remove o worktree, conferindo alterações pendentes.
# O ramo agente/<nome> é mantido; apague-o com git branch -d quando quiser.
# Com --integrar, avança a base até o commit do ramo (merge --ff-only na cópia
# principal) e para: não encerra a sessão, não remove worktree nem ramo, não
# envia ao remoto e não atualiza a cópia instalada. Exige, nesta ordem:
# - cópia principal no ramo base e sem alteração em arquivo rastreado;
# - ramo à frente da base; se a base andou, faz o rebase na worktree da
#   tarefa e recusa, porque o commit novo precisa de parecer próprio;
# - parecer APROVADO de revisão independente, gravado fora do isolamento em
#   ~/.local/state/jangada/revisoes para o commit exato; --sem-revisao recusa;
# - confirmação no terminal, ou --confirmacao BASE CANDIDATO vinda da Central;
# - testes/verificar.sh com saída 0 numa cópia protegida do commit.
# Uso: jangada-agente-fim [--integrar [--sem-revisao]] SESSAO
set -euo pipefail
# shellcheck source=bin/jangada-config
source "$(dirname "${BASH_SOURCE[0]}")/jangada-config"

integrar=0; sem_revisao=0; s=""; gui_base=""; gui_candidato=""
while (($#)); do
  case "$1" in
    -h|--ajuda) sed -n '2,15s/^# \{0,1\}//p' "$0"; exit 0 ;;
    --integrar) integrar=1; shift ;;
    --confirmacao) gui_base="${2:-}"; gui_candidato="${3:-}"; shift 3 ;;
    --sem-revisao) sem_revisao=1; shift ;;
    -*) echo "opção desconhecida: $1" >&2; exit 1 ;;
    *) [[ -z "$s" ]] || { echo "sessão repetida: $1" >&2; exit 1; }; s="$1"; shift ;;
  esac
done
if [[ -n "$gui_base$gui_candidato" ]]; then
  [[ "$gui_base" =~ ^[0-9a-f]{40}$ && "$gui_candidato" =~ ^[0-9a-f]{40}$ ]] \
    && ((integrar && !sem_revisao)) || { echo "confirmação gráfica exige --integrar, dois SHA completos e revisão" >&2; exit 1; }
fi
[[ -n "$s" ]] || { echo "informe a sessão (veja jangada-agentes --lista)" >&2; exit 1; }
[[ "$s" =~ ^[A-Za-z0-9_.-]+$ ]] || { echo "nome de sessão inválido: $s" >&2; exit 1; }
arq="$JANGADA_ESTADO/agentes/$s.json"

# Sem arquivo de estado e sem sessão no tmux não há o que encerrar. Sem esta
# conferência um nome errado terminava em "sessão encerrada" sem ter feito nada.
if [[ ! -f "$arq" ]] && ! "${JANGADA_TMUX[@]}" has-session -t "=$s" 2>/dev/null; then
  echo "sessão não encontrada: $s (veja jangada-agentes --lista)" >&2
  exit 1
fi

worktree=""; ramo=""; base=""; raiz=""
if [[ -f "$arq" ]]; then
  worktree="$(jq -r '.worktree // "" | tostring' "$arq" 2>/dev/null)" || worktree=$'\n'
  ramo="$(jq -r '.ramo // "" | tostring' "$arq" 2>/dev/null)" || ramo=$'\n'
  base="$(jq -r '.base // "" | tostring' "$arq" 2>/dev/null)" || base=$'\n'
  raiz="$(jq -r '.raiz // "" | tostring' "$arq" 2>/dev/null)" || raiz=$'\n'
fi

# O arquivo de estado fica na pasta agentes/, gravável de dentro do
# jangada-isolar, e o que vem dele decide o merge, a remoção do worktree e o
# branch -d feitos aqui fora do isolamento. Por isso nada é usado sem
# conferência, e estado que não passa é recusado sem alterar nada:
# - o pid não é lido: nenhum script grava mais, e matar um número vindo do
#   estado encerraria qualquer processo do usuário;
# - ramo e worktree vêm juntos, no formato que o jangada-agente cria:
#   agente/NOME e $JANGADA_WORKTREES/REPO/NOME, sem link simbólico no caminho;
# - com o worktree no disco, ele precisa estar registrado no repositório da
#   raiz e os dois precisam ter o mesmo diretório git comum; sem ele, a raiz
#   precisa ser a raiz de um repositório com o nome que deu REPO;
# - a base precisa ser um nome de ramo válido que não comece com "-", para
#   não virar opção do git log.
recusar() {
  echo "estado inválido em $arq: $1" >&2
  echo "nada foi feito; confira o arquivo (ele é gravável pelo agente isolado)" >&2
  exit 1
}

# O mesmo slug do jangada-agente, que dá o nome da pasta do repositório.
slug() {
  { iconv -f UTF-8 -t ASCII//TRANSLIT 2>/dev/null <<<"$1" || printf '%s\n' "$1"; } \
    | LC_ALL=C tr '[:upper:]' '[:lower:]' \
    | LC_ALL=C sed -E -e 's/[^a-z0-9_-]+/-/g' -e 's/^-+//' -e 's/-+$//'
}

# Caminho absoluto e canônico do diretório git comum de $1, ou nada.
dir_comum() {
  local d
  d="$(jangada_git_seguro -C "$1" rev-parse --path-format=absolute --git-common-dir 2>/dev/null)" || return 1
  realpath -e -- "$d" 2>/dev/null
}

conferir_estado() {
  local c
  for c in "$worktree" "$ramo" "$base" "$raiz"; do
    [[ "$c" != *[[:cntrl:]]* ]] || recusar "campo com caractere de controle"
  done
  [[ -z "$raiz" || "$raiz" == /* ]] || recusar "raiz não é caminho absoluto: $raiz"
  if [[ -z "$ramo" && -z "$worktree" ]]; then
    # Sessão direto no repositório: sem ramo, a base não serve para nada.
    base=""
    return 0
  fi
  [[ -n "$ramo" && -n "$worktree" && -n "$raiz" ]] \
    || recusar "ramo, worktree e raiz precisam vir juntos"
  [[ "$ramo" =~ ^agente/([a-z0-9_][a-z0-9_-]*)$ ]] || recusar "ramo fora do padrão agente/NOME: $ramo"
  local nome="${BASH_REMATCH[1]}" resto repo wts real
  resto="${worktree#"$JANGADA_WORKTREES"/}"
  [[ "$resto" != "$worktree" && "$resto" =~ ^([a-z0-9_-]*)/([a-z0-9_-]+)$ && "${BASH_REMATCH[2]}" == "$nome" ]] \
    || recusar "worktree fora de $JANGADA_WORKTREES/REPO/${nome}: $worktree"
  repo="${BASH_REMATCH[1]}"
  wts="$(realpath -m -- "$JANGADA_WORKTREES")"
  real="$(realpath -m -- "$worktree")"
  [[ "$real" == "$wts/$repo/$nome" ]] || recusar "o caminho do worktree passa por link simbólico: $worktree"
  [[ "$real" != "$(realpath -m -- "$raiz")" ]] || recusar "worktree e raiz são a mesma pasta: $worktree"
  if [[ -n "$base" ]]; then
    [[ "$base" != -* ]] && git check-ref-format "refs/heads/$base" \
      || recusar "base não é nome de ramo: $base"
  fi

  local topo
  topo="$(jangada_git_seguro -C "$raiz" rev-parse --show-toplevel 2>/dev/null)" \
    || recusar "raiz não é repositório git: $raiz"
  [[ "$(realpath -m -- "$topo")" == "$(realpath -m -- "$raiz")" ]] \
    || recusar "raiz não é a raiz do repositório: $raiz"

  if [[ -e "$worktree" || -L "$worktree" ]]; then
    [[ -d "$worktree" && ! -L "$worktree" ]] || recusar "worktree não é pasta: $worktree"
    local comum_wt comum_raiz linha registrado=0
    comum_wt="$(dir_comum "$worktree")" || recusar "worktree sem repositório git: $worktree"
    comum_raiz="$(dir_comum "$raiz")" || recusar "raiz sem repositório git: $raiz"
    [[ "$comum_wt" == "$comum_raiz" ]] \
      || recusar "worktree ($comum_wt) e raiz ($comum_raiz) são de repositórios diferentes"
    while IFS= read -r -d '' linha; do
      [[ "$linha" == "worktree "* && "$(realpath -m -- "${linha#worktree }")" == "$real" ]] && registrado=1
    done < <(jangada_git_seguro -C "$raiz" worktree list --porcelain -z 2>/dev/null)
    ((registrado)) || recusar "$worktree não é worktree registrado em $raiz"
  else
    [[ "$(slug "$(basename "$raiz")")" == "$repo" ]] \
      || recusar "raiz ($raiz) não é o repositório do worktree $worktree"
  fi
}
conferir_estado

confirmar() {
  local r
  read -r -p "$1 [s/N] " r
  [[ "${r,,}" == s* ]]
}

# Integração: avanço rápido da base, sem limpeza da sessão.
#
# O git roda aqui fora do isolamento sobre o worktree e o repositório do
# agente, cujo .git o agente pode alterar: todas as chamadas passam por
# jangada_git_seguro (sem fsmonitor nem ganchos), e o status ignora submódulos.
#
# A cópia instalada não é atualizada aqui: o que entrou no repositório de
# origem dela só chega por uma atualização feita à mão (git fetch e merge
# --ff-only), depois de conferir os commits.
avisar_copia_instalada() {
  local r="$1"
  [[ -d "$JANGADA_CORE_PATH/.git" ]] || return 0

  local raiz_real caminho_real
  raiz_real="$(realpath "$r" 2>/dev/null || printf '%s' "$r")"
  caminho_real="$(realpath "$JANGADA_CORE_PATH" 2>/dev/null || printf '%s' "$JANGADA_CORE_PATH")"
  [[ "$raiz_real" != "$caminho_real" ]] || return 0

  local e_repo=0
  if [[ -n "${JANGADA_REPO:-}" && -d "$JANGADA_REPO" ]]; then
    local repo_real
    repo_real="$(realpath "$JANGADA_REPO" 2>/dev/null || true)"
    [[ -n "$repo_real" && "$raiz_real" == "$repo_real" ]] && e_repo=1
  fi

  local origem
  origem="$(git config -f "$JANGADA_CORE_PATH/.git/config" --get remote.origin.url 2>/dev/null || true)"
  if [[ "$origem" == /* && -d "$origem/.git" ]]; then
    local origem_real
    origem_real="$(realpath "$origem" 2>/dev/null || true)"
    [[ -n "$origem_real" && "$raiz_real" == "$origem_real" ]] && e_repo=1
  fi

  if ((e_repo)); then
    echo "a cópia instalada ($JANGADA_CORE_PATH) não foi atualizada: confira o que entrou e avance-a à mão (git -C $JANGADA_CORE_PATH fetch origin && git -C $JANGADA_CORE_PATH merge --ff-only)"
  fi
  return 0
}

# Recusa da integração. A cópia principal fica como estava.
negar() {
  echo "integração automática bloqueada: $1. A sessão, o ramo e o worktree foram mantidos." >&2
  exit 1
}

# Parecer que vale: a marca em revisoes/, que o jangada-isolar oculta, para o
# commit exato do ramo, com a árvore que o revisor leu, contra a base como
# está agora, com verificação local completa e revisor que não é o autor. Os
# pareceres em agentes/ são graváveis pelo agente e não contam.
motivo_marca=""
aprovada() {
  local marca="$JANGADA_ESTADO/revisoes/validacao-$s.aprovado" c="" l="" b="" t="" i="" v=""
  motivo_marca="falta parecer APROVADO gravado fora do isolamento para o commit ${cabeca:0:12} de $ramo"
  [[ -f "$marca" && ! -L "$marca" ]] || return 1
  IFS=$'\t' read -r c l b t i v < <(jq -r 'objects
    | [.candidate_sha, .limpo, .base_sha, .candidate_tree, .independent, .local_verified]
    | map(tostring) | @tsv' "$marca" 2>/dev/null) || return 1
  [[ "$c" == "$cabeca" && "$l" == true && "$v" == true ]] || return 1
  [[ "$t" == "$(jangada_git_seguro -C "$raiz" rev-parse --verify --quiet "$cabeca^{tree}" || true)" ]] || return 1
  if [[ "$b" != "$ponta_base" ]]; then
    motivo_marca="o parecer do commit ${cabeca:0:12} foi dado contra $base em ${b:0:12}, e ela está em ${ponta_base:0:12}"
    return 1
  fi
  if [[ "$i" != true ]]; then
    motivo_marca="o commit ${cabeca:0:12} só tem autorrevisão, que não vale como revisão independente"
    return 1
  fi
}

# O agente grava em .git/objects, e o git não reconfere o hash de um objeto
# solto ao ler: um blob trocado entraria na base com o nome do original. O
# espelho recebe o ramo e a base por fetch, que recalcula cada hash, e o
# conteúdo de cada objeto que o avanço lê tem de ser igual nos dois lados.
objetos_integros() {
  local comum espelho chave lista rc=0
  comum="$(dir_comum "$raiz")" && espelho="$(jangada_espelho "$comum")" || return 1
  chave="$(printf '%s' "$s" | sha256sum | cut -c1-16)"
  jangada_git_seguro --git-dir="$espelho" fetch -q --no-tags "$comum" \
    "+$cabeca:refs/jangada/$chave/candidato" "+$ponta_base:refs/jangada/$chave/base" || return 1
  lista="$(umask 077; mktemp "$JANGADA_ESTADO/revisoes/objetos-XXXXXX")" || return 1
  { jangada_git_seguro --git-dir="$espelho" rev-list --objects "$ponta_base..$cabeca"
    jangada_git_seguro --git-dir="$espelho" rev-list --objects --no-walk "$ponta_base" "$cabeca"
  } | cut -d' ' -f1 | sort -u >"$lista" || rc=1
  ((rc)) || cmp -s <(jangada_git_seguro --git-dir="$espelho" cat-file --batch <"$lista") \
                   <(jangada_git_seguro -C "$raiz" cat-file --batch <"$lista") || rc=1
  rm -f "$lista"
  return "$rc"
}

# Conferência posterior ao avanço. Cada arquivo que mudou entre a base e o
# commit, na árvore do espelho, tem de ter no disco o conteúdo do nome que
# leva nessa árvore. O hash é recalculado do arquivo: o índice e o stat não
# entram, porque quem os gravou foi o avanço conferido.
avanco_integro() {
  local espelho meta caminho modo nome atual lista rc=0
  espelho="$(jangada_espelho "$(dir_comum "$raiz")")" || return 1
  lista="$(umask 077; mktemp "$JANGADA_ESTADO/revisoes/avanco-XXXXXX")" || return 1
  if ! jangada_git_seguro --git-dir="$espelho" diff-tree -r -z --no-renames "$ponta_base" "$cabeca" >"$lista"; then
    rm -f "$lista"
    return 1
  fi
  while IFS= read -r -d '' meta; do
    IFS= read -r -d '' caminho <&0 || { rc=1; break; }
    read -r _ modo _ nome _ <<<"$meta"
    case "$modo" in
      160000) continue ;;
      000000)
        # Caminho removido pelo commit tem de estar ausente, inclusive como
        # link pendente; só vale uma pasta que o commit tem no mesmo lugar.
        if [[ -e "$raiz/$caminho" || -L "$raiz/$caminho" ]]; then
          [[ -d "$raiz/$caminho" && ! -L "$raiz/$caminho" \
             && "$(jangada_git_seguro --git-dir="$espelho" cat-file -t "$cabeca:$caminho" 2>/dev/null)" == tree ]] \
            || { rc=1; break; }
        fi
        continue
        ;;
      120000)
        [[ -L "$raiz/$caminho" ]] || { rc=1; break; }
        atual="$(readlink -n -- "$raiz/$caminho" | jangada_git_seguro hash-object --stdin)" || { rc=1; break; }
        ;;
      *)
        [[ -f "$raiz/$caminho" && ! -L "$raiz/$caminho" ]] || { rc=1; break; }
        if { [[ "$modo" == 100755 ]] && [[ ! -x "$raiz/$caminho" ]]; } ||
           { [[ "$modo" == 100644 ]] && [[ -x "$raiz/$caminho" ]]; }; then
          rc=1; break
        fi
        atual="$(cd "$raiz" && jangada_git_seguro hash-object -- "$caminho" 2>/dev/null)" || { rc=1; break; }
        ;;
    esac
    [[ "$atual" == "$nome" ]] || { rc=1; break; }
  done <"$lista"
  rm -f "$lista"
  return "$rc"
}

# A suíte roda numa cópia do commit tirada do espelho e criada em
# integracoes/, que o isolamento oculta: a worktree da tarefa segue gravável
# pelo agente enquanto a sessão existe, e o que roda aqui fora do isolamento
# tem de ser o conteúdo que o revisor leu. A cópia fica fora de revisoes/
# porque leva os links versionados da entrega, que o jangada-isolar recusa ali.
# Projeto sem testes/verificar.sh na base e no commit não tem essa etapa.
verificar_fora() {
  local espelho copias copia chave registro="$JANGADA_ESTADO/revisoes/verificar-$s.log" rc=0
  objetos_integros && espelho="$(jangada_espelho "$(dir_comum "$raiz")")" || {
    echo "os objetos de $ramo ou de $base não conferem com o espelho (objeto adulterado ou repositório corrompido)" >&2
    return 1
  }
  if ! jangada_git_seguro --git-dir="$espelho" cat-file -e "$cabeca:testes/verificar.sh" 2>/dev/null \
     && ! jangada_git_seguro --git-dir="$espelho" cat-file -e "$ponta_base:testes/verificar.sh" 2>/dev/null; then
    echo "o projeto não tem testes/verificar.sh; etapa não se aplica"
    return 0
  fi
  # Junto deste comando, não no JANGADA_CORE_PATH: a cópia instalada pode estar
  # atrás do código que roda e não ter o pasta-entrega.
  copias="$(python3 "$(dirname "${BASH_SOURCE[0]}")/../orquestracao/confianca.py" pasta-entrega "$JANGADA_ESTADO" integracoes)" \
    && copia="$(mktemp -d "$copias/XXXXXX")" || return 1
  echo "rodando testes/verificar.sh do commit ${cabeca:0:12} fora do isolamento (registro em $registro)..."
  chave="$(printf '%s' "$s" | sha256sum | cut -c1-16)"
  jangada_git_seguro init -q "$copia" \
    && jangada_git_seguro -C "$copia" fetch -q --no-tags "$espelho" "refs/jangada/$chave/candidato" \
    && [[ "$(jangada_git_seguro -C "$copia" rev-parse --verify --quiet FETCH_HEAD)" == "$cabeca" ]] \
    && jangada_git_seguro -C "$copia" checkout -q --detach "$cabeca" || rc=1
  ((rc)) || (cd "$copia" && env -u JANGADA_SESSAO ./testes/verificar.sh) </dev/null >"$registro" 2>&1 || rc=$?
  rm -rf "$copia"
  if ((rc)); then
    tail -20 "$registro" 2>/dev/null | tr -d '\000-\010\013-\037\177' >&2
    echo "testes/verificar.sh terminou com código $rc" >&2
  fi
  return "$rc"
}

# Opções na linha de comando: status.showUntrackedFiles, diff.ignoreSubmodules
# e submodule.*.ignore vêm do repositório, que o agente grava.
# Uma falha do git status conta como alteração.
principal_alterada() {
  local saida
  if ! saida="$(jangada_git_seguro -C "$raiz" status --porcelain --untracked-files=all --ignore-submodules=none)"; then
    echo "o git status falhou em $raiz" >&2
    return 0
  fi
  [[ -n "$saida" ]]
}

# Um filter.* do repositório roda o comando dele quando o avanço grava um
# arquivo que o .gitattributes do candidato liga ao filtro, e quando o git
# status relê esse arquivo. Vale o escopo local, que inclui o config.worktree
# e o que entra por include ou includeIf. Uma falha do git config conta como
# filtro.
filtro_local() {
  local lista chave
  if ! lista="$(jangada_git_seguro -C "$raiz" config --includes --show-scope --name-only --list)"; then
    echo "o git config falhou em $raiz" >&2
    return 0
  fi
  chave="$(awk -F'\t' '($1 == "local" || $1 == "worktree") && $2 ~ /^filter\./ { print $2; exit }' <<<"$lista")"
  [[ -n "$chave" ]] || return 1
  echo "a configuração local de $raiz define $(tr -d '\000-\037\177' <<<"$chave")" >&2
}

# Roda sob a trava do repositório: entre a conferência e o avanço passam a
# confirmação e a suíte, e nesse meio outra sessão pode ter sido integrada ou
# o usuário pode ter editado a cópia principal. Tudo é conferido de novo, e
# qualquer diferença recusa. A trava coordena chamadas do jangada, não
# impede editores nem Git externo: por isso o avanço é --ff-only, que não
# grava por cima de alteração local, e nenhuma falha é desfeita com descarte.
integrar_sob_trava() {
  if ! aprovada; then
    echo "$motivo_marca" >&2
    return 11
  fi
  if [[ "$(jangada_git_seguro -C "$raiz" rev-parse --verify --quiet "$ramo^{commit}" || true)" != "$cabeca" ]]; then
    echo "o ramo $ramo mudou depois da conferência (era ${cabeca:0:12})" >&2
    return 11
  fi
  if [[ "$(jangada_git_seguro -C "$raiz" rev-parse --abbrev-ref HEAD)" != "$base" \
        || "$(jangada_git_seguro -C "$raiz" rev-parse --verify --quiet HEAD || true)" != "$ponta_base" ]]; then
    echo "a base $base mudou depois da conferência (era ${ponta_base:0:12})" >&2
    return 11
  fi
  if filtro_local; then
    echo "a cópia principal ($raiz) passou a ter filtro do git depois da conferência" >&2
    return 11
  fi
  if principal_alterada; then
    echo "a cópia principal ($raiz) recebeu alterações depois da conferência" >&2
    return 11
  fi
  if ! objetos_integros; then
    echo "os objetos de $ramo ou de $base em $raiz não conferem com o espelho (objeto adulterado ou repositório corrompido)" >&2
    return 11
  fi
  # O avanço lê os objetos do espelho, que o fetch recalculou e o agente não
  # grava; os de $raiz/.git/objects e seus alternates ficam de fora. O reflog
  # vem ligado na linha de comando: core.logAllRefUpdates é do repositório,
  # que o agente grava.
  local espelho
  espelho="$(jangada_espelho "$(dir_comum "$raiz")")" || return 11
  if ! GIT_OBJECT_DIRECTORY="$espelho/objects" GIT_ALTERNATE_OBJECT_DIRECTORIES='' \
       jangada_git_seguro -C "$raiz" -c core.logAllRefUpdates=true merge --ff-only "$cabeca"; then
    echo "o git recusou o avanço rápido de $base em $raiz" >&2
    return 11
  fi
  # Entre a última conferência e o merge, um Git de fora da trava pode ter
  # movido a base para um ancestral de $cabeca, e o --ff-only aceita. O reflog
  # só detecta esse caso depois do avanço.
  local anterior
  anterior="$(jangada_git_seguro -C "$raiz" rev-parse --verify --quiet "refs/heads/$base@{1}" || true)"
  if [[ "$anterior" != "$ponta_base" \
        || "$(jangada_git_seguro -C "$raiz" rev-parse --verify --quiet "refs/heads/$base" || true)" != "$cabeca" ]]; then
    echo "!! $base avançou para ${cabeca:0:12}, mas antes do avanço estava em ${anterior:0:12}, não em ${ponta_base:0:12}: a base mudou depois da última conferência. Nada foi desfeito: confira $raiz e o reflog de $base. A sessão, o ramo e o worktree foram mantidos." >&2
    return 13
  fi
  avanco_integro || return 12
}

integrado=0
apagar_ramo=0
if ((integrar)); then
  [[ -n "$ramo" && -n "$base" && -n "$raiz" ]] \
    || negar "a sessão $s não tem ramo próprio (trabalho direto no repositório); nada a integrar"
  ((!sem_revisao)) || negar "--sem-revisao não libera a integração"
  [[ -z "${JANGADA_ISOLADO:-}" ]] || negar "dentro do isolamento não há parecer que valha; rode o --integrar fora dele"
  # Ramo, base, raiz e worktree vêm do estado, que o agente grava. Têm de ser
  # os que o jangada-agente copiou para revisoes/ ao abrir a sessão.
  jq -e --arg r "$raiz" --arg w "$worktree" --arg m "$ramo" --arg b "$base" \
    '.raiz == $r and .worktree == $w and .ramo == $m and .base == $b' \
    "$JANGADA_ESTADO/revisoes/$s.json" >/dev/null 2>&1 \
    || negar "ramo, base, raiz ou worktree do estado diferem da cópia protegida em $JANGADA_ESTADO/revisoes/$s.json"
  # Antes de qualquer git status, que também roda o filtro.
  ! filtro_local || negar "a cópia principal ($raiz) tem filtro do git configurado, que rodaria comando no avanço"
  if [[ -n "$worktree" && -d "$worktree" && -n "$(jangada_git_seguro -C "$worktree" status --porcelain --ignore-submodules=all)" ]]; then
    jangada_git_seguro -C "$worktree" status --short --ignore-submodules=all | head -20 | tr -d '\000-\010\013-\037\177' >&2
    negar "o worktree $worktree tem alterações sem commit"
  fi
  atual="$(jangada_git_seguro -C "$raiz" rev-parse --abbrev-ref HEAD)"
  [[ "$atual" == "$base" ]] || negar "a cópia principal ($raiz) está em '$atual', não em '$base'"
  if principal_alterada; then
    jangada_git_seguro -C "$raiz" status --short --untracked-files=all --ignore-submodules=none | head -20 | tr -d '\000-\010\013-\037\177' >&2
    negar "a cópia principal ($raiz) tem alterações sem commit"
  fi
  # A sessão continua aberta: o agente pode mover o ramo. O commit é
  # resolvido uma vez, e é ele que se lista, se confere, se testa e se integra.
  cabeca="$(jangada_git_seguro -C "$raiz" rev-parse --verify --quiet "$ramo^{commit}" || true)"
  ponta_base="$(jangada_git_seguro -C "$raiz" rev-parse --verify --quiet HEAD || true)"
  [[ -n "$cabeca" && -n "$ponta_base" ]] || negar "o ramo $ramo ou a base $base não tem commit"
  if [[ -n "$gui_base" ]] && [[ "$gui_base" != "$ponta_base" || "$gui_candidato" != "$cabeca" ]]; then
    negar "os commits mudaram desde a confirmação gráfica"
  fi
  if [[ "$cabeca" == "$ponta_base" ]] || jangada_git_seguro -C "$raiz" merge-base --is-ancestor "$cabeca" "$ponta_base"; then
    echo "o ramo $ramo não tem commits além de $base; nada a integrar"
    exit 0
  fi
  if ! jangada_git_seguro -C "$raiz" merge-base --is-ancestor "$ponta_base" "$cabeca"; then
    [[ -n "$worktree" && -d "$worktree" ]] || negar "a base $base andou e não há worktree para o rebase de $ramo"
    [[ "$(jangada_git_seguro -C "$worktree" symbolic-ref -q HEAD || true)" == "refs/heads/$ramo" ]] \
      || negar "a base $base andou e o worktree $worktree não está em $ramo"
    echo "a base $base andou (está em ${ponta_base:0:12}); rebase de $ramo em $worktree"
    jangada_git_seguro -C "$worktree" rebase "$ponta_base" >&2 \
      || negar "o rebase de $ramo parou em $worktree; resolva lá (git rebase --continue) ou desfaça (git rebase --abort) e peça nova revisão"
    nova="$(jangada_git_seguro -C "$raiz" rev-parse --verify --quiet "$ramo^{commit}" || true)"
    negar "o rebase mudou $ramo de ${cabeca:0:12} para ${nova:0:12}, e o parecer tem de ser do commit novo; rode fora do isolamento: JANGADA_SESSAO=$s jangada-validar --base $base $worktree"
  fi
  echo "commits de $ramo a integrar em $base ($raiz):"
  jangada_git_seguro -C "$raiz" log --oneline "$ponta_base..$cabeca" | tr -d '\000-\010\013-\037\177' | head -30
  aprovada || negar "$motivo_marca; rode fora do isolamento: JANGADA_SESSAO=$s jangada-validar --base $base $worktree"
  echo "aprovado fora do isolamento no commit ${cabeca:0:12}, contra $base em ${ponta_base:0:12}"
  if [[ -z "$gui_base" ]]; then
    confirmar "rodar testes/verificar.sh e integrar em $base por avanço rápido?" || negar "sem confirmação"
  fi
  verificar_fora || negar "testes/verificar.sh fora do isolamento não saiu com 0"
  # A trava só cobre a reconferência e o avanço, nunca a espera pelo usuário.
  trava="$JANGADA_ESTADO/revisoes/travas/$(dir_comum "$raiz" | sha256sum | cut -c1-16)"
  (umask 077; mkdir -p "$trava")
  rc=0
  jangada_com_trava_dir "$trava" integrar_sob_trava || rc=$?
  if ((rc == 12)); then
    echo "!! $base avançou de ${ponta_base:0:12} para ${cabeca:0:12}, mas os arquivos gravados em $raiz não conferem com o espelho (arquivo alterado durante o avanço). Nada foi desfeito: confira $raiz antes de qualquer outro uso. A sessão, o ramo e o worktree foram mantidos." >&2
    exit 1
  fi
  ((rc != 13)) || exit 1
  ((rc == 0 || rc == 11)) || echo "outra integração segura a trava deste repositório" >&2
  ((rc == 0)) || negar "nada foi integrado; rode de novo"
  echo "integrado em $base por avanço rápido, em ${cabeca:0:12}"
  echo "sessão, ramo e worktree mantidos; nada foi enviado ao remoto"
  avisar_copia_instalada "$raiz"
  exit 0
fi

forcar=0
if [[ -n "$worktree" && -d "$worktree" ]]; then
  pendentes="$(jangada_git_seguro -C "$worktree" status --porcelain --ignore-submodules=all | tr -d '\000-\010\013-\037\177')"
  if [[ -n "$pendentes" ]]; then
    echo "alterações não salvas em commit no worktree $worktree:"
    printf '%s\n' "$pendentes" | head -20
    confirmar "descartar essas alterações e remover o worktree?" || { echo "nada foi feito"; exit 1; }
    forcar=1
  fi
  if ((!integrar)) && [[ -n "$base" && -n "$ramo" ]]; then
    novos="$(jangada_git_seguro -C "$raiz" log --oneline "$base..$ramo" 2>/dev/null | tr -d '\000-\010\013-\037\177' || true)"
    if [[ -n "$novos" ]]; then
      echo "commits no ramo $ramo que não estão em $base (continuarão no ramo):"
      printf '%s\n' "$novos" | head -20
    fi
  fi
fi

assinar=0
if ((integrado)) && [[ -f "$JANGADA_CONFIG/allowed_signers" && "$raiz" -ef "${JANGADA_REPO:-}" ]]; then
  assinar=1
fi

# A limpeza encerra a sessão, remove o worktree e apaga o estado, nessa ordem:
# o agente para antes de a pasta dele sumir. Quando o comando é chamado de
# dentro da própria sessão, encerrar a sessão mataria este script no meio;
# nesse caso a limpeza continua num processo separado, com registro em arquivo.
limpar() {
  (umask 077; mkdir -p "$JANGADA_ESTADO/revisoes/travas/$s")
  local trava_revisoes
  exec {trava_revisoes}<"$JANGADA_ESTADO/revisoes/travas/$s"
  flock -w 15 "$trava_revisoes" || { echo "revisão ocupada; encerramento adiado" >&2; return 1; }
  # Parar o agente não apaga os documentos nem o trabalho produzido.
  "${JANGADA_TMUX[@]}" kill-session -t "=$s" 2>/dev/null || true
  # O histórico protegido é publicado e conferido antes de qualquer remoção.
  # Falha de leitura, integridade, espaço ou publicação mantém os originais.
  local arquivo_historico
  arquivo_historico="$(python3 "$JANGADA_CORE_PATH/orquestracao/confianca.py" arquivar "$JANGADA_ESTADO" "$s")" \
    || { echo "encerramento bloqueado: evidências originais mantidas" >&2; return 1; }
  echo "evidências preservadas: $arquivo_historico"
  registrar_consumo_tarefa || true
  if [[ -n "$worktree" && -d "$worktree" ]]; then
    if ((forcar)); then
      jangada_git_seguro -C "$raiz" worktree remove --force "$worktree"
    else
      jangada_git_seguro -C "$raiz" worktree remove "$worktree"
    fi
    echo "worktree removido: $worktree"
  fi
  [[ -n "$worktree" ]] && jangada_agy_ajustar_confianca remover "$worktree" || true
  if ((apagar_ramo)); then
    # -d, não -D: o git só apaga se o ramo estiver mesclado, o que confere a
    # integração feita acima.
    jangada_git_seguro -C "$raiz" branch -d "$ramo" && echo "ramo apagado: $ramo"
  elif [[ -n "$ramo" && -n "$worktree" ]]; then
    echo "ramo mantido: $ramo (apague com: git -C $raiz branch -d $ramo)"
  fi
  if jq -e '.execucao | strings | test("^exe-[0-9a-f]{16}$")' "$arq" >/dev/null 2>&1; then
    local resultado_sessao=()
    ((integrado)) && resultado_sessao+=(--integrada)
    "$JANGADA_CORE_PATH/bin/jangada-projeto" --projeto "$raiz" sessao-encerrar "$s" "${resultado_sessao[@]}" >/dev/null \
      || echo "aviso: execução da sessão ficou sem registro de encerramento" >&2
  fi
  rm -f "$arq"
  # Os pareceres do jangada-validar contam as rodadas: uma sessão nova com o
  # mesmo nome começa da primeira. Só -rN.md, para não levar os de proj--fix-rotas
  # junto com os de proj--fix.
  local parecer
  for parecer in "$JANGADA_ESTADO/agentes/validacao-$s-r"[0-9]*.md; do
    [[ "${parecer#"$JANGADA_ESTADO/agentes/validacao-$s-r"}" =~ ^[0-9]+\.md$ ]] && rm -f "$parecer"
  done
  rm -f "$JANGADA_ESTADO/agentes/validacao-$s.aprovado" "$JANGADA_ESTADO/agentes/prompt-$s.md" \
    "$JANGADA_ESTADO/agentes/protocolo-$s.md"
  # As revisões feitas fora, pelo mesmo motivo. Dentro do isolamento a pasta
  # é a vazia que o oculta, e nada sai do disco; a marca que sobra vale só
  # para o commit dela.
  for parecer in "$JANGADA_ESTADO/revisoes/validacao-$s-r"[0-9]*.md; do
    [[ "${parecer#"$JANGADA_ESTADO/revisoes/validacao-$s-r"}" =~ ^[0-9]+\.md$ ]] && rm -f "$parecer"
  done
  rm -f "$JANGADA_ESTADO/revisoes/validacao-$s.aprovado" "$JANGADA_ESTADO/revisoes/$s.json"
  echo "sessão encerrada: $s"
  # Só depois do branch -d: assinar reescreve os commits do ramo, e o git
  # deixaria de vê-lo como mesclado.
  if ((assinar)); then
    "$JANGADA_CORE_PATH/bin/jangada-assinar" "$raiz" \
      || echo "!! a integração ficou sem assinatura; rode jangada-assinar antes do push" >&2
  fi
  "$JANGADA_CORE_PATH/bin/jangada-gancho" pos-agente-fim "$s" "$raiz" "$integrado"
}

registrar_consumo_tarefa() {
  local autor projeto execucao inicio fim medicao linha arquivo="$JANGADA_ESTADO/consumo-tarefas.jsonl"
  [[ -f "$arq" ]] || return 0
  execucao="$(jq -r '.execucao // ""' "$arq" 2>/dev/null || true)"
  if [[ -f "$arquivo" ]] && jq -e --arg sessao "$s" --arg execucao "$execucao" \
      'select(.sessao == $sessao and (.execucao // "") == $execucao)' "$arquivo" >/dev/null 2>&1; then return 0; fi
  autor="$(jq -r '.agente // ""' "$arq" 2>/dev/null | awk '{print $1}')"
  projeto="$(basename "$(jq -r '.raiz // .dir // ""' "$arq" 2>/dev/null)")"
  inicio="$(jq -r '.desde // ""' "$arq" 2>/dev/null)"
  fim="$(jangada_data_iso)"
  medicao="$(python3 "$JANGADA_CORE_PATH/orquestracao/consumo_tarefa.py" "$JANGADA_ESTADO" "$s" "$autor" --projeto "${worktree:-$raiz}" 2>/dev/null)" \
    || medicao='{"entrada":null,"saida":null,"cache_lido":null,"modelo":null,"motivo":"falha na medição"}'
  linha="$(jq -nc --arg sessao "$s" --arg projeto "$projeto" --arg execucao "$execucao" \
    --arg autor "$autor" --arg inicio "$inicio" --arg fim "$fim" --argjson tokens "$medicao" \
    '{sessao:$sessao,projeto:$projeto,execucao:(if $execucao == "" then null else $execucao end),autor:$autor,
      modelo:$tokens.modelo,tokens:{entrada:$tokens.entrada,saida:$tokens.saida,cache_lido:$tokens.cache_lido},
      motivo:$tokens.motivo,inicio:(if $inicio == "" then null else $inicio end),fim:$fim}')" || return 0
  jangada_anexar_linha "$arquivo" "$linha" || true
}

if [[ "${JANGADA_SESSAO:-}" == "$s" ]]; then
  registro="$JANGADA_ESTADO/agentes/fim-$s.log"
  echo "encerrando a partir da própria sessão; registro em $registro"
  # A limpeza em processo separado não tem terminal para a confirmação.
  if ((assinar)); then
    echo "!! a integração ficou sem assinatura; rode jangada-assinar num terminal comum antes do push" >&2
    assinar=0
  fi
  export s worktree ramo raiz arq forcar apagar_ramo integrado assinar
  export -f limpar registrar_consumo_tarefa
  if command -v setsid >/dev/null 2>&1; then
    # shellcheck disable=SC1090,SC2016
    setsid -f bash -c 'sleep 0.5; source "$1"; limpar' _ "$JANGADA_CORE_PATH/bin/jangada-config" >"$registro" 2>&1
  else
    # shellcheck disable=SC1090,SC2016
    nohup bash -c 'sleep 0.5; source "$1"; limpar' _ "$JANGADA_CORE_PATH/bin/jangada-config" >"$registro" 2>&1 &
  fi
  exit 0
fi

limpar
