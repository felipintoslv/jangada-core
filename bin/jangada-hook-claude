#!/usr/bin/env bash
# Hook do Claude Code: registra o estado da sessão e avisa quando o agente
# pede atenção ou termina. Nunca falha, para não atrapalhar o agente.
#
# Uso (configurado em ~/.claude/settings.json):
#   jangada-hook-claude trabalhando|aguardando|concluido|inicio|fim
#   jangada-hook-claude subagente-inicio|subagente-fim
# Recebe o JSON do evento pela entrada padrão.

{
  # O jangada-validar desliga o hook no claude -p da revisão: aquele Claude
  # não é o agente da sessão.
  [[ -z "${JANGADA_HOOK_DESLIGADO:-}" ]] || exit 0
  evento="${1:-ativo}"
  dir_bin="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
  # shellcheck source=bin/jangada-config
  source "$dir_bin/jangada-config"

  entrada="$(cat 2>/dev/null || true)"
  campo() { jq -r "$1 // \"\"" <<<"$entrada" 2>/dev/null || true; }
  # Só o Notification traz .message. No Stop vale o fim da última resposta
  # (last_assistant_message, nas versões que o enviam) e no UserPromptSubmit o
  # pedido. O PostToolUse não traz nenhum dos três e mantém a mensagem que já
  # estava no estado.
  mensagem="$(jq -r '(.message // .last_assistant_message // .prompt // "")
    | split("\n") | map(select(test("\\S"))) | (.[0] // "")
    | if length > 120 then .[0:117] + "..." else . end' <<<"$entrada" 2>/dev/null || true)"
  cwd="$(campo .cwd)"
  conversa="$(campo .session_id)"
  tipo="$(campo .notification_type)"

  # SubagentStart e SubagentStop: só uma linha no histórico, com o id e o tipo
  # do subagente. O estado da sessão e a barra não mudam: o agente principal
  # segue trabalhando. O Stop não dispara no fim de um subagente.
  if [[ "$evento" == subagente-inicio || "$evento" == subagente-fim ]]; then
    sessao="${JANGADA_SESSAO:-}"
    [[ -n "$sessao" ]] || exit 0
    arq="$JANGADA_ESTADO/agentes/$sessao.json"
    projeto="$(jq -r '(.raiz // .dir // "") | split("/") | last // ""' "$arq" 2>/dev/null || true)"
    extra="$(jq -c '{subagente_id: (.agent_id // ""), subagente_tipo: (.agent_type // ""),
      conversa: (.session_id // "")}' <<<"$entrada" 2>/dev/null || true)"
    jangada_registrar_evento "$sessao" "${projeto:-$(basename "${cwd:-$PWD}")}" claude "$evento" "$extra"
    exit 0
  fi

  # O que cada evento significa para o painel. Estado vazio: só registra a
  # conversa, sem mudar o estado nem avisar.
  estado="$evento"; avisar=1
  if [[ -z "$mensagem" ]]; then
    case "$evento" in
      concluido) mensagem="turno concluído" ;;
    esac
  fi
  case "$evento" in
    aguardando)
      # O Claude Code 2.1 diz o motivo da notificação. Só pedido de permissão
      # e pergunta ao usuário são espera de verdade; o idle_prompt chega um
      # minuto depois do Stop, com o agente parado no prompt, e repetir o aviso
      # crítico ali é ruído. Campo vazio (versões antigas): comportamento antigo.
      case "$tipo" in
        auth_success) exit 0 ;;
        idle_prompt) estado="concluido"; avisar=0 ;;
      esac
      ;;
    inicio)
      # SessionStart também dispara no /clear e no --resume. O id novo substitui
      # o anterior, que é o que o --restaurar precisa.
      estado="iniciado"; avisar=0; mensagem=""
      ;;
    fim)
      # SessionEnd: o Claude saiu. No /clear outra conversa começa em seguida,
      # então nada muda no estado.
      avisar=0
      if [[ "$(campo .reason)" == clear ]]; then
        estado=""
      else
        motivo="$(campo .reason)"
        estado="concluido"; mensagem="Claude encerrado${motivo:+ ($motivo)}"
      fi
      ;;
  esac

  # A sessão vem da variável JANGADA_SESSAO, definida pelo jangada-agente ao
  # criar a sessão tmux. Agentes abertos fora dele só geram o aviso, sem estado.
  sessao="${JANGADA_SESSAO:-}"
  if [[ -n "$sessao" ]]; then
    estado_dir="$JANGADA_ESTADO/agentes"
    mkdir -p "$estado_dir"
    arq="$estado_dir/$sessao.json"
    if [[ "$evento" == fim && ! -f "$arq" ]]; then
      exit 0
    fi
    agora="$(jangada_data_iso)"
    [[ -f "$arq" ]] || jq -n --arg s "$sessao" --arg d "${cwd:-$PWD}" '{sessao:$s, dir:$d}' >"$arq"
    tmp="$(mktemp "$arq.XXXXXX")"
    atualizar() {
      local anterior projeto
      anterior="$(jq -r '.estado // ""' "$arq" 2>/dev/null || true)"
      projeto="$(jq -r '(.raiz // .dir // "") | split("/") | last // ""' "$arq" 2>/dev/null || true)"
      # A conversa é gravada em todo evento: instalações sem o SessionStart
      # também ficam com o id para o --restaurar.
      # shellcheck disable=SC2016  # variáveis do jq
      jq --arg e "$estado" --arg m "$mensagem" --arg a "$agora" --arg c "$conversa" '
        (if $c != "" then .conversa = $c else . end)
        | (if $e != "" then .estado = $e | .atualizado = $a else . end)
        | (if $e != "" and $m != "" then .mensagem = $m else . end)
      ' "$arq" >"$tmp" 2>/dev/null && mv "$tmp" "$arq" || return 1
      # Histórico para o painel: só a mudança de estado, porque o PostToolUse
      # repete "trabalhando" a cada ferramenta. Início e fim contam sempre.
      case "$evento" in
        inicio) jangada_registrar_evento "$sessao" "${projeto:-$(basename "${cwd:-$PWD}")}" claude inicio ;;
        fim) [[ -n "$estado" ]] && jangada_registrar_evento "$sessao" "${projeto:-$(basename "${cwd:-$PWD}")}" claude fim ;;
        *) [[ -n "$estado" && "$estado" != "$anterior" ]] \
             && jangada_registrar_evento "$sessao" "${projeto:-$(basename "${cwd:-$PWD}")}" claude "$estado" ;;
      esac
    }
    if jangada_com_trava_dir "$estado_dir" atualizar; then
      jangada_avisar_interface estado-sessao
    fi
    rm -f "$tmp"
  fi
  nome="${sessao:-$(basename "${cwd:-$PWD}")}"

  # Avisos. A notificação com botão fica esperando em segundo plano; um clique
  # leva à janela do agente. Dentro do jangada-isolar o tmux fica fora de
  # alcance, e a notificação vai sem o botão.
  if ((avisar)) && [[ "$estado" == "aguardando" || "$estado" == "concluido" ]]; then
    if [[ "$estado" == "aguardando" ]]; then
      titulo="Agente aguardando: $nome"; urg=critical
    else
      titulo="Agente concluiu: $nome"; urg=normal
    fi
    corpo="${mensagem:-sem mensagem}"
    if [[ -n "${JANGADA_ISOLADO:-}" ]]; then
      jangada_notificar -a jangada-agente -u "$urg" "$titulo" "$corpo"
    else
      # O bash de dentro recebe a função pelo ambiente.
      export -f jangada_notificar
      setsid -f bash -c '
        r="$(jangada_notificar -a jangada-agente -u "$1" -A abrir=Abrir "$2" "$3")"
        [[ "$r" == "abrir" && -n "$5" ]] && "$4/jangada-agentes" --focar "$5"
      ' _ "$urg" "$titulo" "$corpo" "$dir_bin" "$sessao" >/dev/null 2>&1
    fi
  fi
} >/dev/null 2>&1

exit 0
