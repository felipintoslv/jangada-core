#!/usr/bin/env bash
# Configuração do jangada-core. Carrega as preferências do Core. Uso em outros scripts:
#   source "$(dirname "$0")/jangada-config"
# Executado diretamente, mostra os valores efetivos.

JANGADA_CORE_PATH="${JANGADA_CORE_PATH:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}"
JANGADA_CONFIG="${XDG_CONFIG_HOME:-$HOME/.config}/jangada"
JANGADA_ESTADO="${XDG_STATE_HOME:-$HOME/.local/state}/jangada"
# Pasta dos arquivos de estado das sessões de agente. Sempre derivada do
# JANGADA_ESTADO, para quem consome o estado receber o caminho em vez de montá-lo.
JANGADA_SESSOES="$JANGADA_ESTADO/agentes"
# Pasta de importação dos pacotes Python do Core. Sempre derivada do
# JANGADA_CORE_PATH, para um valor herdado de outra cópia não trocar o código lido.
JANGADA_CORE_PY="$JANGADA_CORE_PATH"

# Valores padrão, substituídos pelo arquivo do usuário se ele existir.
JANGADA_AGENTE=claude
JANGADA_AGENTE_ARGS=
JANGADA_VALIDAR_REVISOR="${JANGADA_VALIDAR_REVISOR:-}"
# Agente dentro do bubblewrap (jangada-isolar): 1 liga, 0 desliga. Pastas a
# mais que o agente pode gravar, separadas por ":". O JANGADA_ISOLAR_OCULTAR
# fica sem valor padrão de propósito: ausente, o jangada-isolar usa a lista
# dele; definido, mesmo vazio, substitui a lista.
JANGADA_AGENTE_ISOLAR="${JANGADA_AGENTE_ISOLAR:-1}"
JANGADA_ISOLAR_ESCRITA="${JANGADA_ISOLAR_ESCRITA:-}"
JANGADA_DELEGAR="${JANGADA_DELEGAR:-agy}"
JANGADA_PROJETOS="$HOME/Projetos"
JANGADA_WORKTREES="$HOME/.local/share/jangada-worktrees"
# Cópia de trabalho do jangada-core (onde se edita e faz commit). Vazio =
# $JANGADA_PROJETOS/jangada, se existir, ou o origin da cópia instalada, se for
# uma pasta local.
JANGADA_REPO=
# Ramo que o jangada-update acompanha na cópia instalada: main (tudo o que
# entrou) ou estavel (só o que foi marcado como testado).
JANGADA_CANAL=main
# Chave SSH com que o jangada-assinar assina os commits (a pública ao lado,
# com .pub).
JANGADA_ASSINATURA_CHAVE="$HOME/.ssh/id_ed25519"
# Executor econômico Codex, desabilitado sem modelo explicitamente escolhido.
JANGADA_CODEX_ECONOMICO_MODELO="${JANGADA_CODEX_ECONOMICO_MODELO:-}"
JANGADA_CODEX_PRINCIPAL_MODELO="${JANGADA_CODEX_PRINCIPAL_MODELO:-}"
JANGADA_CODEX_COTA_MIN="${JANGADA_CODEX_COTA_MIN:-25}"
# Modelos do agy na delegação, em ordem de tentativa: o seguinte entra quando
# a cota do anterior acaba. Os gemini-* dividem uma cota; os demais, outra.
JANGADA_DELEGAR_MODELOS="${JANGADA_DELEGAR_MODELOS:-gemini-3.8-flash-high claude-sonnet-5-5-high gpt-oss-120b-medium}"
# Delegação local explicitamente escolhida, para leitor e redator.
JANGADA_LOCAL_MODELO="${JANGADA_LOCAL_MODELO:-qwen3:4b}"
JANGADA_LOCAL_CTX="${JANGADA_LOCAL_CTX:-8192}"
JANGADA_LOCAL_VRAM_MIN="${JANGADA_LOCAL_VRAM_MIN:-4000}"
JANGADA_LOCAL_KEEP_ALIVE="${JANGADA_LOCAL_KEEP_ALIVE:-2m}"
JANGADA_LOCAL_ESPERA="${JANGADA_LOCAL_ESPERA:-30}"
JANGADA_OLLAMA_URL="${JANGADA_OLLAMA_URL:-http://localhost:11434}"
JANGADA_LOCAL_FATIAS_MAX="${JANGADA_LOCAL_FATIAS_MAX:-5}"

if [[ -f "$JANGADA_CONFIG/jangada.conf" ]]; then
  # Lê só linhas CHAVE=valor com chaves JANGADA_*, sem executar o arquivo.
  while IFS='=' read -r _chave _valor; do
    [[ "$_chave" =~ ^JANGADA_[A-Z_]+$ ]] || continue
    _valor="${_valor/#\$HOME/$HOME}"
    _valor="${_valor/#\~/$HOME}"
    printf -v "$_chave" '%s' "$_valor"
  done < <(sed -e 's/^[[:space:]]*#.*//' -e 's/[[:space:]]*$//' "$JANGADA_CONFIG/jangada.conf")
  unset _chave _valor
fi
if [[ -z "$JANGADA_REPO" && -d "$JANGADA_PROJETOS/jangada/.git" ]]; then
  JANGADA_REPO="$JANGADA_PROJETOS/jangada"
fi
# Máquina com os projetos em outra pasta: a cópia instalada foi clonada da de
# trabalho, então o origin dela, quando é uma pasta local, é a cópia de trabalho.
if [[ -z "$JANGADA_REPO" && -f "$JANGADA_CORE_PATH/.git/config" ]]; then
  _origem="$(git config -f "$JANGADA_CORE_PATH/.git/config" remote.origin.url 2>/dev/null || true)"
  [[ "$_origem" == /* && -d "$_origem/.git" ]] && JANGADA_REPO="$_origem"
  unset _origem
fi

export JANGADA_CODEX_ECONOMICO_MODELO JANGADA_CODEX_PRINCIPAL_MODELO JANGADA_CODEX_COTA_MIN JANGADA_DELEGAR_MODELOS
export JANGADA_CORE_PATH JANGADA_CORE_PY JANGADA_CONFIG JANGADA_ESTADO JANGADA_SESSOES \
  JANGADA_AGENTE JANGADA_AGENTE_ARGS JANGADA_VALIDAR_REVISOR JANGADA_PROJETOS JANGADA_WORKTREES \
  JANGADA_REPO JANGADA_CANAL JANGADA_AGENTE_ISOLAR JANGADA_ISOLAR_ESCRITA JANGADA_DELEGAR \
  JANGADA_ASSINATURA_CHAVE JANGADA_LOCAL_MODELO JANGADA_LOCAL_CTX JANGADA_LOCAL_VRAM_MIN \
  JANGADA_LOCAL_KEEP_ALIVE JANGADA_LOCAL_ESPERA JANGADA_OLLAMA_URL JANGADA_LOCAL_FATIAS_MAX
# Só quando definido: ausente e vazio têm sentidos diferentes no jangada-isolar.
if [[ -n "${JANGADA_ISOLAR_OCULTAR+x}" ]]; then export JANGADA_ISOLAR_OCULTAR; fi
if [[ -n "${JANGADA_ISOLAR_OCULTAR_EXTRA+x}" ]]; then export JANGADA_ISOLAR_OCULTAR_EXTRA; fi

# Perfil de agente: ~/.config/jangada/agentes/NOME.conf, com linhas CHAVE=valor.
# COMANDO e ARGS montam o comando; qualquer outra chave em maiúsculas vira
# variável de ambiente da sessão (por exemplo ANTHROPIC_MODEL). O arquivo é
# lido, não executado. Preenche PERFIL_COMANDO, PERFIL_ARGS e PERFIL_AMBIENTE
# (lista de CHAVE=valor); falha se o perfil não existir.
# shellcheck disable=SC2034  # PERFIL_* são lidas por quem carrega este arquivo
jangada_perfil() {
  local _arq="$JANGADA_CONFIG/agentes/$1.conf" _chave _valor
  PERFIL_COMANDO=""; PERFIL_ARGS=""; PERFIL_DESCRICAO=""; PERFIL_AMBIENTE=()
  [[ "$1" =~ ^[A-Za-z0-9_-]+$ ]] || return 1
  # O perfil do usuário tem precedência; sem ele, vale o do repositório
  # (agentes/perfis), como o agy.conf.
  [[ -r "$_arq" ]] || _arq="$JANGADA_CORE_PATH/agentes/perfis/$1.conf"
  [[ -r "$_arq" && "$1" != exemplo ]] || return 1
  while IFS='=' read -r _chave _valor; do
    [[ "$_chave" =~ ^[A-Z_][A-Z0-9_]*$ ]] || continue
    _valor="${_valor/#\$HOME/$HOME}"
    _valor="${_valor/#\~/$HOME}"
    case "$_chave" in
      COMANDO) PERFIL_COMANDO="$_valor" ;;
      ARGS) PERFIL_ARGS="$_valor" ;;
      DESCRICAO) PERFIL_DESCRICAO="$_valor" ;;
      *) PERFIL_AMBIENTE+=("$_chave=$_valor") ;;
    esac
  done < <(sed -e 's/^[[:space:]]*#.*//' -e 's/[[:space:]]*$//' "$_arq")
  [[ -n "$PERFIL_COMANDO" ]] || PERFIL_COMANDO="$JANGADA_AGENTE"
}

# Os argumentos do modelo saem somente do contrato fechado do piloto.
jangada_modelos_tarefa() {
  local autor="$1" revisor="$2" am="${3:-${JANGADA_AUTOR_MODELO:-}}" ae="${4:-${JANGADA_AUTOR_ESFORCO:-}}"
  local rm="${5:-${JANGADA_VALIDAR_MODELO:-}}" re="${6:-${JANGADA_VALIDAR_ESFORCO:-}}" v
  for v in "${PERFIL_AMBIENTE[@]}"; do
    case "$v" in
      JANGADA_AUTOR_MODELO=*) am="${3:-${v#*=}}" ;;
      JANGADA_AUTOR_ESFORCO=*) ae="${4:-${v#*=}}" ;;
      JANGADA_VALIDAR_MODELO=*) rm="${5:-${v#*=}}" ;;
      JANGADA_VALIDAR_ESFORCO=*) re="${6:-${v#*=}}" ;;
    esac
  done
  [[ -z "${3:-}" || -n "${4:-}" ]] || ae=""
  [[ -z "${5:-}" || -n "${6:-}" ]] || re=""
  python3 "$JANGADA_CORE_PATH/delegacao/modelos.py" "$autor" "$revisor" "$am" "$ae" "$rm" "$re"
}

jangada_modelo_argumentos() {
  local selecao="$1" provedor="$2" modelo esforco
  [[ "$selecao" != '{}' ]] || return 0
  jq -e '.autor.modelo | type == "string" and length > 0' <<<"$selecao" >/dev/null || return 1
  modelo="$(jq -r '.autor.modelo' <<<"$selecao")"
  esforco="$(jq -r '.autor.esforco' <<<"$selecao")"
  printf ' --model %q' "$modelo"
  if [[ "$provedor" == codex ]]; then
    printf ' -c %q' "model_reasoning_effort=\"$esforco\""
  else
    printf ' --effort %q' "$esforco"
  fi
}

# Destino dos subagentes: agy por padrão para Claude e Codex.
# Escolhas explícitas locais são preservadas; falta do agy não troca o destino.
# O destino nativo só atende à restauração de sessões antigas do agy.
jangada_delegacao() {
  local _base _valor="${2:-agy}"
  _base="$(basename "${1%% *}")"
  if [[ "$_base" == agy ]]; then
    echo nativo
    return 0
  fi
  if [[ "$_base" == codex ]]; then
    [[ "$_valor" == local ]] && { echo local; return 0; }
    echo agy
    return 0
  fi
  case "$_valor" in
    agy|claude|local) ;;
    nativo) _valor=claude ;;
    *) _valor=agy ;;
  esac
  echo "$_valor"
}

jangada_candidatos() {
  local politica="$JANGADA_CONFIG/delegacao.json"
  [[ -f "$politica" ]] || politica="$JANGADA_CORE_PATH/delegacao/roteamento.json"
  jq -er --arg capacidade "$1" '
    if type == "object"
      and (keys - ["leitura_documental", "resumo_curto", "analise_documental"] | length == 0)
      and all(.[]; type == "array" and length > 0
        and length == (unique | length) and all(.[]; . == "local" or . == "agy" or . == "codex-economico"))
      and has($capacidade)
    then .[$capacidade][]
    else error("política de delegação inválida ou capacidade ausente") end
  ' "$politica"
}

jangada_revisor() {
  local base
  base="$(basename "${1%% *}")"
  case "${2:-}" in
    mesmo) echo "$base" ;;
    oposto|"")
      [[ "$base" == agy || "$base" == codex || -z "$base" ]] && echo claude || echo codex
      ;;
    *) echo "$2" ;;
  esac
}

jangada_perfis() {
  local _a
  for _a in "$JANGADA_CONFIG"/agentes/*.conf "$JANGADA_CORE_PATH"/agentes/perfis/*.conf; do
    [[ -e "$_a" ]] && basename "$_a" .conf
  done | grep -vx exemplo | sort -u
  return 0
}

# Registro de provedores: um arquivo CHAVE=valor por provedor, em
# ~/.config/jangada/provedores (tem precedência) ou em provedores. O
# arquivo é lido, não executado, e nada dele vai para o ambiente do agente.
# Preenche PROVEDOR_NOME, PROVEDOR_TIPO, PROVEDOR_COMANDO, PROVEDOR_FUNCOES,
# PROVEDOR_PROTOCOLO_ARG, PROVEDOR_MODELO_REVISOR e PROVEDOR_RESERVA; falha se
# o provedor não existir ou tiver chave inválida. PROTOCOLO_ARG entra numa
# linha de comando, por isso só aceita o formato de uma opção.
# shellcheck disable=SC2034  # PROVEDOR_* são lidas por quem carrega este arquivo
jangada_provedor() {
  local _arq="$JANGADA_CONFIG/provedores/$1.conf" _chave _valor
  PROVEDOR_NOME=""; PROVEDOR_TIPO=""; PROVEDOR_COMANDO=""; PROVEDOR_FUNCOES=""
  PROVEDOR_PROTOCOLO_ARG=""; PROVEDOR_MODELO_REVISOR=""; PROVEDOR_RESERVA=""
  [[ "$1" =~ ^[A-Za-z0-9_-]+$ ]] || return 1
  [[ -r "$_arq" ]] || _arq="$JANGADA_CORE_PATH/provedores/$1.conf"
  [[ -r "$_arq" ]] || return 1
  while IFS='=' read -r _chave _valor || [[ -n "$_chave" ]]; do
    case "$_chave" in
      NOME) PROVEDOR_NOME="$_valor" ;;
      TIPO) PROVEDOR_TIPO="$_valor" ;;
      FUNCOES) PROVEDOR_FUNCOES="$_valor" ;;
      PROTOCOLO_ARG) PROVEDOR_PROTOCOLO_ARG="$_valor" ;;
      MODELO_REVISOR) PROVEDOR_MODELO_REVISOR="$_valor" ;;
      RESERVA) PROVEDOR_RESERVA="$_valor" ;;
    esac
  done < <(sed -e 's/^[[:space:]]*#.*//' -e 's/[[:space:]]*$//' "$_arq")
  # Em cli o executável é o nome do provedor: a sessão e a revisão chamam o
  # programa por esse nome, e uma chave à parte poderia divergir dele.
  case "$PROVEDOR_TIPO" in
    cli) PROVEDOR_COMANDO="$1" ;;
    ollama) ;;
    *) return 1 ;;
  esac
  [[ "$PROVEDOR_FUNCOES" =~ ^((principal|coordenador|revisor|delegacao)( |$))+$ ]] || return 1
  # Só um programa de linha de comando abre sessão.
  [[ "$PROVEDOR_TIPO" == cli || ( " $PROVEDOR_FUNCOES " != *" principal "* && " $PROVEDOR_FUNCOES " != *" coordenador "* ) ]] || return 1
  [[ "$PROVEDOR_PROTOCOLO_ARG" =~ ^(--?[a-z][a-z0-9-]*)?$ ]] || return 1
  [[ "$PROVEDOR_MODELO_REVISOR" =~ ^[A-Za-z0-9_.:-]*$ ]] || return 1
  [[ "$PROVEDOR_RESERVA" =~ ^[0-9]*$ ]] || return 1
  [[ -n "$PROVEDOR_NOME" ]] || PROVEDOR_NOME="$1"
}

# Catálogo de dados, nunca código. Pastas distintas não podem se sobrepor nem
# usar links: ocultar um nome alternativo não oculta o destino de um link.
jangada_contas_agy() {
  python3 -I - "$JANGADA_ESTADO/contas/agy.json" "$HOME" <<'PY'
import json, os, pathlib, re, sys
try:
    arquivo, casa = map(pathlib.Path, sys.argv[1:])
    if not arquivo.exists() and not arquivo.is_symlink():
        print("principal\t" + str(casa / ".gemini/antigravity-cli") + "\ttrue")
        sys.exit()
    contas = json.loads(arquivo.read_text())
    if not isinstance(contas, list) or not contas:
        raise ValueError("esperada lista não vazia")
    nomes, pastas = set(), []
    principal = casa / ".gemini/antigravity-cli"
    area = arquivo.parent
    # Um link em qualquer parte do caminho da área desviaria as escritas para fora dela.
    if area.resolve() != area:
        raise ValueError("a pasta de contas do estado não pode ter links no caminho")
    for conta in contas:
        nome, pasta, argon = conta["nome"], conta["pasta"], conta["argon"]
        if not isinstance(nome, str) or not re.fullmatch(r"[A-Za-z0-9_-]+", nome) or nome in nomes:
            raise ValueError("nome inválido ou repetido")
        if not isinstance(pasta, str) or any(ord(c) < 32 for c in pasta) or type(argon) is not bool:
            raise ValueError("pasta ou indicação de Argon inválida")
        p = pathlib.Path(pasta)
        if not p.is_absolute() or str(p.resolve()) != pasta or ":" in pasta:
            raise ValueError("pasta precisa ser absoluta, sem links ou dois-pontos")
        # O jangada grava na pasta da conta (confiança, bin): só a principal e a
        # área de contas do próprio estado entram, sem exceção nova na regra 1.
        if p != principal and not (p != area and p.is_relative_to(area)):
            raise ValueError("a pasta de cada conta precisa ser " + str(principal) + " ou ficar dentro de " + str(area))
        # Uma conta não pode encobrir a casa nem a pasta de estado inteira.
        protegidos = [casa, arquivo.parent, pathlib.Path.cwd(), pathlib.Path(os.environ["JANGADA_CORE_PATH"])]
        if any(q == p or q.is_relative_to(p) for q in protegidos):
            raise ValueError("pasta da conta encobre o projeto ou o estado")
        if any(p == q or p.is_relative_to(q) or q.is_relative_to(p) for q in pastas):
            raise ValueError("pastas de contas sobrepostas")
        nomes.add(nome)
        pastas.append(p)
    for conta in contas:
        print(conta["nome"], conta["pasta"], str(conta["argon"]).lower(), sep="\t")
except (OSError, ValueError, KeyError, TypeError) as erro:
    sys.exit("catálogo de contas do agy inválido: " + str(erro))
PY
}

# Preenche CONTA_AGY_{NOME,PASTA,ARGON}. Sem catálogo, preserva a conta antiga.
# shellcheck disable=SC2034  # CONTA_AGY_* são lidas por quem carrega este arquivo
jangada_conta_agy() {
  local nome="${1:-${JANGADA_AGY_CONTA:-}}" contas n p a
  contas="$(jangada_contas_agy)" || return 1
  [[ -n "$nome" ]] || nome="${contas%%$'\t'*}"
  while IFS=$'\t' read -r n p a; do
    if [[ "$n" == "$nome" ]]; then
      CONTA_AGY_NOME="$n"; CONTA_AGY_PASTA="$p"; CONTA_AGY_ARGON="$a"
      return 0
    fi
  done <<<"$contas"
  echo "conta do agy inexistente: $nome" >&2
  return 1
}

# Nomes dos provedores válidos do registro; com FUNCAO, só os que a declaram.
jangada_provedores() {
  local _a _n
  for _a in "$JANGADA_CONFIG"/provedores/*.conf "$JANGADA_CORE_PATH"/provedores/*.conf; do
    [[ -e "$_a" ]] && basename "$_a" .conf
  done | sort -u | while read -r _n; do
    jangada_provedor "$_n" || continue
    [[ -n "${1:-}" && " $PROVEDOR_FUNCOES " != *" $1 "* ]] || echo "$_n"
  done
  return 0
}

# Gera carimbo de data ISO 8601 consistente e universal.
jangada_data_iso() {
  if date -Is >/dev/null 2>&1; then
    date -Is
  else
    local d z
    d="$(date +"%Y-%m-%dT%H:%M:%S")"
    z="$(date +"%z")"
    if [[ "$z" =~ ^([+-][0-9]{2})([0-9]{2})$ ]]; then
      echo "${d}${BASH_REMATCH[1]}:${BASH_REMATCH[2]}"
    else
      echo "${d}Z"
    fi
  fi
}

# Acrescenta uma linha ao histórico de estados dos agentes
# ($JANGADA_ESTADO/eventos-agentes.jsonl), para consulta do histórico.
# Uso: jangada_registrar_evento SESSAO PROJETO AGENTE ESTADO [EXTRA]. EXTRA é
# um objeto JSON com campos a mais, acrescentados depois dos cinco de sempre.
# Nunca falha: é chamado de dentro dos hooks. Uma linha curta com >> é gravada
# inteira mesmo com dois hooks ao mesmo tempo.
# Anexa LINHA a ARQUIVO sob trava. O printf do bash divide uma linha grande em
# várias escritas, e dois processos anexando juntos misturavam os pedaços. A
# trava é o próprio arquivo aberto para leitura, que o agente isolado também
# alcança. Sem a trava em 5 s, a linha é gravada assim mesmo: registro não
# segura quem chama.
jangada_anexar_linha() {
  [[ -e "$1" ]] || : 2>/dev/null >>"$1" || return 1
  if command -v flock >/dev/null 2>&1; then
    (
      flock -w 5 9 || true
      printf '%s\n' "$2" >>"$1"
    ) 9<"$1" 2>/dev/null
  else
    printf '%s\n' "$2" 2>/dev/null >>"$1"
  fi
}

jangada_registrar_evento() {
  local linha execucao
  execucao="$(jq -r '.execucao // ""' "$JANGADA_ESTADO/agentes/$1.json" 2>/dev/null || true)"
  [[ "$execucao" =~ ^exe-[0-9a-f]{16}$ ]] || execucao=""
  linha="$(jq -cn --arg d "$(jangada_data_iso)" --arg s "$1" --arg p "$2" --arg a "$3" --arg e "$4" \
    --arg execucao "$execucao" --arg x "${5:-}" '{data: $d, sessao: $s, projeto: $p, agente: $a, estado: $e,
      execucao: (if $execucao == "" then null else $execucao end)}
      + (($x | fromjson? | objects) // {})' 2>/dev/null)" || return 0
  [[ -n "$linha" ]] || return 0
  jangada_anexar_linha "$JANGADA_ESTADO/eventos-agentes.jsonl" "$linha" || true
  return 0
}

# git para rodar fora do isolamento sobre pastas que um agente pode gravar:
# desliga o fsmonitor e os hooks que uma configuração plantada definiria.
# É defesa a mais: a principal é o jangada-isolar manter somente leitura
# o que o git lê como configuração (config, commondir, gitdir).
_jangada_git_blindagem=(core.fsmonitor=false core.hooksPath=/dev/null core.sshCommand=ssh
  core.pager=cat safe.bareRepository=explicit)
jangada_git_seguro() {
  local c args=()
  for c in "${_jangada_git_blindagem[@]}"; do args+=(-c "$c"); done
  git "${args[@]}" "$@"
}

# Espelho do repositório cuja pasta .git comum é COMUM, em revisoes/, que o
# isolamento oculta. O agente grava em .git/objects e o git não reconfere o
# hash de um objeto solto ao ler; o que entra no espelho vem por fetch, que
# recalcula o hash de cada objeto. Imprime o caminho (use com --git-dir).
jangada_espelho() {
  local dir
  dir="$JANGADA_ESTADO/revisoes/espelhos/$(printf '%s' "$1" | sha256sum | cut -c1-16).git"
  if [[ ! -d "$dir" ]]; then
    (umask 077; mkdir -p "${dir%/*}" && git init -q --bare -b espelho --template= "$dir") || return 1
  fi
  printf '%s\n' "$dir"
}

# O mesmo para todo git que o script e os filhos rodarem, pelas variáveis
# GIT_CONFIG_KEY_N/GIT_CONFIG_VALUE_N (valem como -c).
jangada_git_blindar() {
  local c n="${GIT_CONFIG_COUNT:-0}"
  [[ "$n" =~ ^[0-9]+$ ]] || n=0
  for c in "${_jangada_git_blindagem[@]}"; do
    export "GIT_CONFIG_KEY_$n=${c%%=*}" "GIT_CONFIG_VALUE_$n=${c#*=}"
    n=$((n + 1))
  done
  export GIT_CONFIG_COUNT="$n"
}

# Obtém trava baseada em diretório com verificação de bloqueio abandonado.
_jangada_trava_obter() {
  local trava_dir="$1" i=0
  while (( i < 50 )); do
    if mkdir "$trava_dir" 2>/dev/null; then
      return 0
    fi
    if [[ -d "$trava_dir" ]]; then
      local mtime agora
      mtime="$(stat -c %Y "$trava_dir" 2>/dev/null || stat -f %m "$trava_dir" 2>/dev/null || echo 0)"
      agora="$(date +%s)"
      if (( mtime > 0 && agora - mtime > 15 )); then
        rmdir "$trava_dir" 2>/dev/null || true
      fi
    fi
    sleep 0.1
    i=$((i + 1))
  done
  return 1
}

# Põe ORIGEM no lugar de DESTINO com rename, para ninguém ler o arquivo pela
# metade nem sobrar arquivo truncado numa interrupção. A pasta do destino pode
# ser gravável pelo agente isolado: nada é criado nem regravado nela, e o
# rename (mv -T) troca o próprio link em vez de segui-lo, mesmo que aponte
# para uma pasta. Sem poder renomear, falha.
jangada_gravar_atomico() {
  chmod --reference="$2" "$1" 2>/dev/null || true
  mv -fT -- "$1" "$2" 2>/dev/null
}

# O settings.json é do agy e do usuário: a primeira alteração do jangada
# guarda o original, que nunca é sobrescrito. Roda sob a trava, para não
# copiar o arquivo no meio de outra regravação.
_jangada_agy_guardar_original() {
  [[ -e "$1.jangada-orig" ]] || cp -a "$1" "$1.jangada-orig" 2>/dev/null || true
}

# Diz se o agy confia na pasta. O agy pode ter gravado o caminho com o link
# simbólico por onde a pasta foi aberta, então vale o caminho resolvido ou o
# original.
jangada_agy_confia() {
  local CONTA_AGY_PASTA
  jangada_conta_agy || return 1
  local conf_agy="${JANGADA_AGY_SETTINGS:-$CONTA_AGY_PASTA/settings.json}"
  jq -e --arg w "$(realpath "$1" 2>/dev/null || echo "$1")" --arg o "$1" \
    '(.trustedWorkspaces // []) as $t | ($t | index($w)) or ($t | index($o))' "$conf_agy" >/dev/null 2>&1
}

# Adiciona ou remove caminho de trustedWorkspaces no settings.json do Antigravity.
# Mantém travas e arquivos de trabalho isolados em JANGADA_ESTADO e preserva permissões.
jangada_agy_ajustar_confianca() {
  local modo="$1" caminho="$2"
  local CONTA_AGY_PASTA
  if [[ "$modo" == remover && -f "$JANGADA_ESTADO/contas/agy.json" && -z "${JANGADA_AGY_CONTA:-}${JANGADA_AGY_SETTINGS:-}" ]]; then
    local contas nome _pasta _argon
    contas="$(jangada_contas_agy)" || return 1
    while IFS=$'\t' read -r nome _pasta _argon; do
      (export JANGADA_AGY_CONTA="$nome"; jangada_agy_ajustar_confianca "$modo" "$caminho") || return 1
    done <<<"$contas"
    return 0
  fi
  jangada_conta_agy || return 1
  local conf_agy="${JANGADA_AGY_SETTINGS:-$CONTA_AGY_PASTA/settings.json}"
  # Com catálogo, a escrita só vai ao settings.json da conta escolhida ou ao
  # caminho da caixa, onde ela está montada, nunca a outro arquivo.
  if [[ -f "$JANGADA_ESTADO/contas/agy.json" && -n "${JANGADA_AGY_SETTINGS:-}" \
        && "$conf_agy" != "$CONTA_AGY_PASTA/settings.json" \
        && "$conf_agy" != "$HOME/.gemini/antigravity-cli/settings.json" ]]; then
    echo "JANGADA_AGY_SETTINGS fora da conta escolhida do agy: $conf_agy" >&2
    return 1
  fi
  # A pasta do arquivo é gravável pelo agente isolado: um link ali levaria
  # esta escrita, feita também de fora do isolamento, a outro arquivo.
  [[ -f "$conf_agy" && ! -L "$conf_agy" && -w "$conf_agy" && -n "$caminho" ]] || return 0

  mkdir -p "$JANGADA_ESTADO"
  local caminho_real
  caminho_real="$(realpath "$caminho" 2>/dev/null || echo "$caminho")"

  local trava="$JANGADA_ESTADO/.trava-agy"
  local tmp
  tmp="$(mktemp "$JANGADA_ESTADO/settings.agy.XXXXXX" 2>/dev/null)" || return 0

  local filtro
  if [[ "$modo" == "adicionar" ]]; then
    filtro='if (.trustedWorkspaces | type == "array") then (if (.trustedWorkspaces | index($w)) then . else .trustedWorkspaces += [$w] end) else .trustedWorkspaces = [$w] end'
  else
    filtro='if (.trustedWorkspaces | type == "array") then .trustedWorkspaces |= map(select(. != $w and . != $w_orig)) else . end'
  fi

  if command -v flock >/dev/null 2>&1; then
    (
      flock -w 5 9 2>/dev/null || exit 1
      _jangada_agy_guardar_original "$conf_agy"
      if jq --arg w "$caminho_real" --arg w_orig "$caminho" "$filtro" "$conf_agy" >"$tmp" 2>/dev/null; then
        jangada_gravar_atomico "$tmp" "$conf_agy" || true
      fi
      rm -f "$tmp"
    ) 9>"$trava" 2>/dev/null || rm -f "$tmp"
  else
    local trava_d="$JANGADA_ESTADO/.trava-agy.d"
    if _jangada_trava_obter "$trava_d"; then
      _jangada_agy_guardar_original "$conf_agy"
      if jq --arg w "$caminho_real" --arg w_orig "$caminho" "$filtro" "$conf_agy" >"$tmp" 2>/dev/null; then
        jangada_gravar_atomico "$tmp" "$conf_agy" || true
      fi
      rm -f "$tmp"
      rmdir "$trava_d" 2>/dev/null || true
    else
      rm -f "$tmp"
      return 0
    fi
  fi
  return 0
}

# Diz se WORKTREE é worktree registrado do repositório cuja pasta de trabalho
# é RAIZ, pelo Git e pelos dois lados: a lista de worktrees lida na raiz e a
# pasta .git comum lida no worktree. Os caminhos chegam resolvidos. O estado
# da sessão é gravável pelo agente isolado e não entra nesta conferência.
_jangada_agy_worktree_da_raiz() {
  local raiz="$1" worktree="$2" linha topo comum_r comum_w achou=0
  for linha in "$raiz" "$worktree"; do
    topo="$(jangada_git_seguro -C "$linha" rev-parse --show-toplevel 2>/dev/null)" || return 1
    [[ "$(realpath -e -- "$topo" 2>/dev/null)" == "$linha" ]] || return 1
  done
  comum_r="$(jangada_git_seguro -C "$raiz" rev-parse --path-format=absolute --git-common-dir 2>/dev/null)" || return 1
  comum_w="$(jangada_git_seguro -C "$worktree" rev-parse --path-format=absolute --git-common-dir 2>/dev/null)" || return 1
  comum_r="$(realpath -e -- "$comum_r" 2>/dev/null)" && comum_w="$(realpath -e -- "$comum_w" 2>/dev/null)" || return 1
  [[ "$comum_r" == "$comum_w" ]] || return 1
  while IFS= read -r -d '' linha; do
    [[ "$linha" == "worktree "* ]] || continue
    [[ "$(realpath -e -- "${linha#worktree }" 2>/dev/null)" == "$worktree" ]] && achou=1
  done < <(jangada_git_seguro -C "$raiz" worktree list --porcelain -z 2>/dev/null)
  ((achou))
}

# Confiança derivada: WORKTREE entra em trustedWorkspaces só quando o agy já
# confia em RAIZ e o Git confirma que WORKTREE é worktree dela. A raiz nunca
# é gravada aqui: quem a autoriza é o usuário, na pergunta do próprio agy.
# Roda só fora do isolamento. Devolve 0 com o worktree confiável (conferido
# depois da gravação), 2 se o agy não confia na raiz, 3 se o worktree não
# corresponde à raiz, 4 se a gravação não foi confirmada e 5 no isolamento.
jangada_agy_sincronizar_worktree() {
  local raiz worktree
  [[ -z "${JANGADA_ISOLADO:-}" ]] || return 5
  if [[ -f "$JANGADA_ESTADO/contas/agy.json" && -z "${JANGADA_AGY_CONTA:-}${JANGADA_AGY_SETTINGS:-}" ]]; then
    local contas nome _pasta _argon r alguma=0
    contas="$(jangada_contas_agy)" || return 4
    while IFS=$'\t' read -r nome _pasta _argon; do
      r=0
      (export JANGADA_AGY_CONTA="$nome"; jangada_agy_sincronizar_worktree "$1" "$2") || r=$?
      case "$r" in
        0) alguma=1 ;;
        2) ;;
        *) return "$r" ;;
      esac
    done <<<"$contas"
    ((alguma)) || return 2
    return 0
  fi
  raiz="$(realpath -e -- "$1" 2>/dev/null)" && worktree="$(realpath -e -- "$2" 2>/dev/null)" || return 3
  [[ "$raiz" != "$worktree" ]] && _jangada_agy_worktree_da_raiz "$raiz" "$worktree" || return 3
  jangada_agy_confia "$raiz" || return 2
  jangada_agy_confia "$worktree" && return 0
  jangada_agy_ajustar_confianca adicionar "$worktree"
  jangada_agy_confia "$worktree" || return 4
}

# Valida o registro protegido da tarefa SESSAO (a cópia em revisoes/, que o
# agente isolado não grava) e deixa a raiz e o worktree dela, resolvidos, em
# JANGADA_AGY_REG_RAIZ e JANGADA_AGY_REG_WORKTREE; worktree vazio é sessão
# direta na raiz. Devolve 1 com registro ausente, ilegível, de outra sessão
# ou com campo de tipo errado: agente é texto não vazio, raiz é caminho
# absoluto de pasta que existe, worktree é nulo, vazio ou caminho absoluto, e
# delegar e revisor são nulos ou texto. Devolve 2 quando o worktree
# registrado não existe mais; a raiz fica resolvida e o worktree, como está
# no registro.
jangada_agy_registro_tarefa() {
  local copia="$JANGADA_ESTADO/revisoes/$1.json"
  JANGADA_AGY_REG_RAIZ=""; JANGADA_AGY_REG_WORKTREE=""
  [[ -f "$copia" && ! -L "$copia" ]] || return 1
  jq -e --arg s "$1" '
    def texto: type == "string";
    def caminho: texto and startswith("/");
    type == "object" and .sessao == $s
    and (.agente | texto and length > 0)
    and (.raiz | caminho)
    and (.worktree | . == null or . == "" or caminho)
    and (.delegar | . == null or texto)
    and (.revisor | . == null or texto)' "$copia" >/dev/null 2>&1 || return 1
  JANGADA_AGY_REG_RAIZ="$(realpath -e -- "$(jq -r '.raiz' "$copia")" 2>/dev/null)" || JANGADA_AGY_REG_RAIZ=""
  [[ -n "$JANGADA_AGY_REG_RAIZ" && -d "$JANGADA_AGY_REG_RAIZ" ]] || return 1
  JANGADA_AGY_REG_WORKTREE="$(jq -r '.worktree // ""' "$copia")"
  [[ -n "$JANGADA_AGY_REG_WORKTREE" ]] || return 0
  [[ -d "$JANGADA_AGY_REG_WORKTREE" ]] || return 2
  JANGADA_AGY_REG_WORKTREE="$(realpath -e -- "$JANGADA_AGY_REG_WORKTREE")"
}

# Diz se a tarefa SESSAO delega ou revisa pelo agy, pela cópia protegida da
# sessão, que o agente isolado não grava. Cópia antiga, sem o destino da
# delegação ou sem o revisor, vale o da configuração.
jangada_agy_tarefa_usa() {
  local copia="$JANGADA_ESTADO/revisoes/$1.json" agente delegar revisor
  agente="$(jq -er '.agente | strings' "$copia" 2>/dev/null)" || return 1
  delegar="$(jq -r '.delegar // "" | tostring' "$copia")"
  revisor="$(jq -r '.revisor // "" | tostring' "$copia")"
  [[ -n "$delegar" ]] || delegar="$(jangada_delegacao "$agente" "${JANGADA_DELEGAR:-}")"
  [[ -n "$revisor" ]] || revisor="$(jangada_revisor "$agente" "${JANGADA_VALIDAR_REVISOR:-}")"
  [[ "$delegar" == agy || "$revisor" == agy ]]
}

# Conferência da confiança do agy ao abrir ou retomar uma tarefa que delega
# ou revisa pelo agy. WORKTREE vazio é sessão direta na raiz. Com PERGUNTAR=1,
# terminal e agy instalado, oferece abrir o agy na raiz; a resposta à pergunta
# de confiança é do usuário, dentro do agy, e o que vale depois é o
# settings.json relido, nunca o tempo passado nem a saída do agy.
# Uso: jangada_agy_conferir_tarefa RAIZ WORKTREE PERGUNTAR SESSAO
# Devolve 0 se o agy atende na pasta da tarefa.
jangada_agy_conferir_tarefa() {
  local raiz="$1" worktree="$2" perguntar="$3" sessao="$4" r=0 resposta=""
  [[ -z "${JANGADA_ISOLADO:-}" ]] || return 0
  if [[ -f "$JANGADA_ESTADO/contas/agy.json" && -z "${JANGADA_AGY_CONTA:-}${JANGADA_AGY_SETTINGS:-}" ]]; then
    local contas nome _pasta _argon pendentes=0 linha
    local -a contas_conferencia=()
    contas="$(jangada_contas_agy)" || return 1
    mapfile -t contas_conferencia <<<"$contas"
    for linha in "${contas_conferencia[@]}"; do
      IFS=$'\t' read -r nome _pasta _argon <<<"$linha"
      echo "conferindo confiança do agy na conta $nome" >&2
      (export JANGADA_AGY_CONTA="$nome"; jangada_agy_conferir_tarefa "$raiz" "$worktree" "$perguntar" "$sessao") || pendentes=$((pendentes + 1))
    done
    ((pendentes < ${#contas_conferencia[@]})) \
      || echo "confiança do agy pendente em todas as contas: delegação e revisão pelo agy ficam indisponíveis nesta tarefa." >&2
    return $((pendentes > 0))
  fi
  _jangada_agy_conferir() {
    if [[ -n "$worktree" ]]; then
      "$JANGADA_CORE_PATH/bin/jangada-worktree-preparar" --so-confianca "$raiz" "$worktree" >/dev/null
    else
      jangada_agy_confia "$raiz" || return 2
    fi
  }
  if ! command -v agy >/dev/null 2>&1; then
    echo "agy não instalado: confiança da tarefa não conferida. Depois de instalar, rode: jangada-agentes --confianca $sessao" >&2
    return 1
  fi
  _jangada_agy_conferir || r=$?
  if ((r == 2)); then
    echo "o agy não confia na raiz $raiz" >&2
    if ((perguntar)) && [[ -t 0 && -t 2 ]]; then
      read -r -p "abrir o agy em $raiz para você responder à pergunta de confiança? [s/N] " resposta || resposta=""
      if [[ "$resposta" =~ ^[sS]$ ]]; then
        echo "responda à pergunta do agy e saia dele para continuar" >&2
        if [[ -f "$JANGADA_ESTADO/contas/agy.json" ]]; then
          jangada_conta_agy || return 1
          (cd "$raiz" && env -u JANGADA_SESSAO JANGADA_HOOK_DESLIGADO=1 \
            "$JANGADA_CORE_PATH/bin/jangada-isolar" --conta "$CONTA_AGY_NOME" -- agy) || true
        else
          (cd "$raiz" && env -u JANGADA_SESSAO JANGADA_HOOK_DESLIGADO=1 agy) || true
        fi
        r=0
        _jangada_agy_conferir || r=$?
      fi
    fi
  fi
  ((r == 0)) && return 0
  if [[ -f "$JANGADA_ESTADO/contas/agy.json" ]]; then
    local onde="configuração em JANGADA_AGY_SETTINGS"
    [[ -z "${JANGADA_AGY_CONTA:-}" ]] || onde="conta $JANGADA_AGY_CONTA"
    echo "confiança do agy pendente na $onde." >&2
  else
    echo "confiança do agy pendente: delegação e revisão pelo agy ficam indisponíveis nesta tarefa." >&2
  fi
  if ((r == 2)); then
    if [[ -f "$JANGADA_ESTADO/contas/agy.json" ]]; then
      echo "Na raiz $raiz, execute jangada-isolar --conta ${JANGADA_AGY_CONTA:-NOME} -- agy, responda à pergunta de confiança e rode: jangada-agentes --confianca $sessao" >&2
    else
      echo "Para retomar, abra o agy em $raiz, responda à pergunta de confiança e rode: jangada-agentes --confianca $sessao" >&2
    fi
  else
    echo "Para repetir a conferência, rode fora da sessão isolada: jangada-agentes --confianca $sessao" >&2
  fi
  return 1
}

# Executa comando ou função sob trava da pasta. A trava é a própria pasta
# aberta só para leitura: um arquivo de trava aberto para escrita seguiria um
# link simbólico posto pelo agente isolado e truncaria o alvo fora do isolamento.
# Uso: jangada_com_trava_dir DIR COMANDO [ARGUMENTOS...]
jangada_com_trava_dir() {
  local dir="$1"
  shift
  local rc=0
  if command -v flock >/dev/null 2>&1; then
    (
      flock -w 5 9 || exit 1
      "$@"
    ) 9<"$dir" || rc=$?
  else
    local trava_dir="$dir/.trava.d"
    if ! _jangada_trava_obter "$trava_dir"; then
      return 1
    fi
    "$@" || rc=$?
    rmdir "$trava_dir" 2>/dev/null || true
  fi
  return $rc
}

# Altera um arquivo de estado JSON com jq de forma atômica e segura: regrava
# com mv, sob uma trava da pasta. O hook do Claude Code roda em paralelo quando
# há ferramentas em paralelo, e o painel marca sessões interrompidas: sem a
# trava, quem lê antes e grava depois apaga o campo que o outro gravou.
# Uso: jangada_alterar_estado ARQ TMP ARGUMENTOS_DO_JQ...
jangada_alterar_estado() {
  local arq="$1" tmp="$2"
  [[ -n "$arq" && -n "$tmp" ]] || return 1
  shift 2
  local rc=0
  _aplicar_jq() {
    jq "$@" "$arq" >"$tmp" 2>/dev/null && mv "$tmp" "$arq"
  }
  jangada_com_trava_dir "$(dirname "$arq")" _aplicar_jq "$@" || rc=$?
  if ((rc == 0)); then
    jangada_avisar_interface estado-sessao
  fi
  return $rc
}

# Avisa a interface de que o estado do Core mudou (contrato K3). O sinal 10
# atualiza o módulo dos agentes da Waybar, se houver uma no ar. Sem Waybar (ou
# sem o programa), não faz nada e devolve 0.
# Uso: jangada_avisar_interface estado-sessao|fila|validacao
jangada_avisar_interface() {
  case "${1:-}" in
    estado-sessao | fila | validacao)
      if command -v waybar >/dev/null 2>&1; then pkill -RTMIN+10 -x waybar 2>/dev/null || true; fi ;;
    *) return 1 ;;
  esac
}

# Notificação do sistema (contrato K3). Só este corpo conhece o notify-send.
# Sem o programa ou sem serviço de notificação, não faz nada e devolve 0.
# Com -A, espera o clique e imprime a ação escolhida.
# Uso: jangada_notificar [-a APLICATIVO] [-u URGÊNCIA] [-A AÇÃO=RÓTULO] TÍTULO MENSAGEM
jangada_notificar() {
  local app=jangada opcoes=()
  while [[ "${1:-}" == -[auA] ]]; do
    if [[ "$1" == -a ]]; then app="$2"; else opcoes+=("$1" "$2"); fi
    shift 2
  done
  if command -v notify-send >/dev/null 2>&1; then
    notify-send -a "$app" "${opcoes[@]}" "$1" "$2" 2>/dev/null || true
  fi
}

# Abertura de interface e foco de janela (contrato K10). O terminal, a Central
# de Tarefas e o hyprctl são de outras aplicações (jangada-shell) e são
# procurados no PATH; a ausência é tratada sem erro. Sem sessão gráfica (sem WAYLAND_DISPLAY e sem HYPRLAND_INSTANCE_SIGNATURE),
# avisam na saída de erro e saem com 0.
_jangada_sem_grafico() {
  [[ -z "${WAYLAND_DISPLAY:-}${HYPRLAND_INSTANCE_SIGNATURE:-}" ]] || return 1
  echo "aviso: sem sessão gráfica; $1" >&2
}

# Abre o terminal com a classe CLASSE rodando COMANDO. Usa o jangada-terminal,
# se estiver no PATH; senão o programa de $TERMINAL (sem a classe); senão avisa
# na saída de erro e devolve 1. --exec substitui o processo e, sem sessão
# gráfica, encerra o script com 0; --solto deixa o terminal fora do processo,
# por setsid -f ou em segundo plano.
# Uso: jangada_abrir_terminal --exec|--solto CLASSE COMANDO...
jangada_abrir_terminal() {
  local modo="$1" classe="$2" t
  local -a term
  [[ "$modo" == --exec || "$modo" == --solto ]] || return 1
  shift 2
  if _jangada_sem_grafico "o terminal não foi aberto"; then
    [[ "$modo" == --solto ]] || exit 0
    return 0
  fi
  if command -v jangada-terminal >/dev/null 2>&1; then
    term=(jangada-terminal --classe "$classe" -e)
  elif [[ -n "${TERMINAL:-}" ]] && t="${TERMINAL%% *}" && command -v "$t" >/dev/null 2>&1; then
    read -r -a term <<<"$TERMINAL"
    term+=(-e)
  else
    echo "aviso: nenhum terminal encontrado (instale o jangada-shell ou defina TERMINAL)" >&2
    return 1
  fi
  if [[ "$modo" == --exec ]]; then
    exec "${term[@]}" "$@"
  elif command -v setsid >/dev/null 2>&1; then
    setsid -f "${term[@]}" "$@" >/dev/null 2>&1
  else
    "${term[@]}" "$@" >/dev/null 2>&1 &
  fi
}

# Abre a Central de Tarefas no lugar do processo; com --nova, no formulário
# de tarefa nova. Sem sessão gráfica, encerra o script com 0. Sem o
# jangada-tarefas no PATH, avisa e devolve 1.
# Uso: jangada_abrir_central [--nova]
jangada_abrir_central() {
  _jangada_sem_grafico "a Central não foi aberta" && exit 0
  if ! command -v jangada-tarefas >/dev/null 2>&1; then
    echo "aviso: Central de Tarefas não instalada (jangada-shell)" >&2
    return 1
  fi
  exec jangada-tarefas "$@"
}

# Imprime o título da janela ativa; fora do Hyprland, nada.
jangada_janela_ativa() {
  _jangada_sem_grafico "a janela ativa não foi lida" && return 0
  [[ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]] || return 0
  command -v hyprctl >/dev/null 2>&1 || return 0
  hyprctl activewindow -j 2>/dev/null | jq -r '.title // empty' 2>/dev/null || true
}

# Foca a janela cujo título é TÍTULO, ou começa por ele. Devolve 1 se não
# achar, para o chamador abrir o terminal, e 2 se o Hyprland recusar o foco.
# Uso: jangada_focar_janela TÍTULO
jangada_focar_janela() {
  local endereco=""
  _jangada_sem_grafico "a janela $1 não foi focada" && return 0
  if [[ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]] && command -v hyprctl >/dev/null 2>&1; then
    endereco="$(hyprctl clients -j 2>/dev/null | jq -r --arg s "$1" '(map(select(.title == $s)) + map(select(.title | startswith($s)))) | .[0].address // empty' 2>/dev/null || true)"
  fi
  [[ -n "$endereco" ]] || return 1
  hyprctl dispatch "hl.dsp.focus({ window = \"address:$endereco\" })" >/dev/null || return 2
}

# Socket próprio do tmux para as sessões de agentes, separado do tmux pessoal.
# shellcheck disable=SC2034  # usado pelos scripts que carregam este arquivo
JANGADA_TMUX=(tmux -L jangada -f "$JANGADA_CORE_PATH/agentes/tmux/agentes.conf")

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
  if [[ "${1:-}" == --publico-json ]]; then
    for _v in JANGADA_AGENTE JANGADA_DELEGAR JANGADA_VALIDAR_REVISOR; do
      _valor="${!_v}"; _valido=0
      case "$_v:$_valor" in
        JANGADA_DELEGAR:agy|JANGADA_DELEGAR:local|JANGADA_DELEGAR:claude|JANGADA_DELEGAR:nativo) _valido=1 ;;
        JANGADA_VALIDAR_REVISOR:mesmo|JANGADA_VALIDAR_REVISOR:oposto|JANGADA_VALIDAR_REVISOR:) _valido=1 ;;
        JANGADA_AGENTE:*|JANGADA_VALIDAR_REVISOR:*) jangada_provedor "$_valor" && _valido=1 ;;
      esac
      if ((_valido)); then
        jq -nc --arg chave "$_v" --arg valor "${!_v}" '{chave:$chave, valor:$valor}'
      else
        jq -nc --arg chave "$_v" '{chave:$chave, valor:null}'
      fi
    done | jq -s --arg arquivo "$JANGADA_CONFIG/jangada.conf" '{arquivo:$arquivo, valores:.}'
    exit 0
  fi
  if [[ "${1:-}" == --provedores-json ]]; then
    while read -r _n; do
      jangada_provedor "$_n" || continue
      jq -nc --arg id "$_n" --arg nome "$PROVEDOR_NOME" --arg tipo "$PROVEDOR_TIPO" \
        --arg funcoes "$PROVEDOR_FUNCOES" --arg modelo "$PROVEDOR_MODELO_REVISOR" \
        --argjson instalado "$(command -v "$PROVEDOR_COMANDO" >/dev/null 2>&1 && echo true || echo false)" \
        --arg protocolo "$PROVEDOR_PROTOCOLO_ARG" \
        '{id:$id, nome:$nome, tipo:$tipo, instalado:$instalado, funcoes:($funcoes | split(" ") | map(select(. != ""))),
          modelo_revisor:(if $modelo == "" then null else $modelo end), protocolo_arg:$protocolo}'
    done < <(jangada_provedores "") | jq -s .
    exit 0
  fi
  for _v in JANGADA_CORE_PATH JANGADA_CONFIG JANGADA_ESTADO \
    JANGADA_AGENTE JANGADA_AGENTE_ARGS JANGADA_VALIDAR_REVISOR JANGADA_PROJETOS JANGADA_WORKTREES \
    JANGADA_REPO JANGADA_CANAL JANGADA_AGENTE_ISOLAR JANGADA_ISOLAR_ESCRITA JANGADA_DELEGAR \
    JANGADA_ASSINATURA_CHAVE; do
    printf '%s=%s\n' "$_v" "${!_v}"
  done
fi
