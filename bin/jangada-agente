#!/usr/bin/env bash
# Escolhe um projeto, cria um worktree (opcional) e abre um agente numa sessão tmux.
#
# Uso: jangada-agente [opções] [-- argumentos extras para o agente]
#   --janela          sem opções, abre Nova tarefa; com opções, abre o agente num terminal
#   --projeto DIR     pula o seletor e usa este diretório
#   --nome NOME       nome da tarefa; cria o worktree agente/NOME
#   --direto          trabalha no próprio repositório, sem worktree
#   --snapshot        cria um snapshot do sistema antes de iniciar
#   --agente CMD      usa outro agente (padrão: JANGADA_AGENTE, hoje "claude")
#   --perfis          lista os perfis disponíveis em JSON
#   --capacidades-json  agentes que abrem sessão principal (com "instalado") e perfis, em JSON
#   --perfil NOME     usa o perfil NOME (~/.config/jangada/agentes/NOME.conf ou,
#                     sem ele, agentes/perfis/NOME.conf)
#   --delegacao NOME  destino explícito da delegação (local, agy ou claude)
#   --autor-modelo M   gpt-6-luna, gpt-6.1-sol, sonnet ou opus (por tarefa)
#   --autor-esforco E medium no Luna; high nos demais
#   --revisor-modelo M opus para autor Codex; gpt-6.1-sol para autor Claude
#   --revisor-esforco E high no piloto
#   --revisor NOME    revisor para jangada-validar (claude, agy, codex, mesmo ou oposto)
#   --coordenador NOME  quem coordena a tarefa (padrão: JANGADA_COORDENADOR ou "dono"); só exibição
#   --prompt TEXTO    tarefa inicial, entregue ao agente ao abrir
#   --prompt-arquivo ARQ  o mesmo, lida de um arquivo
#   --conta-agy NOME  conta do agy da sessão (só com o catálogo contas/agy.json)
#   --sem-isolar      opção antiga, ignorada com aviso; isolamento obrigatório
#
# Sem --agente nem --perfil, num terminal, um seletor pergunta qual agente
# abrir: o padrão (JANGADA_AGENTE) ou um dos perfis, cada um com a descrição
# entre parênteses. JANGADA_AGENTE_ESCOLHER=0 desliga a pergunta.
#
# Com o catálogo de contas do agy, a sessão nova monta uma conta só, até o
# fim. Sem --conta-agy nem JANGADA_AGY_CONTA, vale a que confia na pasta da
# tarefa e tem o maior saldo conhecido do grupo gemini (a medida mais recente
# entre cotas.json e delegacoes.jsonl, mesmo vencida: ela só ordena as contas,
# e quem autoriza chamar o modelo continua sendo o jangada-delegar). Conta sem
# medida fica atrás; empate mantém a ordem do catálogo. A conta escolhida vai
# para o registro protegido da sessão e para o jangada-isolar --conta. Sem
# catálogo, nada muda.
#
# O agente principal é o Claude ou o Codex. O agy não abre sessão: ele atende
# as delegações (jangada-delegar) e a revisão do jangada-validar.
#
# O agente recebe o protocolo de agentes/perfis/protocolo.md, que manda
# validar a entrega com jangada-validar: o outro modelo revisa o diff. No
# Claude ele vai por --append-system-prompt; no Codex, pelo jangada-codex.
# Num projeto com arquivos R, vão também as regras de
# agentes/perfis/protocolo-r.md. O item de subagentes depende de
# JANGADA_DELEGAR (agy, claude ou local; ver jangada_delegacao em
# jangada-config) e vem de agentes/perfis/protocolo-delegar-*.md.
# JANGADA_AGENTE_PROTOCOLO=0 desliga o protocolo.
#
# O agente roda no bubblewrap pelo jangada-isolar: grava só na pasta da
# tarefa e no que o jangada-isolar libera.
set -euo pipefail
# shellcheck source=bin/jangada-config
source "$(dirname "${BASH_SOURCE[0]}")/jangada-config"

# Variáveis de uma sessão do Claude Code que abriu este comando: o servidor
# do tmux criado aqui as herdaria, e o agente com elas não grava a conversa e
# recebe o socket e o token da sessão do coordenador. Ficam o login, a
# escolha de provedor e os DISABLE_* do usuário. O jangada-isolar repete.
# Lê nomes, um por linha (com "-" ou "=valor" do show-environment do tmux).
ambiente_do_coordenador() {
  local v
  while IFS= read -r v; do
    v="${v#-}"; v="${v%%=*}"
    case "$v" in
      CLAUDE_CODE_OAUTH_TOKEN | CLAUDE_CODE_USE_* | CLAUDE_CODE_DISABLE_*) ;;
      CLAUDECODE | CLAUDE_CODE_*) printf '%s\n' "$v" ;;
    esac
  done
}
while IFS= read -r _v; do unset "$_v"; done < <(compgen -e | ambiente_do_coordenador)

# Quem abre sessão principal. A Central e o --perfis leem daqui: o agy só
# atende delegação e revisão.
mapfile -t principais < <(jangada_provedores principal)
# Sem registro legível a sessão abriria sem o protocolo e sem aviso.
if ((${#principais[@]} == 0)); then
  echo "jangada-agente: nenhum provedor com a função principal em $JANGADA_CONFIG/provedores nem em $JANGADA_CORE_PATH/provedores" >&2
  exit 1
fi
perfis_json() {
  local perfil ambiente delegacao isolado revisao modelos
  while read -r perfil; do
    jangada_perfil "$perfil" || continue
    [[ " ${principais[*]} " == *" $(basename "${PERFIL_COMANDO%% *}") "* ]] || continue
    delegacao="${JANGADA_DELEGAR:-}"; isolado="${JANGADA_AGENTE_ISOLAR:-1}"; revisao="$JANGADA_VALIDAR_REVISOR"
    for ambiente in "${PERFIL_AMBIENTE[@]}"; do
      case "$ambiente" in
        JANGADA_DELEGAR=*) delegacao="${ambiente#*=}" ;;
        JANGADA_AGENTE_ISOLAR=*) isolado="${ambiente#*=}" ;;
        JANGADA_VALIDAR_REVISOR=*) revisao="${ambiente#*=}" ;;
      esac
    done
    if ! modelos="$(jangada_modelos_tarefa "$(basename "${PERFIL_COMANDO%% *}")" "$(jangada_revisor "$PERFIL_COMANDO" "$revisao")")"; then
      echo "perfil $perfil com seleção de modelos inválida; omitido da listagem" >&2
      continue
    fi
    isolado=1 # A política P0 prevalece sobre a opção antiga do perfil.
    jq -n --arg nome "$perfil" --arg descricao "$PERFIL_DESCRICAO" \
      --arg executor "$(basename "${PERFIL_COMANDO%% *}")" \
      --arg delegacao "$(jangada_delegacao "$PERFIL_COMANDO" "$delegacao")" \
      --arg revisor "$(jangada_revisor "$PERFIL_COMANDO" "$revisao")" \
      --argjson modelos "$modelos" \
      --argjson isolado "$([[ "$isolado" != 0 ]] && echo true || echo false)" \
      '{nome:$nome, descricao:$descricao, executor:$executor, funcao:"principal", modelo:($modelos.autor.modelo // null), modelos_tarefa:$modelos,
        permissoes:{delegacao:$delegacao, isolado:$isolado, revisor:$revisor}}'
  done < <(jangada_perfis) | jq -s .
}
if [[ "${1:-}" == --perfis ]]; then
  perfis_json
  exit 0
fi
if [[ "${1:-}" == --capacidades-json ]]; then
  for a in "${principais[@]}"; do
    jangada_provedor "$a" && command -v "$PROVEDOR_COMANDO" >/dev/null 2>&1 && i=true || i=false
    jq -n --arg nome "$a" --argjson instalado "$i" '{nome:$nome, instalado:$instalado}'
  done | jq -s --argjson perfis "$(perfis_json)" '{principais: ., perfis: $perfis}'
  exit 0
fi

janela=0; projeto=""; nome=""; nome_dado=0; direto=0; snapshot=0
agente="$JANGADA_AGENTE"; extras=(); prompt=""; perfil=""; agente_dado=0
revisor="${JANGADA_VALIDAR_REVISOR:-}"; revisor_dado=0
coordenador="${JANGADA_COORDENADOR:-}"; coordenador_dado=0
isolar="$JANGADA_AGENTE_ISOLAR"; isolar_dado=0; delegacao_dada=""; atividade=""; tarefa_id=""
conta_agy_dada=""
PERFIL_AMBIENTE=()
autor_modelo=""; autor_esforco=""; revisor_modelo=""; revisor_esforco=""
while (($#)); do
  case "$1" in
    --janela) janela=1; shift ;;
    --projeto) projeto="$2"; shift 2 ;;
    --nome) nome="$2"; nome_dado=1; shift 2 ;;
    --direto) direto=1; shift ;;
    --snapshot) snapshot=1; shift ;;
    --agente) agente="$2"; agente_dado=1; shift 2 ;;
    --autor-modelo) autor_modelo="$2"; shift 2 ;;
    --autor-esforco) autor_esforco="$2"; shift 2 ;;
    --revisor-modelo) revisor_modelo="$2"; shift 2 ;;
    --revisor-esforco) revisor_esforco="$2"; shift 2 ;;
    --perfil) perfil="$2"; shift 2 ;;
    --delegacao) delegacao_dada="$2"; shift 2 ;;
    --atividade) atividade="$2"; shift 2 ;;
    --tarefa-id) tarefa_id="$2"; shift 2 ;;
    --revisor) revisor="$2"; revisor_dado=1; shift 2 ;;
    --coordenador) coordenador="$2"; coordenador_dado=1; shift 2 ;;
    --conta-agy) conta_agy_dada="$2"; shift 2 ;;
    --sem-isolar) isolar=0; isolar_dado=1; shift ;;
    --prompt) prompt="$2"; shift 2 ;;
    --prompt-arquivo)
      [[ -r "$2" ]] || { echo "arquivo não encontrado: $2" >&2; exit 1; }
      prompt="$(<"$2")"; shift 2 ;;
    --) shift; extras=("$@"); break ;;
    -h|--ajuda) sed -n '2,38s/^# \{0,1\}//p' "$0"; exit 0 ;;
    *) echo "argumento desconhecido: $1" >&2; exit 1 ;;
  esac
done

# Com --projeto, a central abre a sessão; sem tarefa, abre o formulário.
if ((janela)) && [[ -z "$projeto$nome$perfil$prompt$delegacao_dada$conta_agy_dada$autor_modelo$autor_esforco$revisor_modelo$revisor_esforco" ]] && \
    ((!direto && !snapshot && !agente_dado && !revisor_dado && !coordenador_dado && !isolar_dado && ${#extras[@]} == 0)); then
  jangada_abrir_central --nova
fi

if ((janela)); then
  args=()
  [[ -n "$projeto" ]] && args+=(--projeto "$projeto")
  [[ -n "$nome" ]] && args+=(--nome "$nome")
  ((direto)) && args+=(--direto)
  ((snapshot)) && args+=(--snapshot)
  ((agente_dado)) && args+=(--agente "$agente")
  [[ -n "$perfil" ]] && args+=(--perfil "$perfil")
  [[ -z "$delegacao_dada" ]] || args+=(--delegacao "$delegacao_dada")
  ((revisor_dado)) && args+=(--revisor "$revisor")
  ((coordenador_dado)) && args+=(--coordenador "$coordenador")
  ((isolar_dado)) && args+=(--sem-isolar)
  [[ -z "$conta_agy_dada" ]] || args+=(--conta-agy "$conta_agy_dada")
  [[ -n "$prompt" ]] && args+=(--prompt "$prompt")
  [[ -z "$autor_modelo" ]] || args+=(--autor-modelo "$autor_modelo")
  [[ -z "$autor_esforco" ]] || args+=(--autor-esforco "$autor_esforco")
  [[ -z "$revisor_modelo" ]] || args+=(--revisor-modelo "$revisor_modelo")
  [[ -z "$revisor_esforco" ]] || args+=(--revisor-esforco "$revisor_esforco")
  ((${#extras[@]})) && args+=(-- "${extras[@]}")
  jangada_abrir_terminal --exec org.jangada.agente "$0" "${args[@]}"
fi

# Escolha do agente. Só com terminal e sem escolha feita na linha de comando:
# chamado por outro script, vale o padrão.
if ((!agente_dado)) && [[ -z "$perfil" && -t 0 && "${JANGADA_AGENTE_ESCOLHER:-1}" != 0 ]]; then
  mapfile -t _perfis < <(jangada_perfis)
  if ((${#_perfis[@]})); then
    _descrever() {
      local base rev="$revisor" destino="${JANGADA_DELEGAR:-}" modelo="${JANGADA_VALIDAR_MODELO:-}" e
      local isolamento="$isolar"
      base="$(basename "${1%% *}")"
      for e in "${PERFIL_AMBIENTE[@]}"; do
        if ((!revisor_dado)) && [[ "$e" =~ ^JANGADA_VALIDAR_REVISOR=(.*)$ ]]; then rev="${BASH_REMATCH[1]}"; fi
        [[ "$e" =~ ^JANGADA_DELEGAR=(.*)$ ]] && destino="${BASH_REMATCH[1]}"
        [[ "$e" =~ ^JANGADA_VALIDAR_MODELO=(.*)$ ]] && modelo="${BASH_REMATCH[1]}"
        if ((!isolar_dado)) && [[ "$e" =~ ^JANGADA_AGENTE_ISOLAR=(.*)$ ]]; then isolamento="${BASH_REMATCH[1]}"; fi
      done
      rev="$(jangada_revisor "$1" "$rev")"
      [[ -z "$delegacao_dada" ]] || destino="$delegacao_dada"
      destino="$(jangada_delegacao "$1" "$destino")"
      command -v "${1%% *}" >/dev/null 2>&1 || printf 'INDISPONÍVEL: %s não instalado; ' "$base"
      printf '%s implementa; %s revisa' "$base" "$rev"
      [[ -n "$modelo" ]] && printf ' (%s)' "$modelo"
      command -v "$rev" >/dev/null 2>&1 || printf '; revisão indisponível: %s não instalado' "$rev"
      [[ "$rev" == "$base" ]] && printf '; autorrevisão pelo mesmo provedor'
      case "$destino" in
        claude) printf '; subagentes do Claude' ;;
        local) printf '; leitor e redator no Ollama, demais papéis nesta sessão' ;;
        agy)
          printf '; leitor e redator no Ollama, demais papéis no agy'
          command -v agy >/dev/null 2>&1 || printf '; delegação indisponível: agy não instalado'
          ;;
      esac
      isolamento=1 # Mesmo os perfis antigos precisam do Bubblewrap.
      [[ "$isolamento" == 0 ]] && printf '; sem isolamento' || printf '; isolado'
      if [[ "$destino" == local ]]; then
        command -v ollama >/dev/null 2>&1 || printf '; delegação local indisponível: Ollama não instalado'
      fi
      printf '\n'
    }
    _escolha="$({ printf 'padrão\t(%s)\n' "$(_descrever "$JANGADA_AGENTE")"
                  for _p in "${_perfis[@]}"; do
                    jangada_perfil "$_p" || continue
                    printf '%s\t(%s)\n' "$_p" "$(_descrever "$PERFIL_COMANDO")"
                  done; } \
      | column -t -s $'\t' -o '   ' \
      | fzf --prompt 'agente > ' --height 60% --reverse --no-sort --wrap \
        --header 'Sessão interativa. Fila e orçamento são configurados separadamente.' \
      | awk '{print $1}')" || true
    [[ -n "$_escolha" ]] || exit 0
    [[ "$_escolha" == padrão ]] || perfil="$_escolha"
  fi
fi

# O perfil é conferido antes de qualquer worktree, para um nome errado não
# deixar pasta e ramo criados à toa.
PERFIL_AMBIENTE=()
if [[ -n "$perfil" ]]; then
  if ! jangada_perfil "$perfil"; then
    echo "perfil não encontrado: $JANGADA_CONFIG/agentes/$perfil.conf nem $JANGADA_CORE_PATH/agentes/perfis/$perfil.conf" >&2
    echo "perfis existentes: $(jangada_perfis | tr '\n' ' ')" >&2
    exit 1
  fi
  agente="$PERFIL_COMANDO"
fi
if [[ "$(basename "${agente%% *}")" == agy ]]; then
  echo "o agy não abre sessão principal: ele atende só as delegações e a revisão; use claude ou codex" >&2
  exit 1
fi
rev_modelos="$revisor"
for v in "${PERFIL_AMBIENTE[@]}"; do
  if ((!revisor_dado)) && [[ "$v" == JANGADA_VALIDAR_REVISOR=* ]]; then rev_modelos="${v#*=}"; fi
done
modelos_tarefa="$(jangada_modelos_tarefa "$(basename "${agente%% *}")" "$(jangada_revisor "$agente" "$rev_modelos")" \
  "$autor_modelo" "$autor_esforco" "$revisor_modelo" "$revisor_esforco")" || exit 1
if [[ "$modelos_tarefa" == '{}' && -n "$revisor_modelo$revisor_esforco" ]]; then
  echo 'opções de modelo do revisor exigem modelo do autor por tarefa' >&2; exit 1
fi
args_modelos="$JANGADA_AGENTE_ARGS"
[[ -z "$perfil" ]] || args_modelos="${PERFIL_ARGS:-}"
if [[ "$modelos_tarefa" != '{}' && -n "$args_modelos${extras[*]:-}" ]]; then
  echo 'seleção por tarefa exige argumentos do autor vazios; use as opções de modelo e esforço' >&2
  exit 1
fi
if [[ "$modelos_tarefa" != '{}' && -n "${JANGADA_ISOLADO:-}" ]]; then
  echo 'seleção por tarefa exige abertura pelo controlador fora do isolamento, para preservar o registro protegido' >&2
  exit 1
fi
if ! command -v "${agente%% *}" >/dev/null 2>&1; then
  echo "agente indisponível: ${agente%% *} não instalado; nenhuma sessão criada" >&2
  exit 1
fi

# Nome seguro para ramo, pasta e sessão do tmux. Acentos viram a letra sem
# acento antes do filtro: com locale UTF-8 o intervalo a-z do sed aceita "á",
# e o ramo saía com acento.
slug() {
  { iconv -f UTF-8 -t ASCII//TRANSLIT 2>/dev/null <<<"$1" || printf '%s\n' "$1"; } \
    | LC_ALL=C tr '[:upper:]' '[:lower:]' \
    | LC_ALL=C sed -E -e 's/[^a-z0-9_-]+/-/g' -e 's/^-+//' -e 's/-+$//'
}

listar_projetos() {
  {
    command -v zoxide >/dev/null 2>&1 && zoxide query -l 2>/dev/null || true
    if [[ -d "$JANGADA_PROJETOS" ]]; then
      find "$JANGADA_PROJETOS" -mindepth 1 -maxdepth 1 -type d 2>/dev/null || true
      find "$JANGADA_PROJETOS" -maxdepth 3 -type d -name .git -prune 2>/dev/null | sed 's/\/\.git$//' || true
    fi
  } | awk '!visto[$0]++' | while read -r d; do [[ -d "$d" ]] && printf '%s\n' "$d"; done || true
}

if [[ -z "$projeto" ]]; then
  projeto="$(listar_projetos | fzf --prompt 'projeto > ' --height 60% --reverse \
    --preview 'git -C {} log --oneline -8 2>/dev/null; echo; ls {}' )" || true
  [[ -n "$projeto" ]] || exit 0
fi
projeto="$(realpath "$projeto")"
[[ -d "$projeto" ]] || { echo "diretório não encontrado: $projeto" >&2; exit 1; }

eh_git=0
raiz="$projeto"
if git -C "$projeto" rev-parse --show-toplevel >/dev/null 2>&1; then
  eh_git=1
  raiz="$(git -C "$projeto" rev-parse --show-toplevel)"
fi
repo="$(slug "$(basename "$raiz")")"
vinculos=()
[[ -z "$atividade" ]] || vinculos+=(--atividade "$atividade")
[[ -z "$tarefa_id" ]] || vinculos+=(--tarefa-id "$tarefa_id")
[[ -n "$repo" ]] || repo="projeto-$(printf '%s' "$raiz" | md5sum | cut -c1-8)"

if ((eh_git)) && ((!direto)) && [[ -z "$nome" ]]; then
  if [[ -n "$prompt" ]]; then
    # Com a tarefa em mãos, o nome sai das primeiras palavras dela. Sem
    # terminal (chamado por outro script) a sugestão vale direto.
    sugestao="$(slug "$(head -n1 <<<"$prompt" | cut -d' ' -f1-4)")"
    sugestao="${sugestao:0:30}"; sugestao="${sugestao%-}"
    if [[ -t 0 ]]; then
      read -r -p "nome da tarefa [padrão: $sugestao]: " nome
    fi
    [[ -n "$nome" ]] || nome="$sugestao"
  elif [[ -t 0 ]]; then
    read -r -p "nome da tarefa (vazio = trabalhar direto no repositório): " nome
  else
    # Sem terminal o read chega ao fim da entrada e o set -e encerraria o
    # script sem dizer por quê.
    echo "sem terminal para perguntar o nome da tarefa; use --nome, --prompt ou --direto" >&2
    exit 1
  fi
fi
nome="$(slug "$nome")"
[[ -z "$nome" ]] && { ((nome_dado)) || { [[ -n "$prompt" ]] && ((!direto)); }; } \
  && nome="tarefa-$(date +%Y%m%d-%H%M%S)"
sessao_previa="$repo"
[[ -z "$nome" ]] || sessao_previa+="--$nome"
# Sessão que já existe só é anexada: a pasta dela é a do registro protegido, e
# a chamada pode vir de outro projeto com o mesmo nome de pasta e de tarefa.
# Por isso ela não cria worktree, não copia arquivos e não roda
# .jangada/preparar.sh. No isolamento o registro protegido não é visível.
anexar=0
if "${JANGADA_TMUX[@]}" has-session -t "=$sessao_previa" 2>/dev/null; then
  [[ -n "${JANGADA_ISOLADO:-}" ]] || anexar=1
else
  if ! "$JANGADA_CORE_PATH/bin/jangada-projeto" --projeto "$raiz" sessao-conferir "preparacao-$$" \
    --executor "$(basename "${agente%% *}")" "${vinculos[@]}" >/dev/null; then
    echo "jangada-agente: o projeto não permite abrir esta sessão interativa; confira a política e o orçamento. Use a fila para execução controlada, respeitando essas restrições." >&2
    exit 1
  fi
fi

# Conta do agy fixada pela linha de comando ou pelo ambiente, conferida antes
# de qualquer worktree. Só o catálogo registra e repassa a conta; sem ele a
# conta continua implícita e a opção só aceita o nome dela. Sessão que já
# existe usa a conta do registro: o pedido dela não é validado, só ignorado.
catalogo_agy=0
[[ ! -e "$JANGADA_ESTADO/contas/agy.json" ]] || catalogo_agy=1
conta_agy=""
conta_pedida="$conta_agy_dada"
((!catalogo_agy)) || [[ -n "$conta_pedida" ]] || conta_pedida="${JANGADA_AGY_CONTA:-}"
if ((!anexar)); then
  if [[ -n "$conta_agy_dada" ]]; then
    jangada_conta_agy "$conta_agy_dada" || exit 1
    ((!catalogo_agy)) || conta_agy="$CONTA_AGY_NOME"
  elif ((catalogo_agy)) && [[ -n "${JANGADA_AGY_CONTA:-}" ]]; then
    jangada_conta_agy || exit 1
    conta_agy="$CONTA_AGY_NOME"
  fi
fi

# A pasta da sessão é um clone próprio (jangada_clone_criar), com o ramo na
# ponta que ele tem na raiz. Clone que falha no meio não fica para trás: a
# pasta seguinte seria tomada por sessão reaproveitada.
criar_clone() {
  local inicio ponta=""
  [[ ! -e "$worktree" ]] || { echo "jangada-agente: $worktree já existe" >&2; exit 1; }
  inicio="$(jangada_git_seguro -C "$raiz" rev-parse --verify --quiet "refs/heads/$1^{commit}")" \
    || { echo "jangada-agente: o ramo $1 não tem commit em $raiz" >&2; exit 1; }
  [[ "$base" == HEAD ]] || ponta="$(jangada_git_seguro -C "$raiz" rev-parse --verify --quiet "refs/heads/$base^{commit}" || true)"
  if ! jangada_clone_criar "$raiz" "$worktree" "$1" "$inicio" "$base" "$ponta"; then
    rm -rf -- "$worktree"
    echo "jangada-agente: não foi possível criar o clone da sessão em $worktree" >&2
    exit 1
  fi
}

dir="$raiz"; worktree=""; ramo=""; base=""; worktree_novo=0; ramo_novo=0
if ((eh_git)) && [[ -n "$nome" ]]; then
  worktree="$JANGADA_WORKTREES/$repo/$nome"
  ramo="agente/$nome"
  base="$(git -C "$raiz" rev-parse --abbrev-ref HEAD)"
  # Remove registros de worktrees cujas pastas foram apagadas à mão.
  ((anexar)) || git -C "$raiz" worktree prune --expire now
  if ((anexar)); then
    :
  elif [[ -d "$worktree" ]]; then
    echo "reaproveitando worktree existente: $worktree"
    # Worktree de antes de 30/10/2026: divide objetos e refs com a raiz e
    # segue assim até ser encerrado; não é convertido por baixo da sessão.
    [[ ! -f "$worktree/.git" ]] \
      || echo "aviso: $worktree é worktree antigo, que divide os objetos e as refs com $raiz; encerre-o com jangada-agente-fim para a próxima sessão vir em clone próprio" >&2
  elif git -C "$raiz" show-ref --verify --quiet "refs/heads/$ramo"; then
    if git -C "$raiz" merge-base --is-ancestor "refs/heads/$ramo" "$base" 2>/dev/null; then
      echo "ramo $ramo já estava integrado em $base; reiniciado a partir do HEAD"
      git -C "$raiz" branch -f "$ramo" HEAD
      worktree_novo=1
      criar_clone "$ramo"
    else
      novos="$(git -C "$raiz" log --oneline "$base..$ramo" 2>/dev/null | head -10 || true)"
      if [[ -t 0 ]]; then
        echo "aviso: o ramo $ramo já existe e tem commits não integrados em $base:" >&2
        printf '%s\n' "$novos" >&2
        echo "" >&2
        echo "1) Retomar o ramo existente" >&2
        echo "2) Criar novo ramo desambiguado (sufixo numérico)" >&2
        echo "3) Cancelar" >&2
        read -r -p "Escolha [1/2/3, padrão 2]: " esc
        case "${esc:-2}" in
          1)
            echo "retomando o ramo existente: $ramo"
            worktree_novo=1
            criar_clone "$ramo"
            ;;
          2)
            idx=2
            novo_nome="$nome-$idx"
            while git -C "$raiz" show-ref --verify --quiet "refs/heads/agente/$novo_nome" || [[ -d "$JANGADA_WORKTREES/$repo/$novo_nome" ]]; do
              idx=$((idx + 1))
              novo_nome="$nome-$idx"
            done
            nome="$novo_nome"
            ramo="agente/$nome"
            worktree="$JANGADA_WORKTREES/$repo/$nome"
            echo "criando novo ramo desambiguado: $ramo"
            worktree_novo=1
            git -C "$raiz" branch "$ramo" HEAD && criar_clone "$ramo"
            ramo_novo=1
            ;;
          *)
            echo "operação cancelada." >&2
            exit 1
            ;;
        esac
      else
        idx=2
        novo_nome="$nome-$idx"
        while git -C "$raiz" show-ref --verify --quiet "refs/heads/agente/$novo_nome" || [[ -d "$JANGADA_WORKTREES/$repo/$novo_nome" ]]; do
          idx=$((idx + 1))
          novo_nome="$nome-$idx"
        done
        echo "aviso: o ramo $ramo tem commits não integrados; desambiguado para agente/$novo_nome" >&2
        nome="$novo_nome"
        ramo="agente/$nome"
        worktree="$JANGADA_WORKTREES/$repo/$nome"
        worktree_novo=1
        git -C "$raiz" branch "$ramo" HEAD && criar_clone "$ramo"
        ramo_novo=1
      fi
    fi
  else
    worktree_novo=1
    git -C "$raiz" branch "$ramo" HEAD && criar_clone "$ramo"
    ramo_novo=1
  fi
  # Só num worktree recém-criado: o reaproveitado já tem o que precisa, e o
  # que o agente mudou ali não pode ser sobrescrito. A confiança do agy fica
  # para a conferência adiante, que conhece os provedores da tarefa.
  ((worktree_novo)) && "$JANGADA_CORE_PATH/bin/jangada-worktree-preparar" --sem-confianca "$raiz" "$worktree"
  dir="$worktree"
fi

sessao="$repo"
[[ -n "$nome" ]] && sessao="$repo--$nome"

estado_dir="$JANGADA_ESTADO/agentes"
mkdir -p "$estado_dir"

# Precedência do revisor:
# 1. Opção --revisor dada na linha de comando
# 2. JANGADA_VALIDAR_REVISOR definido no perfil
# 3. JANGADA_VALIDAR_REVISOR global (jangada.conf)
if ((!revisor_dado)); then
  for _env in "${PERFIL_AMBIENTE[@]}"; do
    if [[ "$_env" =~ ^JANGADA_VALIDAR_REVISOR=(.*)$ ]]; then
      revisor="${BASH_REMATCH[1]}"
    fi
  done
fi
# Destino dos subagentes: JANGADA_DELEGAR do perfil, depois o global.
delegar="${JANGADA_DELEGAR:-}"
for _env in "${PERFIL_AMBIENTE[@]}"; do
  [[ "$_env" =~ ^JANGADA_DELEGAR=(.*)$ ]] && delegar="${BASH_REMATCH[1]}"
done
[[ -z "$delegacao_dada" ]] || delegar="$delegacao_dada"
delegar="$(jangada_delegacao "$agente" "$delegar")"
revisor_efetivo="$(jangada_revisor "$agente" "$revisor")"

# Confiança do agy, só para quem delega ou revisa por ele. Sessão nova, com
# terminal, pode oferecer a pergunta nativa do agy na raiz. Sessão que já
# existe só sincroniza, e os provedores, a raiz e o worktree dela vêm do
# registro protegido, não desta chamada: a chamada feita por um projeto
# homônimo não pode levar confiança a uma pasta que não é a da sessão aberta.
# Pendência não impede a abertura.
sessao_nova=$((!anexar))
if ((sessao_nova)) && "${JANGADA_TMUX[@]}" has-session -t "=$sessao" 2>/dev/null; then
  sessao_nova=0
  anexar=1
fi
if ((sessao_nova)); then
  if [[ "$delegar" == agy || "$revisor_efetivo" == agy ]]; then
    jangada_agy_conferir_tarefa "$raiz" "$worktree" 1 "$sessao" || true
  fi
elif ((anexar)); then
  registro=0
  jangada_agy_registro_tarefa "$sessao" || registro=$?
  raiz_reg="$JANGADA_AGY_REG_RAIZ"; worktree_reg="$JANGADA_AGY_REG_WORKTREE"
  if ((registro == 1)); then
    echo "a sessão $sessao já existe sem registro protegido válido: confiança do agy não conferida." >&2
    exit 2
  elif [[ "$raiz_reg" != "$(realpath -e -- "$raiz" 2>/dev/null)" ]] \
    || { [[ -z "$worktree_reg" ]] && [[ -n "$worktree" ]]; } \
    || { [[ -n "$worktree_reg" ]] && [[ -z "$worktree" ]]; } \
    || { ((registro == 0)) && [[ -n "$worktree_reg" ]] \
         && [[ "$worktree_reg" != "$(realpath -e -- "$worktree" 2>/dev/null)" ]]; }; then
    echo "a sessão $sessao já existe e é de outra pasta (raiz $raiz_reg${worktree_reg:+, worktree $worktree_reg}), não de $raiz: esta chamada não cria worktree nem confere a confiança do agy." >&2
    exit 2
  elif ((registro == 2)); then
    echo "a sessão $sessao já existe, mas o worktree do registro protegido dela não existe: confiança do agy não conferida." >&2
    exit 2
  elif jangada_agy_tarefa_usa "$sessao"; then
    jangada_agy_conferir_tarefa "$raiz_reg" "$worktree_reg" 0 "$sessao" || true
  fi
fi

# Sessão que já existe segue com a conta do registro protegido, sem nova escolha.
if ((anexar)) && jangada_agy_registro_tarefa "$sessao"; then
  conta_registrada="$(jq -r '.conta_agy // ""' "$JANGADA_ESTADO/revisoes/$sessao.json")"
  if [[ -n "$conta_registrada" ]]; then
    echo "conta do agy: $conta_registrada (registrada na sessão)"
    [[ -z "$conta_pedida" || "$conta_pedida" == "$conta_registrada" ]] \
      || echo "a sessão $sessao já existe: a conta pedida ($conta_pedida) foi ignorada" >&2
  fi
fi

if ((sessao_nova)); then
  # O snapshot é do jangada-shell: sem o comando no PATH, a sessão segue sem ele.
  if ((snapshot)) && command -v jangada-snapshot >/dev/null 2>&1; then
    jangada-snapshot --agente "antes do agente $sessao" || true
  fi

  # A conta do agy sai da medida já gravada, depois da conferência de confiança
  # acima: não consulta o agy nem a rede. A linha mostra a conta e a medida
  # que a decidiu.
  if ((catalogo_agy)); then
    if [[ -n "$conta_agy" ]]; then
      jangada_conta_agy_escolher "$dir" "$conta_agy" || true
    elif jangada_conta_agy_escolher "$dir"; then
      conta_agy="$CONTA_AGY_ESCOLHIDA"
    else
      # Nenhuma conta confia na pasta (ou o catálogo falhou): vale a primeira,
      # como antes, e a delegação pelo agy já fica indisponível.
      conta_agy="$(jangada_contas_agy | head -n1 | cut -f1)"
      CONTA_AGY_SALDO=""
    fi
    [[ -n "$conta_agy" ]] || { echo "jangada-agente: catálogo de contas do agy sem conta; nenhuma sessão criada" >&2; exit 1; }
    if [[ -n "$CONTA_AGY_SALDO" ]]; then
      echo "conta do agy: $conta_agy (gemini ${CONTA_AGY_SALDO}%, medido às $CONTA_AGY_MEDIDA_EM)"
    else
      echo "conta do agy: $conta_agy (sem medida)"
    fi
  fi
  isolar_bin="$(printf '%q' "$JANGADA_CORE_PATH/bin/jangada-isolar")"
  [[ -z "$conta_agy" ]] || isolar_bin+=" --conta $conta_agy"
  isolar_bin+=" --delegar $(printf '%q' "$delegar")"

  cmd_agente="$agente"
  if [[ -n "$perfil" ]]; then
    [[ -n "$PERFIL_ARGS" ]] && cmd_agente+=" $PERFIL_ARGS"
  elif [[ -n "$JANGADA_AGENTE_ARGS" ]]; then
    cmd_agente+=" $JANGADA_AGENTE_ARGS"
  fi
  ((${#extras[@]})) && cmd_agente+=" $(printf '%q ' "${extras[@]}")"
  # Comando sem o prompt, guardado no estado só para consulta. O --restaurar
  # não o usa: o estado é gravável pelo agente isolado, e o jangada-agentes
  # recompõe o comando a partir de campos conferidos e da configuração.
  cmd_agente+="$(jangada_modelo_argumentos "$modelos_tarefa" "$(basename "${agente%% *}")")"
  cmd_base="$cmd_agente"
  # O prompt vai por arquivo: digitado pelo send-keys, cada quebra de linha
  # seria um Enter e o agente receberia só a primeira linha. O shell da sessão
  # (bash ou zsh) lê o arquivo como um argumento só.
  # O protocolo do jangada (worktree, commits, jangada-validar) vai no Claude
  # como instrução de sistema e fica no comando guardado, para valer também
  # numa sessão restaurada.
  base_agente="$(basename "${agente%% *}")"
  cmd_codex="$cmd_agente"
  if ((!isolar_dado)); then
    for _env in "${PERFIL_AMBIENTE[@]}"; do
      [[ "$_env" =~ ^JANGADA_AGENTE_ISOLAR=(.*)$ ]] && isolar="${BASH_REMATCH[1]}"
    done
  fi
  # O prefixo entra no comando guardado só para consulta: a sessão restaurada
  # volta isolada pela configuração, e não pelo .isolar do estado.
  [[ "$isolar" != 0 ]] || echo "isolamento obrigatório na correção P0; opção sem isolamento ignorada" >&2
  isolar=1
  if [[ "$isolar" != 0 ]]; then
    cmd_agente="$isolar_bin -- $cmd_agente"
    cmd_base="$cmd_agente"
  fi
  protocolo="$JANGADA_CORE_PATH/agentes/perfis/protocolo.md"
  [[ "${JANGADA_AGENTE_PROTOCOLO:-1}" != 0 && -r "$protocolo" ]] || protocolo=""
  if ! command -v "$revisor_efetivo" >/dev/null 2>&1; then
    echo "revisão indisponível: $revisor_efetivo não instalado; protocolo e testes continuam obrigatórios" >&2
  fi
  # O protocolo da sessão fica num arquivo próprio, lido pelo comando na hora
  # (o --restaurar o refaz das mesmas fontes). Leva o item de subagentes do
  # destino da delegação e, em projeto com arquivos R, as regras de código R.
  if [[ -n "$protocolo" ]]; then
    protocolo_delegar="$delegar"
    [[ "$base_agente" == codex ]] && protocolo_delegar=codex
    partes=("$protocolo" "$JANGADA_CORE_PATH/agentes/perfis/protocolo-delegar-$protocolo_delegar.md"
            "$JANGADA_CORE_PATH/agentes/perfis/protocolo-delegar.md")
    if [[ -n "$(find "$dir" -maxdepth 2 -not -path '*/.git/*' \
          \( -iname '*.R' -o -name '*.Rmd' -o -name '*.qmd' -o -name '*.Rproj' -o -name DESCRIPTION \) \
          -print -quit 2>/dev/null)" ]]; then
      partes+=("$JANGADA_CORE_PATH/agentes/perfis/protocolo-r.md")
    fi
    rm -f "$estado_dir/protocolo-$sessao.md"
    cat "${partes[@]}" >"$estado_dir/protocolo-$sessao.md"
    if ! command -v "$revisor_efetivo" >/dev/null 2>&1; then
      printf '\nRevisão indisponível: %s não instalado. Execute os testes obrigatórios e o jangada-validar. Informe a revisão pendente; não declare aprovação.\n' \
        "$revisor_efetivo" >>"$estado_dir/protocolo-$sessao.md"
    fi
    protocolo="$estado_dir/protocolo-$sessao.md"
  fi
  arq_prompt="$estado_dir/prompt-$sessao.md"
  rm -f "$arq_prompt"
  if [[ "$base_agente" == codex ]]; then
    cmd_agente="$(printf '%q' "$JANGADA_CORE_PATH/bin/jangada-codex")"
    [[ -n "$protocolo" ]] && cmd_agente+=" --protocolo $(printf '%q' "$protocolo")"
    cmd_agente+=" -- $cmd_codex"
    cmd_agente="$isolar_bin -- $cmd_agente"
    cmd_base="$cmd_agente"
    if [[ -n "$prompt" ]]; then
      printf '%s\n' "$prompt" >"$arq_prompt"
      cmd_agente+=" \"\$(cat $(printf '%q' "$arq_prompt"))\""
    fi
  else
    if [[ -n "$protocolo" ]] && jangada_provedor "$base_agente" && [[ -n "$PROVEDOR_PROTOCOLO_ARG" ]]; then
      cmd_agente+=" $PROVEDOR_PROTOCOLO_ARG \"\$(cat $(printf '%q' "$protocolo"))\""
      cmd_base="$cmd_agente"
    fi
    if [[ -n "$prompt" ]]; then
      printf '%s\n' "$prompt" >"$arq_prompt"
      cmd_agente+=" \"\$(cat $(printf '%q' "$arq_prompt"))\""
    fi
  fi

  # A sessão do tmux é criada antes do arquivo de estado. O jangada-agentes
  # apaga o estado de sessões que não existem mais, e na ordem inversa haveria
  # uma janela em que a barra apagaria o arquivo recém-gravado.
  amb=(-e "JANGADA_SESSAO=$sessao")
  for _v in "${PERFIL_AMBIENTE[@]}"; do
    [[ "$_v" =~ ^JANGADA_(VALIDAR_REVISOR|DELEGAR)= ]] && continue
    amb+=(-e "$_v")
  done
  amb+=(-e "JANGADA_DELEGAR=$delegar")
  if ! execucao="$("$JANGADA_CORE_PATH/bin/jangada-projeto" --projeto "$raiz" sessao-iniciar "$sessao" \
    --executor "$base_agente" "${vinculos[@]}" | jq -er .execucao)"; then
    echo "jangada-agente: não foi possível registrar a execução da sessão $sessao" >&2
    if ((worktree_novo)) && rm -rf -- "$worktree"; then
      ((ramo_novo)) && git -C "$raiz" branch -d "$ramo"
    fi
    exit 1
  fi
  amb+=(-e "JANGADA_EXECUCAO=$execucao")
  [[ -n "$revisor_efetivo" ]] && amb+=(-e "JANGADA_VALIDAR_REVISOR=$revisor_efetivo")
  if [[ "$modelos_tarefa" != '{}' ]]; then
    amb+=(-e "JANGADA_VALIDAR_MODELO=$(jq -r '.revisor.modelo' <<<"$modelos_tarefa")"
          -e "JANGADA_VALIDAR_ESFORCO=$(jq -r '.revisor.esforco' <<<"$modelos_tarefa")")
  fi
  # Um servidor já aberto por outro coordenador guarda as variáveis no
  # ambiente global, que toda sessão nova herda.
  while IFS= read -r _v; do
    "${JANGADA_TMUX[@]}" set-environment -g -u "$_v" || true
  done < <("${JANGADA_TMUX[@]}" show-environment -g 2>/dev/null | ambiente_do_coordenador)
  if ! "${JANGADA_TMUX[@]}" new-session -d -s "$sessao" -c "$dir" "${amb[@]}"; then
    "$JANGADA_CORE_PATH/bin/jangada-projeto" --projeto "$raiz" sessao-abortar "$sessao" \
      --execucao "$execucao" >/dev/null
    echo "jangada-agente: não foi possível criar a sessão $sessao" >&2
    exit 1
  fi

  # Tarefa aberta de dentro de uma sessão do jangada-coordenador: liga a
  # tarefa ao registro dele, que a consulta --coordenadores-json lê.
  coordenador_sessao="${JANGADA_COORDENADOR:-}"
  if ! [[ "$coordenador_sessao" =~ ^[A-Za-z0-9_.-]{1,255}$ && -f "$JANGADA_ESTADO/coordenadores/$coordenador_sessao.json" ]]; then
    coordenador_sessao=""
  fi
  rm -f "$estado_dir/$sessao.json"
  jq -n --arg sessao "$sessao" --arg dir "$dir" --arg raiz "$raiz" --arg worktree "$worktree" \
    --arg ramo "$ramo" --arg base "$base" --arg agente "$agente" \
    --argjson modelos "$modelos_tarefa" \
    --arg agora "$(jangada_data_iso)" \
    --arg inicio "$( ((eh_git)) && git -C "$dir" rev-parse HEAD 2>/dev/null || true)" \
    --arg tarefa "$prompt" --arg perfil "$perfil" --arg comando "$cmd_base" \
    --arg atividade "$atividade" --arg tarefa_id "$tarefa_id" --arg execucao "$execucao" \
    --arg revisor "$revisor_efetivo" --arg delegar "$delegar" --arg coordenador "${coordenador:-dono}" \
    --arg coordenador_sessao "$coordenador_sessao" --arg conta_agy "$conta_agy" --argjson isolar "$([[ "$isolar" != 0 ]] && echo true || echo false)" \
    '{sessao:$sessao, dir:$dir, raiz:$raiz, worktree:$worktree, ramo:$ramo, base:$base,
      agente:$agente, comando:$comando, isolar:$isolar, estado:"iniciado", mensagem:"", desde:$agora, atualizado:$agora}
     + (if $tarefa != "" then {tarefa:$tarefa} else {} end)
     + (if $perfil != "" then {perfil:$perfil} else {} end)
     + (if $atividade != "" then {atividade:$atividade} else {} end)
     + (if $tarefa_id != "" then {tarefa_id:$tarefa_id} else {} end)
     + {execucao:$execucao}
     + (if $modelos != {} then {modelos_tarefa:$modelos} else {} end)
     + (if $inicio != "" then {inicio:$inicio} else {} end)
     + (if $revisor != "" then {revisor:$revisor} else {} end)
     + {delegar:$delegar, coordenador:$coordenador}
     + (if $coordenador_sessao != "" then {coordenador_sessao:$coordenador_sessao} else {} end)
     + (if $conta_agy != "" then {conta_agy:$conta_agy} else {} end)' \
    >"$estado_dir/$sessao.json"
  # Cópia dos metadados em revisoes/, que o jangada-isolar oculta: o
  # jangada-validar rodado fora do isolamento lê base, tarefa, autor e
  # revisor dali, e não do estado acima, que o agente grava. Criada dentro do
  # isolamento, a cópia cairia na pasta que some no fim.
  if [[ -z "${JANGADA_ISOLADO:-}" ]]; then
    (umask 077; mkdir -p "$JANGADA_ESTADO/revisoes") \
      && jq '{sessao, raiz, worktree, ramo, base, agente, desde, tarefa, inicio, revisor, delegar, execucao, atividade, tarefa_id, modelos_tarefa, coordenador_sessao, conta_agy}
             | with_entries(select(.value != null))' "$estado_dir/$sessao.json" \
           >"$JANGADA_ESTADO/revisoes/$sessao.json" \
      || echo "aviso: não gravei a cópia da sessão em $JANGADA_ESTADO/revisoes" >&2
  fi

  python3 "$JANGADA_CORE_PATH/orquestracao/confianca.py" registrar-inicio "$JANGADA_ESTADO" "$sessao" \
    || { echo "abertura bloqueada: falha ao preservar pedido e protocolo; trabalho mantido" >&2; exit 1; }
  "${JANGADA_TMUX[@]}" send-keys -t "=$sessao:" "$cmd_agente" Enter
elif [[ -n "$prompt" ]]; then
  echo "a sessão $sessao já existe; o prompt não foi enviado" >&2
fi

# Dentro de outro tmux, anexar aninhado confunde; abre numa janela nova.
if [[ -n "${TMUX:-}" && -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]]; then
  jangada_abrir_terminal --exec org.jangada.agente "${JANGADA_TMUX[@]}" attach -t "=$sessao"
fi
unset TMUX
exec "${JANGADA_TMUX[@]}" attach -t "=$sessao"
