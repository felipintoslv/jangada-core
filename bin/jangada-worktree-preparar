#!/usr/bin/env bash
# Leva para um worktree novo o que o git não leva: arquivos ignorados que o
# projeto precisa para rodar (.Renviron, .env, dados locais).
#
# Uso: jangada-worktree-preparar [opções] RAIZ WORKTREE
#   --simular        mostra o que seria feito, sem fazer
#   --sem-confianca  prepara sem mexer na confiança do agy (tarefa que não
#                    delega nem revisa por ele)
#   --so-confianca   só confere e sincroniza a confiança do agy no worktree:
#                    não copia, não liga e não roda .jangada/preparar.sh.
#                    Sai com 0 (worktree confiável), 2 (o agy não confia na
#                    raiz), 3 (o worktree não é da raiz), 4 (gravação não
#                    confirmada) ou 5 (sessão isolada)
#
# Lê três arquivos na raiz do repositório, todos opcionais:
#   .worktreeinclude       padrões no formato do .gitignore; o que casar e for
#                          ignorado pelo git é copiado (mesmo formato do
#                          --worktree do Claude Code)
#   .jangada/links         um caminho relativo por linha; vira link simbólico
#                          para a pasta da raiz, sem cópia (dados grandes)
#   .jangada/preparar.sh   roda dentro do worktree por último, com JANGADA_RAIZ
#                          e JANGADA_WORKTREE no ambiente
#
# A cópia usa --reflink=auto: em btrfs, na mesma partição, não ocupa espaço.
# Fora disso, uma cópia maior que JANGADA_WORKTREE_COPIA_MAX megabytes (padrão
# 500) é recusada com aviso, para não duplicar dados sem querer.
set -euo pipefail
# shellcheck source=bin/jangada-config
source "$(dirname "${BASH_SOURCE[0]}")/jangada-config"

simular=0; so_confianca=0; sem_confianca=0
while (($#)); do
  case "$1" in
    --simular) simular=1; shift ;;
    --so-confianca) so_confianca=1; shift ;;
    --sem-confianca) sem_confianca=1; shift ;;
    -h|--ajuda) sed -n '2,27s/^# \{0,1\}//p' "$0"; exit 0 ;;
    --) shift; break ;;
    -*) echo "opção desconhecida: $1" >&2; exit 1 ;;
    *) break ;;
  esac
done

raiz="${1:?informe a raiz do repositório}"
worktree="${2:?informe o worktree}"
raiz="$(realpath "$raiz")"
worktree="$(realpath "$worktree")"
[[ -d "$raiz" && -d "$worktree" ]] || { echo "pasta inexistente: $raiz ou $worktree" >&2; exit 1; }
[[ "$raiz" != "$worktree" ]] || { echo "raiz e worktree são a mesma pasta" >&2; exit 1; }

copia_max_mb="${JANGADA_WORKTREE_COPIA_MAX:-500}"
[[ "$copia_max_mb" =~ ^[0-9]+$ ]] || copia_max_mb=500

avisar() { printf 'preparar: %s\n' "$*" >&2; }

# Confiança de pasta para o Antigravity (agy), que evita a pergunta
# interativa ao rodar o agy no worktree. A confiança libera os agentes, as
# regras e o MCP da pasta, então o worktree só herda a do repositório
# principal: se o usuário não confiou na raiz, o agy pergunta no worktree
# como perguntaria nela.
sincronizar_confianca() {
  local r=0
  if ((simular)); then
    if jangada_agy_confia "$raiz"; then
      echo "adicionaria $worktree a trustedWorkspaces"
    else
      echo "preparar: o agy não confia em $raiz; o worktree fica sem confiança"
    fi
    return 0
  fi
  jangada_agy_sincronizar_worktree "$raiz" "$worktree" || r=$?
  case "$r" in
    2) echo "preparar: o agy não confia em $raiz; o worktree fica sem confiança" ;;
    3) avisar "$worktree não é worktree do repositório em $raiz; confiança do agy não alterada" ;;
    4) avisar "a gravação da confiança do agy em $worktree não foi confirmada" ;;
    5) avisar "sessão isolada não altera a confiança do agy" ;;
  esac
  return "$r"
}

if ((so_confianca)); then
  codigo=0
  sincronizar_confianca || codigo=$?
  exit "$codigo"
fi

# Recusa caminho absoluto e qualquer ".." : tudo tem de ficar dentro das duas
# pastas, e o arquivo de padrões vem do repositório, que pode ser de terceiros.
caminho_seguro() {
  local c="$1"
  [[ -n "$c" && "$c" != /* ]] || return 1
  case "/$c/" in
    */../*|*/./*) return 1 ;;
  esac
  return 0
}

# Reflink só existe dentro do mesmo sistema de arquivos btrfs (ou xfs com
# reflink). Nos outros casos o cp --reflink=auto cai numa cópia comum, de
# tamanho inteiro. A comparação é pelo UUID do sistema de arquivos: no btrfs
# cada subvolume tem st_dev e f_fsid próprios, mas o reflink funciona entre
# subvolumes.
reflink_provavel() {
  if [[ "$(uname -s)" == "Darwin" ]]; then
    return 0
  fi
  local u1 u2
  case "$(stat -f -c %T "$raiz" 2>/dev/null || true)" in
    btrfs|xfs) ;;
    *) return 1 ;;
  esac
  u1="$(findmnt -no UUID -T "$raiz" 2>/dev/null || true)"
  u2="$(findmnt -no UUID -T "$worktree" 2>/dev/null || true)"
  if [[ -n "$u1" && -n "$u2" ]]; then
    [[ "$u1" == "$u2" ]]
  else
    # Sem findmnt ou sem UUID: volta à comparação de dispositivo.
    [[ "$(stat -c %d "$raiz" 2>/dev/null || true)" == "$(stat -c %d "$worktree" 2>/dev/null || true)" ]]
  fi
}

copiados=0; ligados=0

# 1. Cópia do que o .worktreeinclude pede.
if [[ -f "$raiz/.worktreeinclude" ]]; then
  # --directory resume uma pasta inteiramente fora do git numa linha só
  # ("dados/"), em vez de listar arquivo por arquivo. Sem -z, o git põe entre
  # aspas e em octal todo nome com acento ("dados \303\241rea/"), e o
  # check-ignore abaixo descartava a pasta sem aviso.
  mapfile -d '' -t candidatos < <(git -C "$raiz" ls-files -z --others --ignored --directory \
    --exclude-from="$raiz/.worktreeinclude" 2>/dev/null || true)
  itens=()
  for c in "${candidatos[@]}"; do
    c="${c%/}"
    caminho_seguro "$c" || { avisar "caminho recusado: $c"; continue; }
    # Só o que o próprio git ignora. Arquivo novo ainda não commitado não é
    # assunto do worktree.
    git -C "$raiz" check-ignore -q -- "$c" || continue
    [[ -e "$worktree/$c" || -L "$worktree/$c" ]] && continue
    itens+=("$c")
  done

  if ((${#itens[@]})); then
    if ! reflink_provavel; then
      total_kb="$(cd "$raiz" && du -sk -- "${itens[@]}" 2>/dev/null | awk '{s += $1} END {print s + 0}')"
      if ((total_kb > copia_max_mb * 1024)); then
        avisar "a cópia somaria $((total_kb / 1024)) MB fora de btrfs (limite $copia_max_mb MB); nada copiado."
        avisar "passe as pastas grandes para .jangada/links ou aumente JANGADA_WORKTREE_COPIA_MAX."
        itens=()
      fi
    fi
    for c in "${itens[@]}"; do
      if [[ "$c" =~ (\.env|\.Renviron|\.pem|credentials|token|senha|secret) ]]; then
        avisar "arquivo com potenciais segredos copiado para o worktree: $c"
      fi
      if ((simular)); then
        echo "copiaria $c"
      else
        mkdir -p -- "$(dirname -- "$worktree/$c")"
        if [[ "$(uname -s)" == "Darwin" ]]; then
          if ! cp -R -p -c -- "$raiz/$c" "$worktree/$c" 2>/dev/null; then
            rm -rf -- "${worktree:?}/${c:?}"
            cp -R -p -- "$raiz/$c" "$worktree/$c"
          fi
        else
          cp -a --reflink=auto -- "$raiz/$c" "$worktree/$c"
        fi
      fi
      copiados=$((copiados + 1))
    done
  fi
fi

# 2. Links simbólicos para o que é grande demais para copiar.
if [[ -f "$raiz/.jangada/links" ]]; then
  while IFS= read -r c || [[ -n "$c" ]]; do
    c="${c%%#*}"
    c="$(sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//' <<<"$c")"
    c="${c%/}"
    [[ -n "$c" ]] || continue
    caminho_seguro "$c" || { avisar "caminho recusado: $c"; continue; }
    [[ -e "$raiz/$c" ]] || { avisar "não existe na raiz: $c"; continue; }
    [[ -e "$worktree/$c" || -L "$worktree/$c" ]] && continue
    if ((simular)); then
      echo "ligaria $c"
    else
      mkdir -p -- "$(dirname -- "$worktree/$c")"
      ln -s -- "$raiz/$c" "$worktree/$c"
      # Um padrão só de pasta ("dados/") não cobre o link, que para o git é
      # arquivo: o link apareceria como novo no worktree e o agente poderia
      # fazer commit dele. Nesse caso o link sai e fica o aviso.
      if ! git -C "$worktree" check-ignore -q -- "$c"; then
        rm -f -- "$worktree/$c"
        avisar "$c não é ignorado como arquivo no worktree; link desfeito."
        avisar "no .gitignore, escreva \"/$c\" (sem a barra final) em vez de \"$c/\"."
        continue
      fi
    fi
    ligados=$((ligados + 1))
  done <"$raiz/.jangada/links"
fi

((copiados + ligados)) && echo "preparar: $copiados copiado(s), $ligados link(s) em $worktree"

# 3. Preparação própria do projeto. Roda com bash explícito, então não depende
# do bit de execução, e uma falha só gera aviso: o worktree já existe e o
# agente pode começar mesmo assim.
if [[ -f "$raiz/.jangada/preparar.sh" ]]; then
  if ((simular)); then
    echo "rodaria .jangada/preparar.sh em $worktree"
  else
    executar_script=1
    if [[ -t 0 ]]; then
      read -r -p "executar .jangada/preparar.sh em $worktree? [s/N] " r || r=n
      [[ "${r,,}" == s* ]] || executar_script=0
    fi
    if ((executar_script)); then
      echo "preparar: rodando .jangada/preparar.sh"
      (cd "$worktree" && JANGADA_RAIZ="$raiz" JANGADA_WORKTREE="$worktree" \
        "$JANGADA_CORE_PATH/bin/jangada-isolar" -- bash "$raiz/.jangada/preparar.sh") \
        || avisar ".jangada/preparar.sh terminou com erro"
    else
      echo "preparar: .jangada/preparar.sh ignorado pelo usuário"
    fi
  fi
fi

# 4. Confiança do agy no worktree.
((sem_confianca)) || sincronizar_confianca || true

exit 0
