#!/usr/bin/env bash
# Assina com a chave SSH os commits da cópia de trabalho que ainda não estão
# no ramo da origem e não têm assinatura válida. Os agentes fazem commit no
# isolamento, onde a chave não aparece; este comando roda num terminal comum,
# mostra os commits e só assina com confirmação. Com
# ~/.config/jangada/allowed_signers, só vale commit assinado por uma chave
# desse arquivo.
#
# Uso: jangada-assinar [PASTA]
#   PASTA  repositório a assinar (padrão: JANGADA_REPO)
# A chave é JANGADA_ASSINATURA_CHAVE no jangada.conf (padrão ~/.ssh/id_ed25519).
# Reescreve os commits a partir do primeiro sem assinatura válida; os
# anteriores, que a cópia instalada pode já ter aplicado, ficam como estão.
# Commit já enviado sem assinatura e ainda não aplicado na cópia instalada
# não é reescrito: o comando avisa e diz como avançar a cópia instalada.
# Os merges do jangada-agente-fim --integrar são refeitos e assinados também.
set -euo pipefail
# shellcheck source=bin/jangada-config
source "$(dirname "${BASH_SOURCE[0]}")/jangada-config"

case "${1:-}" in
  -h|--ajuda) sed -n '2,16s/^# \{0,1\}//p' "$0"; exit 0 ;;
esac

erro() { echo "jangada-assinar: $*" >&2; exit 1; }
repo="${1:-$JANGADA_REPO}"
chave="$JANGADA_ASSINATURA_CHAVE"
publica="${chave%.pub}.pub"
assinantes="$JANGADA_CONFIG/allowed_signers"
# O programa de assinatura é fixo: o gpg.ssh.program da configuração do
# repositório rodaria aqui, fora do isolamento. As opções valem também para o
# git commit que o rebase chama.
g() {
  jangada_git_seguro -C "$repo" -c gpg.format=ssh -c user.signingkey="$chave" \
    -c gpg.ssh.program=ssh-keygen -c gpg.ssh.allowedSignersFile="$assinantes" "$@"
}
sem_controle() { tr -d '\000-\010\013-\037\177'; }

[[ -n "$repo" && -d "$repo/.git" ]] || erro "${repo:-JANGADA_REPO vazio}: não é uma cópia de trabalho do git"
[[ -r "$chave" && -r "$publica" ]] \
  || erro "chave $chave (e $publica) não encontrada; no isolamento o ~/.ssh fica oculto, rode num terminal comum"
[[ -f "$assinantes" ]] \
  || erro "$assinantes não existe; crie com: echo \"\$(git config user.email) namespaces=\\\"git\\\" \$(cat $publica)\" >$assinantes"
grep -qF -- "$(cut -d' ' -f2 "$publica")" "$assinantes" || erro "a chave $publica não está em $assinantes"
[[ -z "$(g status --porcelain --ignore-submodules=all)" ]] || erro "há alterações sem commit em $repo"
g symbolic-ref -q HEAD >/dev/null || erro "o HEAD de $repo não está num ramo"
base="$(g rev-parse --verify --quiet '@{upstream}^{commit}')" || erro "o ramo de $repo não acompanha um ramo da origem"

# Commit enviado sem assinatura fica fora do alcance daqui, que só olha depois
# da origem, e dentro do que se confere, da cópia instalada em diante: a
# conferência recusa toda vez e este comando responde "nada a assinar".
instalada="$(jangada_git_seguro -C "$JANGADA_CORE_PATH" rev-parse --verify --quiet 'HEAD^{commit}' 2>/dev/null)" || instalada=""
if [[ -n "$instalada" ]] && g merge-base --is-ancestor "$instalada" "$base" 2>/dev/null; then
  enviados="$(g log --format='%G? %h %s' "$instalada..$base" | grep -v '^G ' | sem_controle)" || true
  if [[ -n "$enviados" ]]; then
    {
      echo "!! commits já enviados sem assinatura válida; este comando não os reescreve e a cópia instalada não passa deles:"
      printf '%s\n' "$enviados" | sed 's/^/   /'
      echo "   confira com git log -p ${instalada:0:7}..${base:0:7} e avance a cópia instalada à mão até a origem:"
      printf '   git -C %q fetch origin && git -C %q merge --ff-only %s\n' "$JANGADA_CORE_PATH" "$JANGADA_CORE_PATH" "$base"
    } >&2
  fi
fi

# O awk lê até o fim: saindo no primeiro achado, o git log morre por SIGPIPE
# e, com pipefail, o script termina aqui sem mensagem.
primeiro="$(g log --reverse --format='%G? %H' "$base..HEAD" | awk '$1 != "G" && !achou { print $2; achou = 1 }')"
if [[ -z "$primeiro" ]]; then
  echo "nada a assinar: os commits depois de $(g rev-parse --abbrev-ref '@{upstream}') já têm assinatura válida"
  exit 0
fi
echo "commits a assinar em $repo:"
g log --format='%h %an: %s' "$primeiro^..HEAD" | sem_controle | sed 's/^/   /'
r=""
read -r -p "assinar estes commits com $chave? [s/N] " r || r=""
[[ "${r,,}" == s* ]] || { echo "nada assinado"; exit 1; }

# O rebase refaz cada merge com a estratégia padrão, e o que foi resolvido ou
# alterado à mão no merge não volta: com conflito ele para; sem conflito, a
# comparação das árvores pega a perda. Ela vai commit a commit, porque um
# commit posterior que desfaz a alteração deixaria a árvore final igual, e
# na ordem do histórico, porque dois merges podem trocar de árvore entre si.
# A ordem é a da data de autoria, que o rebase e o amend não mudam.
# Commit já assinado cujo pai não mudou é reaproveitado e fica como está.
arvores() { g log --author-date-order --format=%T "$primeiro^..$1"; }
antes="$(g rev-parse HEAD)"
g rebase --quiet --rebase-merges \
  --exec '[ "$(git log -1 --format=%G?)" = G ] || git commit --quiet --amend --no-edit --no-verify -S' "$primeiro^" \
  || erro "o rebase parou; resolva em $repo (git rebase --abort desfaz)"
if [[ "$(arvores "$antes")" != "$(arvores HEAD)" ]]; then
  g reset --quiet --hard "$antes"
  erro "refazer os merges mudou o conteúdo; nada foi assinado, assine à mão"
fi
faltam="$(g log --format='%G? %h %s' "$base..HEAD" | grep -v '^G ' | sem_controle)" || true
[[ -z "$faltam" ]] || erro "ainda sem assinatura válida:"$'\n'"$faltam"
echo "assinados; confira com git log --show-signature e rode o push"
